---
/**
 * GA4 Measurement ID is public (visible in page source). Default enables tracking
 * on production builds without requiring env; override via PUBLIC_HESELO_GA4_ID.
 *
 * Microsoft Clarity runs alongside GA4/Plausible for session replay + heatmaps.
 * Project ID is public; override via PUBLIC_HESELO_CLARITY_ID (empty = disable).
 *
 * Lead CTAs emit `generate_lead` (mark as a key event in GA4 Admin → Events).
 * Funnel: `cta_click` (contact links), `pricing_select` (plan → contact).
 * Events include first-touch UTM params from sessionStorage (`heselo.campaign`).
 */
const DEFAULT_GA4_ID = 'G-HKT0YR5W38'
const DEFAULT_CLARITY_ID = 'yqenuclqam'

const provider = String(
  import.meta.env.PUBLIC_HESELO_ANALYTICS || import.meta.env.PUBLIC_ANALYTICS || 'ga4',
).toLowerCase()
const plausibleDomain = (import.meta.env.PUBLIC_HESELO_PLAUSIBLE_DOMAIN ||
  import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN) as string | undefined
const ga4Id = (import.meta.env.PUBLIC_HESELO_GA4_ID ||
  import.meta.env.PUBLIC_GA4_ID ||
  DEFAULT_GA4_ID) as string
const clarityIdRaw =
  import.meta.env.PUBLIC_HESELO_CLARITY_ID ?? import.meta.env.PUBLIC_CLARITY_ID
const clarityId =
  clarityIdRaw === undefined || clarityIdRaw === null
    ? DEFAULT_CLARITY_ID
    : String(clarityIdRaw).trim()
const enableGa4Funnels = provider === 'ga4' && Boolean(ga4Id)
---

{
  provider === 'plausible' && plausibleDomain ? (
    <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />
  ) : null
}
{
  provider === 'ga4' && ga4Id ? (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || []
        function gtag() {
          dataLayer.push(arguments)
        }
        window.gtag = gtag
        gtag('js', new Date())
        gtag('config', ga4Id)

        /** Shared helper for contact form + other modules. */
        window.heseloTrack = function heseloTrack(name, params) {
          if (typeof gtag === 'function') gtag('event', name, params || {})
        }
      </script>
    </>
  ) : null
}
{
  enableGa4Funnels ? (
    <script>
      import { campaignTrackParams, captureCampaignFromLocation } from '@/lib/campaign'

      captureCampaignFromLocation()

      function leadPlacement(el: Element): string {
        const marked = el.closest('[data-track-placement]')
        if (marked instanceof HTMLElement && marked.dataset.trackPlacement) {
          return marked.dataset.trackPlacement
        }
        if (el.closest('.hero')) return 'hero'
        if (el.closest('.contact-fab')) return 'fab'
        if (el.closest('[data-cta]')) return 'cta'
        if (el.closest('[data-contact-form]') || el.closest('.wa-lead')) return 'contact'
        if (el.closest('[data-pricing-offers], .pricing-offers, .offers')) return 'pricing'
        if (el.closest('header, .header')) return 'header'
        if (el.closest('footer, .footer')) return 'footer'
        return 'other'
      }

      function isWhatsAppHref(href: string): boolean {
        return /wa\.me\/|whatsapp\.com\//i.test(href)
      }

      function isContactPath(pathname: string): boolean {
        return /\/contact\/?$/i.test(pathname) || /\/(az|en|ru)\/contact\/?/i.test(pathname)
      }

      function track(name: string, params: Record<string, string | undefined>) {
        if (typeof window.heseloTrack !== 'function') return
        window.heseloTrack(name, { ...campaignTrackParams(), ...params })
      }

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target
          if (!(target instanceof Element)) return
          const a = target.closest('a')
          if (!(a instanceof HTMLAnchorElement)) return
          const href = a.href || ''
          const placement = leadPlacement(a)

          if (isWhatsAppHref(href)) {
            track('generate_lead', {
              method: 'whatsapp',
              placement,
            })
            return
          }

          let url: URL
          try {
            url = new URL(href, window.location.origin)
          } catch {
            return
          }
          if (url.origin !== window.location.origin) return
          if (!isContactPath(url.pathname)) return

          const plan = url.searchParams.get('plan') || a.dataset.plan || ''
          if (plan || a.hasAttribute('data-contact-link') || a.closest('[data-pricing-offers]')) {
            track('pricing_select', {
              placement: placement === 'other' ? 'pricing' : placement,
              plan: plan || undefined,
              period: url.searchParams.get('period') || undefined,
              venue_type: url.searchParams.get('type') || undefined,
            })
          }

          track('cta_click', {
            placement,
            link_url: url.pathname + url.search,
          })
        },
        true,
      )
    </script>
  ) : null
}
{
  clarityId ? (
    <script is:inline define:vars={{ clarityId }}>
      ;(function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            ;(c[a].q = c[a].q || []).push(arguments)
          }
        t = l.createElement(r)
        t.async = 1
        t.src = 'https://www.clarity.ms/tag/' + i
        y = l.getElementsByTagName(r)[0]
        y.parentNode.insertBefore(t, y)
      })(window, document, 'clarity', 'script', clarityId)
    </script>
  ) : null
}
