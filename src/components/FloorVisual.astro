---
import type { Messages } from '@/i18n/types'

interface Props {
  messages: Messages
}
const { messages } = Astro.props
const s = messages.showcase
---

<div class="board">
  <div class="board__chrome">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <strong>Heselo · Live</strong>
    <em>{s.shiftLabel}</em>
  </div>
  <div class="board__body">
    <div class="meta">
      <span class="pill">{s.liveLabel}</span>
      <span class="due">{s.dueLabel}</span>
    </div>
    <ul class="tables">
      {
        s.tables.map((row, i) => (
          <li class={`row tone-${i % 4}`}>
            <div>
              <strong>{row.name}</strong>
              <span>{row.meta}</span>
            </div>
            <em>{row.status}</em>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="orbit" aria-hidden="true"></div>
</div>

<style>
  .board {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(circle at 88% 0%, rgba(20, 184, 166, 0.14), transparent 42%),
      linear-gradient(160deg, #ffffff, #f3f8fa);
    box-shadow: var(--shadow);
    overflow: hidden;
    isolation: isolate;
  }
  .board__chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .board__chrome strong {
    margin-left: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }
  .board__chrome em {
    margin-left: auto;
    font-style: normal;
    color: var(--accent);
    font-weight: 700;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #d8e0ea;
  }
  .dot:nth-child(1) {
    background: #fb7185;
  }
  .dot:nth-child(2) {
    background: #fbbf24;
  }
  .dot:nth-child(3) {
    background: #34d399;
  }
  .board__body {
    padding: 1.1rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .pill,
  .due {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pill {
    color: var(--accent);
  }
  .due {
    color: var(--ink-subtle);
  }
  .tables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    animation: fade-up 0.7s var(--ease) both;
  }
  .row:nth-child(2) {
    animation-delay: 0.08s;
  }
  .row:nth-child(3) {
    animation-delay: 0.16s;
  }
  .row:nth-child(4) {
    animation-delay: 0.24s;
  }
  .row strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }
  .row span {
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .row em {
    font-style: normal;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .tone-1 em {
    background: rgba(251, 191, 36, 0.14);
    color: #fbbf24;
  }
  .tone-2 em {
    background: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
  }
  .tone-3 em {
    background: rgba(21, 32, 51, 0.06);
    color: var(--ink-muted);
  }
  .orbit {
    position: absolute;
    inset: auto -20% -35% auto;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px dashed rgba(45, 212, 191, 0.35);
    animation: pulse-line 4s ease-in-out infinite;
    pointer-events: none;
    z-index: -1;
  }
</style>
