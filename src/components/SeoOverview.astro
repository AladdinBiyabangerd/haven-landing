---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const s = messages.seoOverview
---

<section class="overview" id="about" aria-labelledby="seo-overview-title">
  <div class="container">
    <div class="narrow">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 id="seo-overview-title" class="type-card-title">
        {s.title} <span class="accent">{s.titleAccent}</span>
      </h2>
      {s.paragraphs.map((p) => <p class="body">{p}</p>)}
    </div>
  </div>
</section>

<style>
  /* A short definition band, not a full section — it sits under the hero. */
  .overview {
    padding: 0 0 var(--space-section);
  }
  .narrow {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .body {
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
