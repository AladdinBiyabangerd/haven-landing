---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const s = messages.seoOverview
---

<section class="section" id="about" aria-labelledby="seo-overview-title">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 id="seo-overview-title" class="type-section">
        {s.title} <span class="accent">{s.titleAccent}</span>
      </h2>
    </div>
    <div class="body">
      {s.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .narrow {
    max-width: 760px;
  }
  .body {
    display: grid;
    gap: 1rem;
  }
  .body p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: var(--lh-body);
  }
</style>
