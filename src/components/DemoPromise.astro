---
import type { Messages } from '@/i18n/types'

interface Props {
  messages: Messages
}
const { messages } = Astro.props
const d = messages.demoPromise
---

<section class="card promise" aria-labelledby="demo-promise-title">
  <h2 id="demo-promise-title" class="type-card-title">
    {d.title} <span class="accent">{d.titleAccent}</span>
  </h2>
  <ol>
    {
      d.items.map((item) => (
        <li>
          <strong>{item.title}</strong> — {item.desc}
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Sits above the contact form, so it stays a short list rather than cards. */
  .promise {
    margin: 0 0 1.75rem;
  }
  .promise h2 {
    font-size: var(--text-lg);
  }
  ol {
    margin: 0.85rem 0 0;
    padding: 0 0 0 1.1rem;
    display: grid;
    gap: 0.5rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  li::marker {
    color: var(--accent);
    font-weight: 700;
  }
  strong {
    color: var(--ink);
    font-weight: 700;
  }
</style>
