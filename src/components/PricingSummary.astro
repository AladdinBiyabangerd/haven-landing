---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { fillTemplate, formatMoney } from '@/lib/format'
import { localePath } from '@/lib/site'
import { VENUE_OFFERS } from '@/lib/venueOffers'

interface Props {
  locale: Locale
  messages: Messages
}

const { locale, messages } = Astro.props
const page = messages.pricing
---

<section class="pricing-summary" aria-labelledby="pricing-summary-title">
  <p class="eyebrow">{page.summaryEyebrow}</p>
  <h2 id="pricing-summary-title" class="type-card-title">{page.summaryTitle}</h2>
  <p class="lead">{page.summaryLead}</p>
  <ul class="pricing-summary__list">
    {
      VENUE_OFFERS.map((offer) => {
        const from = offer.plans[0].monthlyFee
        return (
          <li>
            <a href={`#${offer.slug}`}>
              <span class="name">{page.offers[offer.slug].name}</span>
              <span class="fee">
                {fillTemplate(page.fromMonthly, { price: formatMoney(from, locale) })}
              </span>
            </a>
          </li>
        )
      })
    }
  </ul>
  <p class="hint type-meta">{page.summaryHint}</p>
  <p class="custom-note type-meta">
    {page.summaryCustom}{' '}
    <a class="link-inline" href={localePath(locale, '/contact')}>{page.summaryCustomLink}</a>.
  </p>
</section>

<style>
  .pricing-summary {
    margin: 0 0 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
    max-width: 40rem;
  }
  .lead {
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .pricing-summary__list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .pricing-summary__list li + li {
    border-top: 1px solid var(--line);
  }
  .pricing-summary__list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    color: inherit;
    text-decoration: none;
  }
  .pricing-summary__list a:hover .name {
    color: var(--accent);
  }
  .name {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .fee {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .hint {
    margin: 0.85rem 0 0;
    color: var(--ink-subtle);
  }
  .custom-note {
    margin: 0.4rem 0 0;
    color: var(--ink-subtle);
  }
</style>
