---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.sessionsMock

/** Demo start — resets on every page load; client tick advances only while open. */
const START_SECONDS = 45 * 60
const DUE_AMOUNT = '24.00 AZN'

function formatHms(totalSeconds: number): string {
  const h = Math.floor(totalSeconds / 3600)
  const m = Math.floor((totalSeconds % 3600) / 60)
  const s = totalSeconds % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
---

<figure class:list={['sm', className]} aria-label={m.ariaLabel}>
  <div class="sm__panel">
    <header class="sm__head">
      <div class="sm__title-row">
        <p class="sm__title">{m.title}</p>
        <span class="sm__badge">
          <i class="sm__pulse" aria-hidden="true"></i>
          {m.statusActive}
        </span>
      </div>
      <BrandMark size={28} />
    </header>

    <div class="sm__card">
      <p class="sm__room">{m.roomLabel}</p>

      <div class="sm__stats">
        <div class="sm__stat">
          <span class="sm__stat-label">{m.elapsedLabel}</span>
          <span class="sm__time" data-start-seconds={START_SECONDS}>{formatHms(START_SECONDS)}</span>
        </div>
        <div class="sm__stat">
          <span class="sm__stat-label">{m.dueLabel}</span>
          <span class="sm__amount">{DUE_AMOUNT}</span>
        </div>
      </div>

      <ul class="sm__chips" aria-hidden="true">
        <li class="sm__chip sm__chip--accent">{m.extendChip}</li>
        <li class="sm__chip">{m.pauseChip}</li>
        <li class="sm__chip">{m.stopChip}</li>
      </ul>
    </div>

    <p class="sm__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .sm {
    container-type: inline-size;
    container-name: sm;
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .sm__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .sm__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .sm__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    min-width: 0;
  }
  .sm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .sm__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .sm__pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    animation: sm-pulse 2s ease-in-out infinite;
  }
  .sm__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0.9rem 0.95rem;
    background: #fff;
    border: 1px solid rgba(20, 184, 166, 0.28);
    border-radius: var(--radius);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }
  .sm__room {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .sm__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }
  .sm__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .sm__stat-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sm__time,
  .sm__amount {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .sm__time {
    color: var(--ink-muted);
  }
  .sm__amount {
    color: var(--ink);
  }
  .sm__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sm__chip {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-muted);
    background: rgba(21, 32, 51, 0.04);
    border: 1px solid rgba(21, 32, 51, 0.08);
  }
  .sm__chip--accent {
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border-color: rgba(20, 184, 166, 0.28);
  }
  .sm__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }
  @keyframes sm-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @container sm (min-width: 28rem) {
    .sm__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .sm__title {
      font-size: var(--text-xl);
    }
    .sm__card {
      padding: 1.15rem 1.1rem 1.05rem;
      gap: 1.15rem;
    }
    .sm__time,
    .sm__amount {
      font-size: var(--text-2xl);
    }
    .sm__hint {
      text-align: left;
    }
  }
</style>

<script>
  function formatHms(totalSeconds: number): string {
    const h = Math.floor(totalSeconds / 3600)
    const m = Math.floor((totalSeconds % 3600) / 60)
    const s = totalSeconds % 60
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }

  declare global {
    interface Window {
      __heseloSmTimer?: number
    }
  }

  function startSessionTimers() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const nodes = document.querySelectorAll<HTMLElement>('.sm__time[data-start-seconds]')
    if (!nodes.length) return

    if (window.__heseloSmTimer) {
      window.clearInterval(window.__heseloSmTimer)
      window.__heseloSmTimer = undefined
    }

    const timers = Array.from(nodes).map((el) => {
      const seconds = Number(el.dataset.startSeconds) || 0
      el.textContent = formatHms(seconds)
      return { el, seconds }
    })

    window.__heseloSmTimer = window.setInterval(() => {
      for (const t of timers) {
        t.seconds += 1
        t.el.textContent = formatHms(t.seconds)
      }
    }, 1000)
  }

  startSessionTimers()
  document.addEventListener('astro:page-load', startSessionTimers)
</script>
