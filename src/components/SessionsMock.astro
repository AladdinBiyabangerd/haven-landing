---
import type { Messages } from '@/i18n/types'
import type { Locale } from '@/i18n/config'
import BrandMark from '@/components/BrandMark.astro'
import { formatMoney } from '@/lib/format'

interface Props {
  messages: Messages
  locale: Locale
  class?: string
}

const { messages, locale, class: className = '' } = Astro.props
const m = messages.sessionsMock

/** Demo start — resets on every page load; client tick advances only while open. */
const START_SECONDS = 45 * 60
const DUE_AMOUNT = formatMoney(24, locale)

function formatHms(totalSeconds: number): string {
  const h = Math.floor(totalSeconds / 3600)
  const m = Math.floor((totalSeconds % 3600) / 60)
  const s = totalSeconds % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
---

<figure
  class:list={['sm', className]}
  aria-label={m.ariaLabel}
  data-status-active={m.statusActive}
  data-status-paused={m.statusPaused}
  data-status-ended={m.statusEnded}
  data-pause-label={m.pauseChip}
  data-resume-label={m.resumeChip}
  data-start-seconds={START_SECONDS}
>
  <div class="sm__panel">
    <header class="sm__head">
      <div class="sm__title-row">
        <p class="sm__title">{m.title}</p>
        <span class="sm__badge" data-sm-badge-active>
          <i class="sm__pulse" aria-hidden="true"></i>
          {m.statusActive}
        </span>
        <span class="sm__badge sm__badge--muted" data-sm-badge-paused hidden>
          {m.statusPaused}
        </span>
        <span class="sm__badge sm__badge--muted" data-sm-badge-ended hidden>
          {m.statusEnded}
        </span>
      </div>
      <BrandMark size={28} />
    </header>

    <div class="sm__card">
      <p class="sm__room">{m.roomLabel}</p>

      <div class="sm__stats">
        <div class="sm__stat">
          <span class="sm__stat-label">{m.elapsedLabel}</span>
          <span class="sm__time" data-start-seconds={START_SECONDS}>{formatHms(START_SECONDS)}</span>
        </div>
        <div class="sm__stat">
          <span class="sm__stat-label">{m.dueLabel}</span>
          <span class="sm__amount">{DUE_AMOUNT}</span>
        </div>
      </div>

      <div class="sm__chips">
        <button type="button" class="sm__chip sm__chip--accent" data-sm-action="extend">
          {m.extendChip}
        </button>
        <button type="button" class="sm__chip" data-sm-action="pause" data-sm-pause>
          {m.pauseChip}
        </button>
        <button type="button" class="sm__chip" data-sm-action="stop">
          {m.stopChip}
        </button>
      </div>
    </div>

    <p class="sm__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .sm {
    container-type: inline-size;
    container-name: sm;
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
  }
  .sm__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .sm__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .sm__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    min-width: 0;
    flex: 1;
  }
  .sm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .sm__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .sm__badge--muted {
    color: var(--ink-subtle);
    background: rgba(21, 32, 51, 0.04);
    border-color: rgba(21, 32, 51, 0.08);
  }
  .sm__badge[hidden] {
    display: none;
  }
  .sm__pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    animation: sm-pulse 2s ease-in-out infinite;
  }
  .sm--paused .sm__pulse,
  .sm--ended .sm__pulse {
    animation: none;
    opacity: 0.4;
  }
  .sm__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1rem 0.9rem 0.95rem;
    background: #fff;
    border: 1px solid rgba(20, 184, 166, 0.28);
    border-radius: var(--radius);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }
  .sm--ended .sm__card {
    border-color: rgba(21, 32, 51, 0.12);
    box-shadow: none;
  }
  .sm__room {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .sm__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    min-width: 0;
  }
  .sm__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .sm__stat-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sm__time,
  .sm__amount {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .sm__time {
    color: var(--ink-muted);
  }
  .sm__amount {
    color: var(--ink);
  }
  .sm__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sm__chip {
    margin: 0;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-muted);
    background: rgba(21, 32, 51, 0.04);
    border: 1px solid rgba(21, 32, 51, 0.08);
    cursor: pointer;
    transition:
      transform 0.12s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .sm__chip:hover:not(:disabled) {
    border-color: rgba(20, 184, 166, 0.35);
  }
  .sm__chip:active:not(:disabled) {
    transform: scale(0.97);
  }
  .sm__chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm__chip:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .sm__chip--accent {
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border-color: rgba(20, 184, 166, 0.28);
  }
  .sm__chip--pressed {
    background: rgba(20, 184, 166, 0.2);
    border-color: rgba(20, 184, 166, 0.4);
  }
  .sm__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }
  @keyframes sm-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @container sm (min-width: 28rem) {
    .sm__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .sm__title {
      font-size: var(--text-xl);
    }
    .sm__card {
      padding: 1.15rem 1.1rem 1.05rem;
      gap: 1.15rem;
    }
    .sm__time,
    .sm__amount {
      font-size: var(--text-2xl);
    }
    .sm__hint {
      text-align: left;
    }
  }
</style>

<script>
  function formatHms(totalSeconds: number): string {
    const h = Math.floor(totalSeconds / 3600)
    const m = Math.floor((totalSeconds % 3600) / 60)
    const s = totalSeconds % 60
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }

  declare global {
    interface Window {
      __heseloSmTimer?: number
    }
  }

  type SmState = { seconds: number; paused: boolean; ended: boolean }

  const states = new WeakMap<HTMLElement, SmState>()

  function getState(root: HTMLElement): SmState {
    let state = states.get(root)
    if (!state) {
      const start = Number(root.dataset.startSeconds) || 0
      state = { seconds: start, paused: false, ended: false }
      states.set(root, state)
    }
    return state
  }

  function paintSession(root: HTMLElement) {
    const state = getState(root)
    const time = root.querySelector<HTMLElement>('.sm__time')
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-sm-pause]')
    const badgeActive = root.querySelector<HTMLElement>('[data-sm-badge-active]')
    const badgePaused = root.querySelector<HTMLElement>('[data-sm-badge-paused]')
    const badgeEnded = root.querySelector<HTMLElement>('[data-sm-badge-ended]')

    if (time) {
      time.dataset.startSeconds = String(state.seconds)
      time.textContent = formatHms(state.seconds)
    }
    root.classList.toggle('sm--paused', state.paused && !state.ended)
    root.classList.toggle('sm--ended', state.ended)

    if (badgeActive) badgeActive.hidden = state.ended || state.paused
    if (badgePaused) badgePaused.hidden = !state.paused || state.ended
    if (badgeEnded) badgeEnded.hidden = !state.ended

    if (pauseBtn) {
      pauseBtn.textContent = state.paused
        ? root.dataset.resumeLabel || ''
        : root.dataset.pauseLabel || ''
      pauseBtn.classList.toggle('sm__chip--pressed', state.paused && !state.ended)
      pauseBtn.disabled = state.ended
    }

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-sm-action="extend"], [data-sm-action="stop"]')) {
      btn.disabled = state.ended
    }
  }

  function tickSessions() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    for (const root of document.querySelectorAll<HTMLElement>('.sm')) {
      const state = getState(root)
      if (state.paused || state.ended) continue
      state.seconds += 1
      const time = root.querySelector<HTMLElement>('.sm__time')
      if (time) {
        time.dataset.startSeconds = String(state.seconds)
        time.textContent = formatHms(state.seconds)
      }
    }
  }

  function ensureSessionTimer() {
    if (window.__heseloSmTimer) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    window.__heseloSmTimer = window.setInterval(tickSessions, 1000)
  }

  function bindSessions() {
    for (const root of document.querySelectorAll<HTMLElement>('.sm')) {
      paintSession(root)
      if (root.dataset.mockSessionBound === '1') continue
      root.dataset.mockSessionBound = '1'

      root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null
        const btn = target?.closest<HTMLButtonElement>('[data-sm-action]')
        if (!btn || btn.disabled || !root.contains(btn)) return
        const state = getState(root)
        const action = btn.dataset.smAction

        if (action === 'extend' && !state.ended) {
          state.seconds += 30 * 60
          btn.classList.add('sm__chip--pressed')
          window.setTimeout(() => btn.classList.remove('sm__chip--pressed'), 220)
          paintSession(root)
          return
        }

        if (action === 'pause' && !state.ended) {
          state.paused = !state.paused
          paintSession(root)
          return
        }

        if (action === 'stop') {
          state.ended = true
          state.paused = true
          state.seconds = Number(root.dataset.startSeconds) || 0
          paintSession(root)
        }
      })
    }
    ensureSessionTimer()
  }

  bindSessions()
  document.addEventListener('astro:page-load', bindSessions)
</script>
