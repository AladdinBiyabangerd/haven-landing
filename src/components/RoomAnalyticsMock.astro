---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'
import { fillTemplate } from '@/lib/format'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.roomAnalyticsMock

/** Demo week — room names match LiveFloorMock stations; amounts illustrate share bars. */
const REVENUE = '1 240 AZN'
const OCCUPANCY = '68%'
const rooms = [
  { name: 'VIP 1', amount: '420 AZN', pct: 34 },
  { name: 'Karaoke 2', amount: '380 AZN', pct: 31 },
  { name: 'Bilyard 1', amount: '290 AZN', pct: 23 },
  { name: m.barLabel, amount: '150 AZN', pct: 12 },
]
---

<figure class:list={['ra', className]} aria-label={m.ariaLabel}>
  <div class="ra__panel">
    <header class="ra__head">
      <div class="ra__titles">
        <div class="ra__title-row">
          <p class="ra__title">{m.title}</p>
          <span class="ra__pill">
            <i class="ra__pill-dot" aria-hidden="true"></i>
            {m.weekPill}
          </span>
        </div>
        <p class="ra__subtitle">{m.subtitle}</p>
      </div>
      <BrandMark size={28} />
    </header>

    <div class="ra__metrics">
      <div class="ra__metric">
        <span class="ra__metric-label">{m.revenueLabel}</span>
        <strong class="ra__metric-value">{REVENUE}</strong>
      </div>
      <div class="ra__metric">
        <span class="ra__metric-label">{m.occupancyLabel}</span>
        <strong class="ra__metric-value">{OCCUPANCY}</strong>
      </div>
    </div>

    <section class="ra__rooms" aria-labelledby="ra-rooms-title">
      <div class="ra__section-head">
        <h2 id="ra-rooms-title" class="ra__section-title">{m.roomsTitle}</h2>
        <span class="ra__section-note">{m.weekPill}</span>
      </div>
      <ul class="ra__list">
        {
          rooms.map((room) => (
            <li>
              <button
                type="button"
                class="ra__room"
                aria-pressed="false"
                aria-label={fillTemplate(m.shareLabel, { pct: room.pct })}
              >
                <div class="ra__room-line">
                  <span class="ra__room-name">{room.name}</span>
                  <span class="ra__room-amount">{room.amount}</span>
                </div>
                <div class="ra__track" aria-hidden="true">
                  <div class="ra__fill" style={`width:${room.pct}%`} />
                </div>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="ra__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .ra {
    container-type: inline-size;
    container-name: ra;
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
  }
  .ra__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .ra__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .ra__titles {
    min-width: 0;
    flex: 1;
  }
  .ra__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
    min-width: 0;
  }
  .ra__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .ra__subtitle {
    margin: 0.3rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
  .ra__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .ra__pill-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .ra__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    min-width: 0;
  }
  .ra__metric {
    min-width: 0;
    padding: 0.7rem 0.75rem 0.65rem;
    background: #fff;
    border: 1px solid rgba(21, 32, 51, 0.08);
    border-radius: var(--radius);
  }
  .ra__metric-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ra__metric-value {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 4.5cqi, 1.35rem);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .ra__rooms {
    min-width: 0;
    padding: 0.65rem 0.75rem 0.35rem;
    background: #fff;
    border: 1px solid rgba(21, 32, 51, 0.08);
    border-radius: var(--radius);
  }
  .ra__section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
    min-width: 0;
  }
  .ra__section-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ra__section-note {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ink-subtle);
  }
  .ra__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ra__list > li {
    border-top: 1px solid rgba(21, 32, 51, 0.06);
  }
  .ra__list > li:first-child {
    border-top: 0;
  }
  .ra__room {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.65rem 0.35rem 0.55rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .ra__room:hover {
    background: rgba(20, 184, 166, 0.06);
  }
  .ra__room:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .ra__room--selected {
    background: rgba(20, 184, 166, 0.12);
    box-shadow: inset 3px 0 0 0 var(--accent);
  }
  .ra__room-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-bottom: 0.45rem;
    min-width: 0;
  }
  .ra__room-name {
    min-width: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .ra__room-amount {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    white-space: nowrap;
  }
  .ra__track {
    height: 0.3rem;
    overflow: hidden;
    border-radius: 999px;
    background: #eaf0f2;
  }
  .ra__fill {
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }
  .ra__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }

  @container ra (max-width: 22rem) {
    .ra__panel {
      padding: 0.7rem 0.65rem 0.65rem;
      gap: 0.55rem;
    }
    .ra__metrics {
      gap: 0.4rem;
    }
    .ra__metric {
      padding: 0.55rem 0.55rem 0.5rem;
    }
    .ra__title {
      font-size: var(--text-md);
    }
    .ra__room-name,
    .ra__room-amount,
    .ra__section-title {
      font-size: 0.75rem;
    }
  }

  @container ra (min-width: 28rem) {
    .ra__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .ra__title {
      font-size: var(--text-xl);
    }
    .ra__rooms {
      padding: 0.75rem 0.85rem 0.45rem;
    }
    .ra__hint {
      text-align: left;
    }
  }
</style>

<script>
  import { bindMockSelect } from '@/lib/mockInteract'

  function bindRoomAnalyticsMock() {
    for (const root of document.querySelectorAll('.ra')) {
      bindMockSelect(root, '.ra__room', 'ra__room--selected')
    }
  }

  bindRoomAnalyticsMock()
  document.addEventListener('astro:page-load', bindRoomAnalyticsMock)
</script>
