---
import type { Messages } from '@/i18n/types'
import type { Locale } from '@/i18n/config'
import { localePath, whatsappUrl } from '@/lib/site'
import ProductShot from '@/components/ProductShot.astro'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const h = messages.hero
const waHref = whatsappUrl(messages.contact.whatsappPrefill)
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal">{h.brandHint}</p>
      <h1 class="type-hero reveal reveal-delay-1">{h.title}</h1>
      <p class="lead reveal reveal-delay-2">{h.subtitle}</p>
      <div class="hero__cta reveal reveal-delay-3">
        <a
          class="btn btn-primary"
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-track-placement="hero"
        >
          {h.ctaPrimary}
        </a>
        <a class="btn btn-ghost" href={localePath(locale, '/contact')} data-track-placement="hero">
          {h.ctaSecondary}
        </a>
      </div>
      <ul class="trust reveal reveal-delay-3">
        {messages.trust.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="hero__visual reveal reveal-delay-2" aria-label={h.visualAlt}>
      <ProductShot messages={messages} id="live-floor" priority />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(2rem, 5vw, 3.25rem) 0 var(--space-section);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: auto -20% 10% 40%;
    height: 50%;
    background: radial-gradient(closest-side, rgba(20, 184, 166, 0.18), transparent 70%);
    filter: blur(10px);
    pointer-events: none;
    animation: drift 8s ease-in-out infinite;
  }
  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  /*
   * Three facts separated by space alone. Dot separators between flex items
   * dangle at the end of whichever line happens to wrap, and the wrap point
   * moves with the viewport — spacing carries the grouping at every width.
   */
  .trust {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.75rem;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }
  .hero__visual {
    position: relative;
  }
  @media (max-width: 559px) {
    .hero__cta .btn {
      flex: 1 1 100%;
    }
    .trust {
      gap: 0.45rem;
    }
    .trust li {
      flex-basis: 100%;
    }
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }
  }
</style>
