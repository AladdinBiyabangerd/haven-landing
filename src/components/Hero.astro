---
import type { Messages } from '@/i18n/types'
import type { Locale } from '@/i18n/config'
import { localePath, whatsappUrl } from '@/lib/site'
import ProductShot from '@/components/ProductShot.astro'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const h = messages.hero
const waHref = whatsappUrl(messages.contact.whatsappPrefill)
const contactHref = localePath(locale, '/contact')
/** EN / intl: form-first (PH bounce ~5s). AZ/RU keep WhatsApp primary. */
const formFirst = locale === 'en'
const primaryHref = formFirst ? contactHref : waHref
const secondaryHref = formFirst ? waHref : contactHref
const primaryIsWhatsApp = !formFirst
const secondaryIsWhatsApp = formFirst
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal">{h.brandHint}</p>
      <h1 class="type-hero reveal reveal-delay-1">{h.title}</h1>
      <p class="lead reveal reveal-delay-2">{h.subtitle}</p>
      <div class="hero__cta reveal reveal-delay-3">
        <a
          class="btn btn-primary hero__cta-primary"
          href={primaryHref}
          target={primaryIsWhatsApp ? '_blank' : undefined}
          rel={primaryIsWhatsApp ? 'noopener noreferrer' : undefined}
          data-track-placement="hero"
        >
          {h.ctaPrimary}
        </a>
        <a
          class="hero__cta-secondary"
          href={secondaryHref}
          target={secondaryIsWhatsApp ? '_blank' : undefined}
          rel={secondaryIsWhatsApp ? 'noopener noreferrer' : undefined}
          data-track-placement="hero"
        >
          {h.ctaSecondary}
        </a>
      </div>
      <ul class="trust reveal reveal-delay-3">
        {messages.trust.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="hero__visual reveal reveal-delay-2">
      <ProductShot messages={messages} id="live-floor" priority />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(1.25rem, 3vw, 3.25rem) 0 clamp(1.5rem, 3vw, var(--space-section));
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: auto -20% 10% 40%;
    height: 50%;
    background: radial-gradient(closest-side, rgba(20, 184, 166, 0.18), transparent 70%);
    filter: blur(10px);
    pointer-events: none;
    animation: drift 8s ease-in-out infinite;
  }
  .hero__grid {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
    margin-top: 1.15rem;
  }
  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .hero__cta-secondary:hover {
    color: var(--accent-deep);
  }
  .trust {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }
  .hero__visual {
    position: relative;
  }
  /* Desktop: soft scale settle (mobile keeps shared fade-up). */
  @keyframes settle {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  /* Mobile-first: one dominant CTA, smaller type, shot below copy. */
  @media (max-width: 959px) {
    .hero :global(.type-hero) {
      font-size: var(--text-3xl);
    }
    .hero :global(.lead) {
      margin-top: 0.5rem;
      font-size: var(--text-md);
      max-width: 28rem;
    }
    .hero__visual {
      max-width: 22rem;
      margin-inline: auto;
    }
    .hero__visual :global(img) {
      max-height: 9.5rem;
      width: 100%;
      object-fit: cover;
      object-position: top left;
    }
    .trust li {
      flex-basis: 100%;
    }
  }
  @media (min-width: 560px) {
    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .hero__cta-primary {
      flex: 0 1 auto;
    }
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }
    .hero__cta-secondary {
      min-height: 2.85rem;
      padding: 0.7rem 1.15rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      text-decoration: none;
      color: var(--ink);
      background: transparent;
    }
    .hero__cta-secondary:hover {
      border-color: var(--accent);
      color: var(--accent-deep);
      background: rgba(20, 184, 166, 0.06);
    }
    .hero__visual {
      max-width: none;
    }
    .hero__visual.reveal {
      animation-name: settle;
      animation-duration: 0.9s;
      transform-origin: center center;
    }
    .hero__visual :global(img) {
      max-height: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual.reveal {
      animation: none;
    }
  }
</style>
