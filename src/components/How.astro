---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const h = messages.how
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{h.eyebrow}</p>
      <h2 class="type-section">{h.title} <span class="accent">{h.titleAccent}</span></h2>
    </div>
    <ol class="steps">
      {
        h.steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="type-card-title">{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem var(--gap);
  }
  li {
    display: grid;
    gap: 0.3rem;
  }
  .num {
    display: grid;
    place-content: center;
    width: 1.85rem;
    height: 1.85rem;
    margin-bottom: 0.35rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
  }
  p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap);
    }
  }
</style>
