---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const h = messages.how
const last = h.steps.length - 1
---

<section class="section how reveal-on-scroll" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{h.eyebrow}</p>
      <h2 id="how-title" class="type-section">{h.title} <span class="accent">{h.titleAccent}</span></h2>
    </div>
    <ol class="steps">
      {
        h.steps.map((step, i) => (
          <li>
            <div class="rail" aria-hidden="true">
              <span class="dot" />
              {i < last ? <span class="arrow" /> : null}
            </div>
            <div class="step-body">
              <h3 class="type-card-title">{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .how .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .how .steps > li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0 0.85rem;
    align-items: stretch;
  }

  .how .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.45rem;
  }

  .how .dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--accent);
  }

  .how .arrow {
    display: block;
    flex: 1 1 auto;
    width: 2px;
    min-height: 2.25rem;
    margin-top: 0.35rem;
    background: linear-gradient(
      to bottom,
      rgba(15, 118, 110, 0.55),
      rgba(15, 118, 110, 0.25)
    );
    position: relative;
  }

  .how .arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0;
    height: 0;
    transform: translateX(-50%);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid var(--accent);
  }

  .how .step-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    padding-bottom: 1.25rem;
  }

  .how .steps > li:last-child .step-body {
    padding-bottom: 0;
  }

  .how .step-body .type-card-title {
    font-size: var(--text-md);
  }

  .how .step-body p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--lh-body);
  }

  @media (min-width: 800px) {
    .how .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap);
    }

    .how .steps > li {
      grid-template-columns: 1fr;
    }

    .how .rail {
      display: none;
    }

    .how .step-body {
      padding-bottom: 0;
    }

    .how .step-body .type-card-title {
      font-size: inherit;
    }
  }
</style>
