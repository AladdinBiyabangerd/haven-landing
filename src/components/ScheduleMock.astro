---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'
import { fillTemplate } from '@/lib/format'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.scheduleMock

const rows = [
  {
    room: m.rooms.vip1,
    status: m.statusBooked,
    booked: true,
    slot: m.slots.vip1,
    guest: m.guests.aysel,
  },
  {
    room: m.rooms.karaoke2,
    status: m.statusBooked,
    booked: true,
    slot: m.slots.karaoke2,
    guest: m.guests.rashad,
  },
  {
    room: m.rooms.vip2,
    status: m.statusFree,
    booked: false,
    slot: m.slots.vip2,
    guest: '',
  },
]
---

<figure
  class:list={['sch', className]}
  aria-label={m.ariaLabel}
  data-status-booked={m.statusBooked}
  data-status-free={m.statusFree}
>
  <header class="sch__header">
    <div class="sch__heading">
      <p class="sch__title">{m.title}</p>
      <span class="sch__day">{m.dayPill}</span>
    </div>
    <BrandMark size={28} />
  </header>

  <div class="sch__list" role="list">
    {
      rows.map((row) => (
        <button
          type="button"
          class="sch__row"
          role="listitem"
          data-booked={row.booked ? 'true' : 'false'}
          data-slot={row.slot}
          data-guest={row.guest}
          aria-pressed="false"
          aria-label={fillTemplate(m.selectRow, { name: row.room })}
        >
          <div class="sch__room-wrap">
            <span class="sch__room">{row.room}</span>
            <span class:list={['sch__status', row.booked ? 'sch__status--booked' : 'sch__status--free']}>
              {row.status}
            </span>
          </div>
          <div class="sch__details">
            <span class:list={['sch__slot', !row.booked && 'sch__slot--empty']}>{row.slot}</span>
            <span class:list={['sch__guest', !row.booked && 'sch__guest--empty']}>
              {row.booked ? row.guest : '—'}
            </span>
          </div>
        </button>
      ))
    }
  </div>

  <div class="sch__actions">
    <button type="button" class="sch__chip sch__chip--move" data-sch-action="move">
      {m.moveChip}
    </button>
    <button type="button" class="sch__chip sch__chip--cancel" data-sch-action="cancel">
      {m.cancelChip}
    </button>
  </div>

  <p class="sch__hint">{m.hint}</p>
</figure>

<style>
  .sch {
    container-type: inline-size;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 0.9rem 0.85rem 0.8rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: #202b32;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    font-variant-numeric: tabular-nums;
  }

  .sch *,
  .sch *::before,
  .sch *::after {
    box-sizing: border-box;
  }

  .sch__header,
  .sch__heading,
  .sch__room-wrap,
  .sch__details,
  .sch__actions {
    display: flex;
    align-items: center;
  }

  .sch__header {
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    min-width: 0;
  }

  .sch__heading {
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .sch__title {
    margin: 0;
    color: #202b32;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .sch__day {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid rgba(20, 184, 166, 0.2);
    border-radius: 7px;
    background: rgba(20, 184, 166, 0.1);
    color: #087f75;
    font-size: 0.75rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .sch__list {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(68, 88, 101, 0.13);
  }

  .sch__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 3.5rem;
    margin: 0;
    padding: 0.65rem 0.35rem;
    border: 0;
    border-bottom: 1px solid rgba(68, 88, 101, 0.13);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .sch__row:hover {
    background: rgba(20, 184, 166, 0.06);
  }

  .sch__row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .sch__row--selected {
    background: rgba(20, 184, 166, 0.12);
    box-shadow: inset 3px 0 0 0 var(--accent);
  }

  .sch__row--flash {
    animation: sch-flash 0.45s ease;
  }

  @keyframes sch-flash {
    0%,
    100% {
      background: rgba(20, 184, 166, 0.12);
    }
    40% {
      background: rgba(20, 184, 166, 0.28);
    }
  }

  .sch__room-wrap {
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sch__room {
    min-width: 0;
    color: #26343c;
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .sch__status {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-height: 1.35rem;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.2;
    white-space: nowrap;
  }

  .sch__status--booked {
    border: 1px solid rgba(20, 184, 166, 0.24);
    background: rgba(20, 184, 166, 0.13);
    color: #087f75;
  }

  .sch__status--free {
    border: 1px solid rgba(84, 101, 113, 0.13);
    background: rgba(84, 101, 113, 0.08);
    color: #66747d;
  }

  .sch__details {
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.25rem 0.65rem;
    min-width: 0;
    text-align: right;
  }

  .sch__slot,
  .sch__guest {
    color: #34434b;
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .sch__slot {
    font-weight: 650;
  }

  .sch__guest {
    color: #65747c;
    font-weight: 500;
  }

  .sch__slot--empty,
  .sch__guest--empty {
    color: #89959c;
  }

  .sch__actions {
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .sch__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.8rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 7px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      opacity 0.15s ease,
      transform 0.12s ease;
  }

  .sch__chip:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .sch__chip:not(:disabled):active {
    transform: scale(0.97);
  }

  .sch__chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sch__chip--move {
    border-color: rgba(20, 184, 166, 0.28);
    background: #14b8a6;
    color: #073c39;
  }

  .sch__chip--cancel {
    border-color: rgba(84, 101, 113, 0.18);
    background: rgba(255, 255, 255, 0.35);
    color: #596870;
  }

  .sch__hint {
    margin: 0.75rem 0 0;
    color: #718089;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @container (max-width: 26rem) {
    .sch {
      padding: 0.75rem;
    }

    .sch__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, auto);
      gap: 0.45rem;
    }

    .sch__room-wrap {
      gap: 0.3rem;
    }

    .sch__details {
      display: grid;
      justify-items: end;
      gap: 0.1rem;
    }
  }
</style>

<script>
  function paintRow(row: HTMLButtonElement, booked: boolean, slot: string, guest: string, root: HTMLElement) {
    const statusBooked = root.dataset.statusBooked || ''
    const statusFree = root.dataset.statusFree || ''
    const status = row.querySelector('.sch__status')
    const slotEl = row.querySelector('.sch__slot')
    const guestEl = row.querySelector('.sch__guest')
    if (!status || !slotEl || !guestEl) return

    row.dataset.booked = booked ? 'true' : 'false'
    row.dataset.slot = slot
    row.dataset.guest = guest
    status.className = `sch__status ${booked ? 'sch__status--booked' : 'sch__status--free'}`
    status.textContent = booked ? statusBooked : statusFree
    slotEl.textContent = slot
    slotEl.classList.toggle('sch__slot--empty', !booked)
    guestEl.textContent = booked && guest ? guest : '—'
    guestEl.classList.toggle('sch__guest--empty', !booked)
  }

  function selectedRow(root: HTMLElement): HTMLButtonElement | null {
    return root.querySelector<HTMLButtonElement>('.sch__row--selected')
  }

  function syncChips(root: HTMLElement) {
    const selected = selectedRow(root)
    const booked = selected?.dataset.booked === 'true'
    for (const chip of root.querySelectorAll<HTMLButtonElement>('.sch__chip')) {
      chip.disabled = !selected || !booked
    }
  }

  function bindScheduleMock() {
    for (const root of document.querySelectorAll<HTMLElement>('.sch')) {
      if (root.dataset.mockScheduleBound === '1') continue
      root.dataset.mockScheduleBound = '1'
      syncChips(root)

      root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null
        const row = target?.closest<HTMLButtonElement>('.sch__row')
        if (row && root.contains(row)) {
          for (const el of root.querySelectorAll<HTMLButtonElement>('.sch__row')) {
            const on = el === row
            el.classList.toggle('sch__row--selected', on)
            el.setAttribute('aria-pressed', on ? 'true' : 'false')
          }
          syncChips(root)
          return
        }

        const actionBtn = target?.closest<HTMLButtonElement>('[data-sch-action]')
        if (!actionBtn || actionBtn.disabled) return
        const selected = selectedRow(root)
        if (!selected || selected.dataset.booked !== 'true') return
        const action = actionBtn.dataset.schAction

        if (action === 'cancel') {
          paintRow(selected, false, '—', '', root)
          selected.classList.add('sch__row--flash')
          window.setTimeout(() => selected.classList.remove('sch__row--flash'), 450)
          syncChips(root)
          return
        }

        if (action === 'move') {
          const free = root.querySelector<HTMLButtonElement>('.sch__row[data-booked="false"]')
          if (!free || free === selected) {
            selected.classList.add('sch__row--flash')
            window.setTimeout(() => selected.classList.remove('sch__row--flash'), 450)
            return
          }
          const slot = selected.dataset.slot || '—'
          const guest = selected.dataset.guest || ''
          paintRow(free, true, slot, guest, root)
          paintRow(selected, false, '—', '', root)
          for (const el of root.querySelectorAll<HTMLButtonElement>('.sch__row')) {
            const on = el === free
            el.classList.toggle('sch__row--selected', on)
            el.setAttribute('aria-pressed', on ? 'true' : 'false')
          }
          free.classList.add('sch__row--flash')
          window.setTimeout(() => free.classList.remove('sch__row--flash'), 450)
          syncChips(root)
        }
      })
    }
  }

  bindScheduleMock()
  document.addEventListener('astro:page-load', bindScheduleMock)
</script>
