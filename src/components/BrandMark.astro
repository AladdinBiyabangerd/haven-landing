---
interface Props {
  size?: number
}
const { size = 40 } = Astro.props
const gid = `hmark-${Math.random().toString(36).slice(2, 8)}`
---

<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gid} x1="16" y1="16" x2="104" y2="104" gradientUnits="userSpaceOnUse">
      <stop stop-color="#14B8A6"></stop>
      <stop offset="1" stop-color="#0F766E"></stop>
    </linearGradient>
  </defs>
  <rect x="8" y="8" width="104" height="104" rx="28" fill={`url(#${gid})`} opacity="0.12"></rect>
  <circle cx="60" cy="60" r="46" stroke={`url(#${gid})`} stroke-width="4" opacity="0.35"></circle>
  <circle
    cx="60"
    cy="60"
    r="34"
    stroke={`url(#${gid})`}
    stroke-width="7"
    stroke-dasharray="40 16 10 16"
    stroke-linecap="round"
    transform="rotate(15 60 60)"></circle>
  <path
    d="M46 40v40M74 40v40M46 60h28"
    stroke={`url(#${gid})`}
    stroke-width="8.5"
    stroke-linecap="round"></path>
  <circle cx="94" cy="30" r="7" fill="#0F766E"></circle>
</svg>

<style>
  .brand-mark {
    flex-shrink: 0;
    display: block;
  }
</style>
