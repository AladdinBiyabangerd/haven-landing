---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath, whatsappUrl } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const h = messages.homePricing
const formFirst = locale === 'en'
const waHref = whatsappUrl(messages.contact.whatsappPrefill)
const contactHref = localePath(locale, '/contact')
const pricingHref = localePath(locale, '/pricing')
const demoHref = formFirst ? contactHref : waHref
const demoExternal = !formFirst
---

<section class="section pricing-teaser reveal-on-scroll" aria-labelledby="home-pricing-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{h.eyebrow}</p>
      <h2 id="home-pricing-title" class="type-section">
        {h.title} <span class="accent">{h.titleAccent}</span>
      </h2>
      <p class="lead">{h.lead}</p>
    </div>
    <div class="pricing-teaser__cta">
      <a class="btn btn-primary" href={pricingHref} data-track-placement="home-pricing">
        {h.ctaPricing}
      </a>
      <a
        class="pricing-teaser__secondary"
        href={demoHref}
        target={demoExternal ? '_blank' : undefined}
        rel={demoExternal ? 'noopener noreferrer' : undefined}
        data-track-placement="home-pricing"
      >
        {h.ctaDemo}
      </a>
    </div>
  </div>
</section>

<style>
  .pricing-teaser.section {
    padding-block: 1.35rem;
  }
  .pricing-teaser .section-head {
    margin-bottom: 0.85rem;
  }
  .pricing-teaser .section-head .lead {
    margin-top: 0.35rem;
    max-width: 36rem;
  }
  .pricing-teaser__cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
  }
  .pricing-teaser__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .pricing-teaser__secondary:hover {
    color: var(--accent-deep);
  }
  @media (min-width: 560px) {
    .pricing-teaser__cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
  /* Desktop: copy left, actions right — fills the empty half and shortens the band. */
  @media (min-width: 900px) {
    .pricing-teaser .container {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) auto;
      gap: 1rem 2rem;
      align-items: end;
    }
    .pricing-teaser .section-head {
      margin-bottom: 0;
    }
    .pricing-teaser__secondary {
      min-height: 2.85rem;
      padding: 0.7rem 1.15rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      text-decoration: none;
      color: var(--ink);
    }
    .pricing-teaser__secondary:hover {
      border-color: var(--accent);
      color: var(--accent-deep);
      background: rgba(20, 184, 166, 0.06);
    }
  }
</style>
