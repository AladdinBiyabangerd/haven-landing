---
import type { Locale } from '@/i18n/config'
import type { BreadcrumbItem } from '@/lib/seo'

interface Props {
  locale: Locale
  items: BreadcrumbItem[]
  ariaLabel: string
}
const { items, ariaLabel } = Astro.props
if (items.length < 2) return null

/** Parent page to go “back” to (home or hub), never the current page. */
const parent = [...items].reverse().find((item) => !item.current) ?? items[0]
---

<nav class="breadcrumbs container" aria-label={ariaLabel}>
  <a class="breadcrumbs__back" href={parent.href}>
    <span class="breadcrumbs__chevron" aria-hidden="true">←</span>
    <span class="breadcrumbs__back-label">{parent.label}</span>
  </a>
  <ol class="breadcrumbs__trail">
    {
      items.map((item, i) => (
        <li>
          {item.current || i === items.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    display: grid;
    gap: 0.45rem;
    padding: 0.75rem 0 0;
  }
  /* Primary escape hatch — large enough to notice on a phone. */
  .breadcrumbs__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    max-width: 100%;
    min-height: 2.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
  }
  .breadcrumbs__back:hover {
    border-color: var(--accent);
    color: var(--accent-deep);
    background: var(--accent-soft);
  }
  .breadcrumbs__chevron {
    flex-shrink: 0;
    font-size: 1.05em;
  }
  .breadcrumbs__back-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .breadcrumbs__trail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
  .breadcrumbs__trail li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--ink-subtle);
    opacity: 0.7;
  }
  .breadcrumbs__trail a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .breadcrumbs__trail a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  span[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  /* Desktop: trail left + back right on one row. */
  @media (min-width: 960px) {
    .breadcrumbs {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 0.85rem;
    }
    .breadcrumbs__back {
      flex-shrink: 0;
      min-height: 0;
      padding: 0;
      border: none;
      background: transparent;
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--ink-muted);
    }
    .breadcrumbs__back:hover {
      background: transparent;
      color: var(--accent);
    }
    .breadcrumbs__trail {
      font-size: var(--text-sm);
      min-width: 0;
    }
  }
</style>
