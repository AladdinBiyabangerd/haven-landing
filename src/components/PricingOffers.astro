---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'
import { fillTemplate, formatMoney } from '@/lib/format'
import {
  crossoverPoints,
  getActiveOffers,
  loadVenueOffers,
  resolvePlanMarketing,
  VENUE_STORAGE_KEY,
} from '@/lib/venueOffers'

interface Props {
  locale: Locale
  messages: Messages
}

const { locale, messages } = Astro.props
const page = messages.pricing
await loadVenueOffers()
const offers = getActiveOffers()
const slugs = offers.map((offer) => offer.slug)
const calculatorData = Object.fromEntries(
  offers.map((offer) => [
    offer.slug,
    {
      plans: offer.plans.map((plan) => ({
        id: plan.id,
        monthlyFee: plan.monthlyFee,
        annualFee: plan.annualFee,
        includedReservations: plan.includedReservations,
        overagePerReservation: plan.overagePerReservation,
      })),
    },
  ]),
)

function planFeatures(features: string[], upTo: number): string[] {
  return features.map((item) => fillTemplate(item, { n: upTo }))
}

/** How many feature bullets show before “read more”. */
const PLAN_FEATURE_PREVIEW = 5
---

<div class="pricing-offers" data-pricing-offers data-track-placement="pricing" data-storage-key={VENUE_STORAGE_KEY}>
  <div class="chooser">
    <p class="chooser-label" id="venue-type-label">{page.chooseType}</p>
    <div class="types" role="tablist" aria-labelledby="venue-type-label">
      {
        offers.map((offer, index) => (
          <a
            href={`#${offer.slug}`}
            role="tab"
            id={`tab-${offer.slug}`}
            data-type={offer.slug}
            aria-controls={offer.slug}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-current={index === 0 ? 'true' : undefined}
          >
            {page.offers[offer.slug].name}
          </a>
        ))
      }
    </div>
  </div>

  {
    offers.map((offer, index) => {
      const copy = page.offers[offer.slug]
      const crossovers = crossoverPoints(offer.slug, offers)
      const defaultPlanIndex = Math.max(
        0,
        offer.plans.findIndex((plan) => plan.id === 'plus'),
      )
      return (
        /* The first type is open on load — an empty pricing page helps nobody. */
        <section
          class:list={['panel', { 'is-open': index === 0 }]}
          id={offer.slug}
          role="tabpanel"
          aria-labelledby={`tab-${offer.slug}`}
          data-panel={offer.slug}
          hidden={index !== 0}
        >
          <p class="panel__intro">{copy.intro}</p>
          <div
            class="plans-carousel"
            data-plans-carousel
            data-plan-index={defaultPlanIndex}
          >
            <button type="button" class="plans-nav plans-nav--prev" data-plan-prev aria-label={page.planPrev}>
              <span aria-hidden="true">‹</span>
            </button>
            <div class="plans" data-plans-track>
              {offer.plans.map((plan) => {
                const planCopy = resolvePlanMarketing(plan, locale, copy.plans[plan.id])
                const featured = plan.id === 'plus'
                const featureItems = [
                  ...planFeatures(planCopy.features, plan.upTo),
                  fillTemplate(page.includedReservations, {
                    n: plan.includedReservations,
                  }),
                  fillTemplate(page.overage, {
                    price: formatMoney(plan.overagePerReservation, locale),
                  }),
                  fillTemplate(page.oneVenue, {
                    n: plan.includedVenues,
                  }),
                  fillTemplate(page.staffPerVenue, {
                    n: plan.maxStaffPerVenue,
                  }),
                  fillTemplate(page.dataRetentionMonths, {
                    n: plan.dataRetentionMonths,
                  }),
                ]
                const hasMoreFeatures = featureItems.length > PLAN_FEATURE_PREVIEW
                return (
                  <article class:list={['card', { featured }]} data-plan-card>
                    <header>
                      <h3 class="type-card-title">{page.planNames[plan.id]}</h3>
                      {featured ? <span class="badge">{page.popular}</span> : null}
                    </header>
                    <p class="price">
                      <span data-plan-price>{formatMoney(plan.monthlyFee, locale)}</span>
                      <span data-plan-period>{page.periodMonthly}</span>
                    </p>
                    <p
                      class="price-alternative"
                      data-plan-alternative
                      data-monthly={fillTemplate(page.monthlyAlternative, {
                        price: formatMoney(plan.monthlyFee, locale),
                      })}
                      data-annual={fillTemplate(page.annualAlternative, {
                        price: formatMoney(plan.annualFee, locale),
                      })}
                    >
                      {fillTemplate(page.annualAlternative, {
                        price: formatMoney(plan.annualFee, locale),
                      })}
                    </p>
                    <p class="for-whom">{planCopy.forWhom}</p>
                    <ul>
                      {featureItems.map((item, featureIndex) => (
                        <li data-feature-extra={featureIndex >= PLAN_FEATURE_PREVIEW ? '' : undefined}>
                          {item}
                        </li>
                      ))}
                    </ul>
                    {hasMoreFeatures ? (
                      <button
                        type="button"
                        class="features-more"
                        data-features-toggle
                        data-more={page.planFeaturesMore}
                        data-less={page.planFeaturesLess}
                        aria-expanded="false"
                      >
                        {page.planFeaturesMore}
                      </button>
                    ) : null}
                    <a
                      class:list={['btn', featured ? 'btn-primary' : 'btn-ghost']}
                      href={`${localePath(locale, '/contact')}?type=${offer.slug}&plan=${plan.id}&period=monthly`}
                      data-contact-link
                      data-plan={plan.id}
                      data-contact-base={`${localePath(locale, '/contact')}?type=${offer.slug}&plan=${plan.id}`}
                    >
                      {page.cta}
                    </a>
                  </article>
                )
              })}
            </div>
            <button type="button" class="plans-nav plans-nav--next" data-plan-next aria-label={page.planNext}>
              <span aria-hidden="true">›</span>
            </button>
            <div class="plans-dots" role="tablist">
              {offer.plans.map((plan, planIndex) => (
                <button
                  type="button"
                  role="tab"
                  data-plan-dot={planIndex}
                  aria-label={page.planNames[plan.id]}
                  aria-selected={planIndex === defaultPlanIndex ? 'true' : 'false'}
                />
              ))}
            </div>
          </div>
          <details class="calculator-details">
            <summary>{page.calculator.revealLabel}</summary>
            <section
              class="calculator"
              id={`calculator-${offer.slug}`}
              data-calculator
              data-offer={offer.slug}
              data-period-monthly={page.periodMonthly}
              data-period-annual={page.periodAnnual}
            >
              <div class="calculator__head">
                <div>
                  <p class="eyebrow">{page.calculator.eyebrow}</p>
                  <h3 class="type-card-title">{page.calculator.title}</h3>
                  <p>{page.calculator.description}</p>
                </div>
                <div class="calculator__controls">
                  <label>
                    <span>{page.calculator.reservationCount}</span>
                    <input
                      type="number"
                      min="0"
                      max="100000000"
                      step="1"
                      value="400"
                      inputmode="numeric"
                      data-reservation-count
                    />
                  </label>
                  <fieldset>
                    <legend>{page.calculator.billingPeriod}</legend>
                    <div class="period-toggle">
                      <label>
                        <input type="radio" name={`period-${offer.slug}`} value="monthly" checked />
                        <span>{page.calculator.monthly}</span>
                      </label>
                      <label>
                        <input type="radio" name={`period-${offer.slug}`} value="annual" />
                        <span>{page.calculator.annual}</span>
                      </label>
                    </div>
                  </fieldset>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{page.calculator.plan}</th>
                      <th scope="col">{page.calculator.baseFee}</th>
                      <th scope="col">{page.calculator.overageCost}</th>
                      <th scope="col">{page.calculator.total}</th>
                    </tr>
                  </thead>
                  <tbody aria-live="polite">
                    {offer.plans.map((plan) => (
                      <tr data-calculator-row={plan.id}>
                        <th scope="row">
                          {page.planNames[plan.id]}
                          <span class="cheapest" data-cheapest hidden>{page.calculator.cheapest}</span>
                        </th>
                        <td data-base-fee>{formatMoney(plan.monthlyFee, locale)}</td>
                        <td data-overage-cost>{formatMoney(0, locale)}</td>
                        <td data-total>{formatMoney(plan.monthlyFee, locale)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="crossover">
                <h4>{page.calculator.crossoverTitle}</h4>
                {crossovers.length > 0 ? (
                  <ul>
                    {crossovers.map((point) => (
                      <li>
                        {fillTemplate(page.calculator.crossoverHint, {
                          from: page.planNames[point.fromPlanId],
                          to: page.planNames[point.toPlanId],
                          n: point.atCount,
                        })}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p>{page.calculator.noCrossover}</p>
                )}
              </div>
            </section>
          </details>
          <div class="custom">
            <div>
              <h3 class="type-card-title">{page.custom.name}</h3>
              <p>{page.custom.desc}</p>
            </div>
            <a
              class="btn btn-ghost"
              href={`${localePath(locale, '/contact')}?type=${offer.slug}&plan=custom&period=monthly`}
              data-contact-link
              data-plan="custom"
              data-contact-base={`${localePath(locale, '/contact')}?type=${offer.slug}&plan=custom`}
            >
              {page.custom.cta}
            </a>
          </div>
        </section>
      )
    })
  }
</div>

<script is:inline define:vars={{ calculatorData, locale, slugs, storageKey: VENUE_STORAGE_KEY }}>
  const root = document.querySelector('[data-pricing-offers]')
  if (root instanceof HTMLElement) {
    const tabs = [...root.querySelectorAll('[data-type]')]
    const panels = [...root.querySelectorAll('[data-panel]')]
    const valid = new Set(slugs)

    function selectType(slug, pushHash) {
      if (!valid.has(slug)) return
      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return
        const on = panel.dataset.panel === slug
        panel.hidden = !on
        panel.classList.toggle('is-open', on)
      })
      tabs.forEach((tab) => {
        const on = tab.getAttribute('data-type') === slug
        tab.setAttribute('aria-selected', on ? 'true' : 'false')
        if (on) tab.setAttribute('aria-current', 'true')
        else tab.removeAttribute('aria-current')
      })
      try {
        sessionStorage.setItem(storageKey, slug)
      } catch {
        /* ignore */
      }
      if (pushHash && location.hash !== `#${slug}`) {
        history.replaceState(null, '', `#${slug}`)
      }
    }

    function readInitial() {
      const hash = location.hash.replace(/^#/, '')
      if (valid.has(hash)) return hash
      const query = new URLSearchParams(location.search).get('type')
      if (query && valid.has(query)) return query
      try {
        const stored = sessionStorage.getItem(storageKey)
        if (stored && valid.has(stored)) return stored
      } catch {
        /* ignore */
      }
      return ''
    }

    const initial = readInitial()
    if (initial) selectType(initial, true)

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        const slug = tab.getAttribute('data-type') || ''
        if (!valid.has(slug)) return
        event.preventDefault()
        selectType(slug, true)
      })
    })

    window.addEventListener('hashchange', () => {
      const slug = location.hash.replace(/^#/, '')
      if (valid.has(slug)) selectType(slug, false)
    })

    const carouselMq = window.matchMedia('(max-width: 899px)')

    root.querySelectorAll('[data-plans-carousel]').forEach((carousel) => {
      if (!(carousel instanceof HTMLElement)) return
      const track = carousel.querySelector('[data-plans-track]')
      const cards = [...carousel.querySelectorAll('[data-plan-card]')]
      const dots = [...carousel.querySelectorAll('[data-plan-dot]')]
      const prev = carousel.querySelector('[data-plan-prev]')
      const next = carousel.querySelector('[data-plan-next]')
      if (!(track instanceof HTMLElement) || cards.length === 0) return

      let index = Number(carousel.dataset.planIndex)
      if (!Number.isFinite(index) || index < 0 || index >= cards.length) index = 0
      let scrolling = false

      function isCarousel() {
        return carouselMq.matches
      }

      function syncDots(active) {
        index = active
        carousel.dataset.planIndex = String(active)
        dots.forEach((dot, i) => {
          dot.setAttribute('aria-selected', i === active ? 'true' : 'false')
        })
      }

      function scrollToIndex(nextIndex, behavior) {
        if (!isCarousel()) return
        const target = ((nextIndex % cards.length) + cards.length) % cards.length
        const card = cards[target]
        if (!(card instanceof HTMLElement)) return
        scrolling = true
        syncDots(target)
        const left =
          card.offsetLeft - (track.clientWidth - card.clientWidth) / 2
        track.scrollTo({ left: Math.max(0, left), behavior: behavior || 'smooth' })
        window.setTimeout(() => {
          scrolling = false
        }, 400)
      }

      function nearestIndex() {
        const mid = track.scrollLeft + track.clientWidth / 2
        let best = 0
        let bestDist = Number.POSITIVE_INFINITY
        cards.forEach((card, i) => {
          if (!(card instanceof HTMLElement)) return
          const center = card.offsetLeft + card.clientWidth / 2
          const dist = Math.abs(center - mid)
          if (dist < bestDist) {
            bestDist = dist
            best = i
          }
        })
        return best
      }

      prev?.addEventListener('click', () => scrollToIndex(index - 1, 'smooth'))
      next?.addEventListener('click', () => scrollToIndex(index + 1, 'smooth'))
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const i = Number(dot.getAttribute('data-plan-dot'))
          if (Number.isFinite(i)) scrollToIndex(i, 'smooth')
        })
      })

      track.addEventListener(
        'scroll',
        () => {
          if (!isCarousel() || scrolling) return
          syncDots(nearestIndex())
        },
        { passive: true },
      )

      carousel.querySelectorAll('[data-features-toggle]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return
        button.addEventListener('click', () => {
          const card = button.closest('[data-plan-card]')
          if (!(card instanceof HTMLElement)) return
          const open = !card.classList.contains('is-expanded')
          card.classList.toggle('is-expanded', open)
          button.setAttribute('aria-expanded', open ? 'true' : 'false')
          button.textContent = open ? button.dataset.less || '' : button.dataset.more || ''
        })
      })

      const panel = carousel.closest('[data-panel]')
      const ready = () => {
        if (panel instanceof HTMLElement && panel.hidden) return
        if (!isCarousel()) {
          track.scrollLeft = 0
          return
        }
        requestAnimationFrame(() => {
          requestAnimationFrame(() => scrollToIndex(index, 'auto'))
        })
      }
      ready()
      carouselMq.addEventListener('change', ready)
      if (panel instanceof HTMLElement) {
        const observer = new MutationObserver(() => {
          if (!panel.hidden) ready()
        })
        observer.observe(panel, { attributes: true, attributeFilter: ['hidden', 'class'] })
      }
    })

    const intlLocale = { az: 'az-AZ', en: 'en-GB', ru: 'ru-RU' }
    const money = new Intl.NumberFormat(intlLocale[locale] || 'az-AZ', {
      style: 'currency',
      currency: 'AZN',
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    })

    root.querySelectorAll('[data-calculator]').forEach((calculator) => {
      if (!(calculator instanceof HTMLElement)) return
      const offerSlug = calculator.dataset.offer || ''
      const offer = calculatorData[offerSlug]
      if (!offer) return
      const countInput = calculator.querySelector('[data-reservation-count]')
      const panel = calculator.closest('[data-panel]')

      function selectedPeriod() {
        const selected = calculator.querySelector('input[type="radio"]:checked')
        return selected instanceof HTMLInputElement && selected.value === 'annual'
          ? 'annual'
          : 'monthly'
      }

      const MAX_RESERVATION_COUNT = 100_000_000

      function update() {
        let rawCount = countInput instanceof HTMLInputElement ? Number(countInput.value) : 0
        if (countInput instanceof HTMLInputElement && Number.isFinite(rawCount) && rawCount > MAX_RESERVATION_COUNT) {
          countInput.value = String(MAX_RESERVATION_COUNT)
          rawCount = MAX_RESERVATION_COUNT
        }
        const count =
          Number.isFinite(rawCount) && rawCount > 0
            ? Math.min(MAX_RESERVATION_COUNT, Math.floor(rawCount))
            : 0
        const period = selectedPeriod()
        let cheapestId = ''
        let cheapestTotal = Number.POSITIVE_INFINITY

        offer.plans.forEach((plan) => {
          const overageCount = Math.max(0, count - plan.includedReservations)
          const overageCost = Math.round(overageCount * plan.overagePerReservation * 100) / 100
          const baseFee = period === 'annual' ? plan.annualFee : plan.monthlyFee
          const total = Math.round((baseFee + overageCost) * 100) / 100
          if (total < cheapestTotal) {
            cheapestId = plan.id
            cheapestTotal = total
          }
          const row = calculator.querySelector(`[data-calculator-row="${plan.id}"]`)
          if (!(row instanceof HTMLElement)) return
          const baseCell = row.querySelector('[data-base-fee]')
          const overageCell = row.querySelector('[data-overage-cost]')
          const totalCell = row.querySelector('[data-total]')
          if (baseCell) baseCell.textContent = money.format(baseFee)
          if (overageCell) overageCell.textContent = money.format(overageCost)
          if (totalCell) totalCell.textContent = money.format(total)
        })

        calculator.querySelectorAll('[data-calculator-row]').forEach((row) => {
          if (!(row instanceof HTMLElement)) return
          const isCheapest = row.dataset.calculatorRow === cheapestId
          row.classList.toggle('is-cheapest', isCheapest)
          const badge = row.querySelector('[data-cheapest]')
          if (badge instanceof HTMLElement) badge.hidden = !isCheapest
        })

        if (panel instanceof HTMLElement) {
          panel.querySelectorAll('[data-contact-link]').forEach((link) => {
            if (!(link instanceof HTMLAnchorElement)) return
            link.href = `${link.dataset.contactBase || link.href}&period=${period}`
          })
          panel.querySelectorAll('.card').forEach((card, index) => {
            const plan = offer.plans[index]
            if (!plan) return
            const price = card.querySelector('[data-plan-price]')
            const periodLabel = card.querySelector('[data-plan-period]')
            const alternative = card.querySelector('[data-plan-alternative]')
            if (price) {
              price.textContent = money.format(period === 'annual' ? plan.annualFee : plan.monthlyFee)
            }
            if (periodLabel) {
              periodLabel.textContent =
                period === 'annual'
                  ? calculator.dataset.periodAnnual || ''
                  : calculator.dataset.periodMonthly || ''
            }
            if (alternative instanceof HTMLElement) {
              alternative.textContent =
                period === 'annual' ? alternative.dataset.monthly || '' : alternative.dataset.annual || ''
            }
          })
        }
      }

      countInput?.addEventListener('input', update)
      calculator.querySelectorAll('input[type="radio"]').forEach((input) => {
        input.addEventListener('change', update)
      })
      update()
    })
  }
</script>

<style>
  .chooser {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .chooser-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-subtle);
  }
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .types a {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    font-weight: 600;
    font-size: var(--text-sm);
    transition:
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .types a:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .types a[aria-current='true'] {
    border-color: transparent;
    background: var(--accent);
    color: var(--on-accent);
  }
  .panel {
    display: none;
  }
  .panel.is-open {
    display: block;
  }
  .panel[hidden] {
    display: none;
  }
  .panel__intro {
    margin: 0 0 1.25rem;
    max-width: 44rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .plans-carousel {
    position: relative;
    display: grid;
    gap: 0.85rem;
    max-width: 26rem;
    margin-inline: auto;
  }
  .plans {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0.15rem 2.5rem 0.35rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .plans::-webkit-scrollbar {
    display: none;
  }
  .plans > article {
    flex: 0 0 calc(100% - 0.5rem);
    scroll-snap-align: center;
  }
  .plans-nav {
    position: absolute;
    top: calc(50% - 1.4rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .plans-nav--prev {
    left: 0.15rem;
  }
  .plans-nav--next {
    right: 0.15rem;
  }
  .plans-nav:hover {
    border-color: var(--line-strong);
    background: var(--surface-muted);
  }
  .plans-nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .plans-dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
  }
  .plans-dots button {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    transition:
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .plans-dots button[aria-selected='true'] {
    background: var(--accent);
    transform: scale(1.2);
  }
  .plans-dots button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Desktop: all three plans side by side — carousel is mobile-only. */
  @media (min-width: 900px) {
    .plans-carousel {
      max-width: none;
      margin-inline: 0;
    }
    .plans {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
      overflow: visible;
      scroll-snap-type: none;
      padding: 0;
    }
    .plans > article {
      flex: unset;
      width: auto;
      min-width: 0;
      scroll-snap-align: unset;
    }
    .plans-nav,
    .plans-dots {
      display: none;
    }
  }
  article {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  article:not(.is-expanded) [data-feature-extra] {
    display: none;
