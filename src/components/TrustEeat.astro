---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import ProductShot from '@/components/ProductShot.astro'
import { localePath } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const e = messages.eeat
---

<section class="section" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{e.eyebrow}</p>
      <h2 id="trust-title" class="type-section">
        {e.title} <span class="accent">{e.titleAccent}</span>
      </h2>
      <p class="lead">{e.intro}</p>
    </div>
    <ul class="grid">
      {
        e.items.map((item) => (
          <li>
            <article>
              <h3 class="type-card-title">{item.title}</h3>
              <p>{item.desc}</p>
              <a href={localePath(locale, item.href)}>{item.linkLabel}{messages.common.linkArrow}</a>
            </article>
          </li>
        ))
      }
    </ul>
    <div class="audit">
      <p class="audit__intro">{e.auditIntro}</p>
      <ProductShot locale={locale} messages={messages} id="audit" />
    </div>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  article {
    height: 100%;
    padding: 1.2rem 1.15rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  p {
    margin: 0;
    color: var(--ink-muted);
    flex: 1;
    font-size: var(--text-sm);
  }
  a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: var(--text-sm);
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .audit {
    margin-top: 2rem;
  }
  .audit__intro {
    margin: 0 0 1rem;
    color: var(--ink-muted);
    font-size: var(--text-md);
    max-width: 42rem;
  }
</style>
