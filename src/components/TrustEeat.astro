---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import LinkCard from '@/components/LinkCard.astro'
import { localePath } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const e = messages.eeat
---

<section class="section eeat reveal-on-scroll" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{e.eyebrow}</p>
      <h2 id="trust-title" class="type-section">
        {e.title} <span class="accent">{e.titleAccent}</span>
      </h2>
      <p class="lead">{e.intro}</p>
    </div>
    <ul class="card-grid eeat__grid">
      {
        e.items.map((item) => (
          <li>
            <LinkCard href={localePath(locale, item.href)} title={item.title} desc={item.desc} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mobile: stack tight; avoid three tall cards eating the fold. */
  .eeat :global(.lead) {
    max-width: 36rem;
  }
  @media (max-width: 759px) {
    .eeat__grid {
      gap: 0.65rem;
    }
    .eeat :global(.lead) {
      font-size: var(--text-sm);
    }
    .eeat :global(.card-link) {
      padding: 0.85rem 1rem;
    }
    .eeat :global(.card-link p) {
      font-size: var(--text-sm);
    }
  }
</style>
