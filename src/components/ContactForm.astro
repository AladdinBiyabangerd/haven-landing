---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { formatPhone } from '@/lib/format'
import { SITE, telUrl, whatsappUrl } from '@/lib/site'

interface Props {
  messages: Messages
  locale: Locale
}
const { messages, locale } = Astro.props
const c = messages.contact
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact/'
const waHref = whatsappUrl(c.whatsappPrefill)
const phoneDisplay = formatPhone(SITE.contactPhone)
---

<div class="contact-wrap">
  <div class="quick-channels">
    <a class="quick quick--mail" href={`mailto:${SITE.contactEmail}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      <span class="quick__text">
        <span class="quick__label">{c.emailWrite}</span>
        <span class="quick__detail">{SITE.contactEmail}</span>
      </span>
    </a>
    <a class="quick quick--wa" href={waHref} target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        ></path>
      </svg>
      <span class="quick__text">
        <span class="quick__label">{c.whatsapp}</span>
        <span class="quick__detail">{phoneDisplay}</span>
      </span>
    </a>
  </div>

<form
  class="form"
  data-contact-form
  data-endpoint={endpoint}
  data-locale={locale}
  data-success={c.success}
  data-error={c.error}
  data-sending={c.sending}
  novalidate
>
  <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="row">
    <label>
      <span>{c.name}</span>
      <input name="name" type="text" autocomplete="name" required maxlength="120" />
    </label>
    <label>
      <span>{c.email}</span>
      <input name="email" type="email" autocomplete="email" required maxlength="200" />
    </label>
  </div>
  <label>
    <span>{c.venue}</span>
    <input name="venue" type="text" autocomplete="organization" maxlength="200" />
  </label>
  <label>
    <span>{c.message}</span>
    <textarea name="message" rows="5" required maxlength="5000"></textarea>
  </label>
  <button class="btn btn-primary" type="submit" data-submit>{c.submit}</button>
  <p class="status" data-status hidden></p>
  <p class="alt">
    {c.alt}
  </p>
  <ul class="channels">
    <li>
      <a href={`mailto:${SITE.contactEmail}`}>{c.emailWrite} · {SITE.contactEmail}</a>
    </li>
    <li>
      <a href={waHref} target="_blank" rel="noopener noreferrer">{c.whatsapp} · {phoneDisplay}</a>
    </li>
    <li>
      <a href={telUrl()}>{phoneDisplay}</a>
    </li>
  </ul>
</form>
</div>

<script>
  const form = document.querySelector('[data-contact-form]')
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-status]')
    const submit = form.querySelector('[data-submit]')
    let endpoint = form.dataset.endpoint || '/api/contact/'
    if (endpoint && !endpoint.endsWith('/')) endpoint = `${endpoint}/`
    const locale = form.dataset.locale || 'az'
    const successMsg = form.dataset.success || ''
    const errorMsg = form.dataset.error || ''
    const sendingMsg = form.dataset.sending || ''

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return

      const data = new FormData(form)
      const payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        venue: String(data.get('venue') || ''),
        message: String(data.get('message') || ''),
        company: String(data.get('company') || ''),
        locale,
      }

      status.hidden = false
      status.textContent = sendingMsg
      status.dataset.state = 'pending'
      submit.disabled = true

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        if (!res.ok) throw new Error('fail')
        const body = await res.json().catch(() => null)
        if (!body || body.ok !== true) throw new Error('fail')
        status.textContent = successMsg
        status.dataset.state = 'ok'
        form.reset()
      } catch {
        status.textContent = errorMsg
        status.dataset.state = 'err'
      } finally {
        submit.disabled = false
      }
    })
  }
</script>

<style>
  .contact-wrap {
    display: grid;
    gap: 1.25rem;
  }
  .quick-channels {
    display: grid;
    gap: 0.75rem;
  }
  .quick {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    max-width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1.15rem;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-family: var(--font-body);
    line-height: 1.2;
    transition:
      transform 0.25s var(--ease),
      background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .quick:hover {
    transform: translateY(-1px);
  }
  .quick:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .quick svg {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }
  .quick__text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .quick__label {
    font-size: var(--text-md);
    font-weight: 700;
  }
  .quick__detail {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    word-break: break-all;
  }
  .quick--wa {
    border-color: rgba(37, 211, 102, 0.35);
    background: rgba(37, 211, 102, 0.08);
    color: #128c7e;
  }
  .quick--wa:hover {
    background: rgba(37, 211, 102, 0.14);
    border-color: rgba(37, 211, 102, 0.5);
  }
  .quick--mail {
    color: var(--ink);
  }
  .quick--mail:hover {
    border-color: var(--accent);
    background: rgba(45, 212, 191, 0.06);
  }
  .form {
    display: grid;
    gap: 0.9rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .row {
    display: grid;
    gap: 0.9rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label span {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }
  input,
  textarea {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    padding: 0.85rem 0.95rem;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid rgba(45, 212, 191, 0.45);
    outline-offset: 1px;
  }
  .status {
    margin: 0;
    font-weight: 600;
  }
  .status[data-state='ok'] {
    color: var(--accent);
  }
  .status[data-state='err'] {
    color: var(--danger);
  }
  .alt {
    margin: 0.25rem 0 0;
    color: var(--ink-subtle);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .channels {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .channels a {
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
