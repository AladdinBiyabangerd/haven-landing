---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { formatPhone } from '@/lib/format'
import { SITE, telUrl, whatsappUrl } from '@/lib/site'
import { VENUE_STORAGE_KEY } from '@/lib/venueOffers'

interface Props {
  messages: Messages
  locale: Locale
}
const { messages, locale } = Astro.props
const c = messages.contact
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact/'
const waHref = whatsappUrl(c.whatsappPrefill)
const phoneDisplay = formatPhone(SITE.contactPhone)
---

<p class="wa-lead">
  <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-typed>{c.waLead}</a>
</p>

<form
  class="form"
  data-contact-form
  data-endpoint={endpoint}
  data-locale={locale}
  data-success={c.success}
  data-error={c.error}
  data-sending={c.sending}
  data-submit-default={c.submit}
  data-submit-custom={c.customSubmit}
  data-phone-or-email={c.phoneOrEmailHint}
  data-venue-storage={VENUE_STORAGE_KEY}
  data-plan-confirm-tpl={c.planConfirm}
  data-plan-names={JSON.stringify({ ...messages.pricing.planNames, custom: messages.pricing.custom.name })}
  novalidate
>
  <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="intent" value="demo" data-intent />
  <input type="hidden" name="plan" value="" data-plan />
  <p class="custom-notice" data-custom-notice hidden>{c.customNotice}</p>
  <p class="plan-chip" data-plan-confirm hidden></p>
  <div class="row">
    <label>
      <span>{c.name}</span>
      <input name="name" type="text" autocomplete="name" required maxlength="120" />
    </label>
    <label>
      <span>{c.phone}</span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" data-phone />
    </label>
  </div>
  <div class="row">
    <label>
      <span>{c.email}</span>
      <input name="email" type="email" autocomplete="email" maxlength="200" data-email />
    </label>
    <label>
      <span>{c.venueType}</span>
      <select name="venueType" data-venue-type>
        <option value="">{c.venueTypePlaceholder}</option>
        {c.venueTypes.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </label>
  </div>
  <p class="hint" data-contact-hint>{c.phoneOrEmailHint}</p>
  <label>
    <span>{c.venue}</span>
    <input name="venue" type="text" autocomplete="organization" maxlength="200" />
  </label>
  <fieldset class="criteria">
    <legend class="criteria__hint">{c.criteriaHint}</legend>
    <div class="row row--3">
      <label>
        <span>{c.venuesCount}</span>
        <input name="venuesCount" type="number" inputmode="numeric" min="1" max="99999" step="1" data-custom-required />
      </label>
      <label>
        <span>{c.staffCount}</span>
        <input name="staffCount" type="number" inputmode="numeric" min="1" max="99999" step="1" data-custom-required />
      </label>
      <label>
        <span>{c.reservationsPerMonth}</span>
        <input name="reservationsPerMonth" type="number" inputmode="numeric" min="1" max="99999" step="1" data-custom-required />
      </label>
    </div>
  </fieldset>
  <label>
    <span>{c.message}</span>
    <textarea name="message" rows="5" required maxlength="5000"></textarea>
  </label>
  <button class="btn btn-primary" type="submit" data-submit>{c.submit}</button>
  <p class="status" data-status hidden></p>
  <p class="alt">
    {c.alt}
  </p>
  <ul class="channels">
    <li>
      <a href={waHref} target="_blank" rel="noopener noreferrer" data-wa-typed>{c.whatsapp}</a>
    </li>
    <li>
      <a href={telUrl()}>{phoneDisplay}</a>
    </li>
    <li>
      <a href={`mailto:${SITE.contactEmail}`}>{c.emailWrite} · {SITE.contactEmail}</a>
    </li>
  </ul>
</form>

<script>
  const form = document.querySelector('[data-contact-form]')
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-status]')
    const submit = form.querySelector('[data-submit]')
    const hint = form.querySelector('[data-contact-hint]')
    const phoneInput = form.querySelector('[data-phone]')
    const emailInput = form.querySelector('[data-email]')
    let endpoint = form.dataset.endpoint || '/api/contact/'
    if (endpoint && !endpoint.endsWith('/')) endpoint = `${endpoint}/`
    const locale = form.dataset.locale || 'az'
    const successMsg = form.dataset.success || ''
    const errorMsg = form.dataset.error || ''
    const sendingMsg = form.dataset.sending || ''
    const phoneOrEmailMsg = form.dataset.phoneOrEmail || ''
    const params = new URLSearchParams(window.location.search)
    const planParam = params.get('plan') || ''
    const isCustom = planParam === 'custom'
    const typeSelect = form.querySelector('[data-venue-type]')
    const planInput = form.querySelector('[data-plan]')
    const planChip = form.querySelector('[data-plan-confirm]')
    let planNames: Record<string, string> = {}
    try {
      planNames = JSON.parse(form.dataset.planNames || '{}') as Record<string, string>
    } catch {
      planNames = {}
    }
    const planTpl = form.dataset.planConfirmTpl || '{plan} · {type}'
    if (planInput instanceof HTMLInputElement && (planParam === 'custom' || ['starter', 'plus', 'pro'].includes(planParam))) {
      planInput.value = planParam
    }
    let rememberedType = params.get('type') || ''
    if (!rememberedType) {
      try {
        rememberedType = sessionStorage.getItem(form.dataset.venueStorage || 'heselo.venueType') || ''
      } catch {
        rememberedType = ''
      }
    }
    if (typeSelect instanceof HTMLSelectElement && rememberedType) {
      const allowed = [...typeSelect.options].some((option) => option.value === rememberedType)
      if (allowed) typeSelect.value = rememberedType
    }

    function updatePlanChip() {
      if (!(planChip instanceof HTMLElement)) return
      const planLabel = planNames[planParam] || ''
      const typeLabel =
        typeSelect instanceof HTMLSelectElement
          ? typeSelect.options[typeSelect.selectedIndex]?.text || ''
          : ''
      const typeValue = typeSelect instanceof HTMLSelectElement ? typeSelect.value : ''
      if (!planLabel || !typeValue || !typeLabel) {
        planChip.hidden = true
        return
      }
      planChip.hidden = false
      planChip.textContent = planTpl.replace('{plan}', planLabel).replace('{type}', typeLabel)
    }
    updatePlanChip()
    if (typeSelect instanceof HTMLSelectElement) {
      typeSelect.addEventListener('change', updatePlanChip)
    }
    const intentInput = form.querySelector('[data-intent]')
    const customNotice = form.querySelector('[data-custom-notice]')
    const customFields = form.querySelectorAll('[data-custom-required]')
    const titleEl = document.querySelector('[data-contact-title]')
    const introEl = document.querySelector('[data-contact-intro]')

    if (isCustom) {
      if (intentInput instanceof HTMLInputElement) intentInput.value = 'custom'
      if (customNotice instanceof HTMLElement) customNotice.hidden = false
      customFields.forEach((field) => {
        if (field instanceof HTMLInputElement) field.required = true
      })
      if (submit instanceof HTMLButtonElement) {
        submit.textContent = form.dataset.submitCustom || submit.textContent
      }
      if (titleEl instanceof HTMLElement && titleEl.dataset.custom) {
        titleEl.textContent = titleEl.dataset.custom
      }
      if (introEl instanceof HTMLElement && introEl.dataset.custom) {
        introEl.textContent = introEl.dataset.custom
      }
    }

    function phoneDigits(value: string): string {
      return value.replace(/\D/g, '')
    }

    function phoneStatus(): 'empty' | 'ok' | 'invalid' {
      const phone = phoneInput instanceof HTMLInputElement ? phoneDigits(phoneInput.value) : ''
      if (!phone) return 'empty'
      if (phone.length < 9 || phone.length > 15) return 'invalid'
      return 'ok'
    }

    function hasContactChannel(): boolean {
      if (phoneStatus() === 'invalid') return false
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : ''
      const emailOk =
        email.length > 0 && emailInput instanceof HTMLInputElement && emailInput.checkValidity()
      return phoneStatus() === 'ok' || emailOk
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return
      if (isCustom && !form.reportValidity()) return
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }
      if (!hasContactChannel()) {
        status.hidden = false
        status.textContent = phoneOrEmailMsg
        status.dataset.state = 'err'
        if (hint instanceof HTMLElement) hint.dataset.state = 'err'
        if (phoneInput instanceof HTMLInputElement) phoneInput.focus()
        return
      }
      if (hint instanceof HTMLElement) delete hint.dataset.state

      const data = new FormData(form)
      const payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        phone: String(data.get('phone') || ''),
        venue: String(data.get('venue') || ''),
        venueType: String(data.get('venueType') || ''),
        message: String(data.get('message') || ''),
        company: String(data.get('company') || ''),
        intent: isCustom ? 'custom' : 'demo',
        plan: planParam === 'custom' || ['starter', 'plus', 'pro'].includes(planParam) ? planParam : '',
        venuesCount: String(data.get('venuesCount') || ''),
        staffCount: String(data.get('staffCount') || ''),
        reservationsPerMonth: String(data.get('reservationsPerMonth') || ''),
        locale,
      }

      status.hidden = false
      status.textContent = sendingMsg
      status.dataset.state = 'pending'
      submit.disabled = true

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        if (!res.ok) throw new Error('fail')
        const body = await res.json().catch(() => null)
        if (!body || body.ok !== true) throw new Error('fail')
        status.textContent = successMsg
        status.dataset.state = 'ok'
        form.reset()
      } catch {
        status.textContent = errorMsg
        status.dataset.state = 'err'
      } finally {
        submit.disabled = false
      }
    })
  }
</script>

<style>
  .wa-lead {
    margin: 0 0 1.15rem;
  }
  .wa-lead a {
    display: inline-block;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(37, 211, 102, 0.35);
    background: rgba(37, 211, 102, 0.1);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .wa-lead a:hover {
    background: rgba(37, 211, 102, 0.16);
  }
  .form {
    display: grid;
    gap: 0.9rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .custom-notice {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(15, 118, 110, 0.28);
    background: rgba(20, 184, 166, 0.1);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .plan-chip {
    margin: 0;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 118, 110, 0.28);
    background: rgba(20, 184, 166, 0.1);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    justify-self: start;
  }
  .hint {
    margin: -0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }
  .hint[data-state='err'] {
    color: var(--danger);
    font-weight: 600;
  }
  .criteria {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.55rem;
  }
  .criteria__hint {
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-subtle);
  }
  .row {
    display: grid;
    gap: 0.9rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label span {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    padding: 0.85rem 0.95rem;
  }
  select {
    appearance: auto;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid rgba(45, 212, 191, 0.45);
    outline-offset: 1px;
  }
  .status {
    margin: 0;
    font-weight: 600;
  }
  .status[data-state='ok'] {
    color: var(--accent);
  }
  .status[data-state='err'] {
    color: var(--danger);
  }
  .alt {
    margin: 0.25rem 0 0;
    color: var(--ink-subtle);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .channels {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .channels a {
    color: var(--accent);
    font-weight: 600;
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
    .row--3 {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
