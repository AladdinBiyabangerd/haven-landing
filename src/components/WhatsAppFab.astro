---
import type { Messages } from '@/i18n/types'
import { whatsappUrl } from '@/lib/site'

interface Props {
  messages: Messages
}

const { messages } = Astro.props
const c = messages.contact
const waHref = whatsappUrl(c.whatsappPrefill)
---

<div class="contact-fab">
  <a
    class="contact-fab__btn"
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={c.whatsappAria}
    data-wa-typed
    data-track-placement="fab"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
    <span class="contact-fab__label">{c.whatsapp}</span>
  </a>
</div>

<style>
  .contact-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right, 0px));
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    z-index: 40;
  }
  .contact-fab__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.65rem 0.85rem 0.65rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.35);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .contact-fab__btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 32px rgba(37, 211, 102, 0.42);
  }
  .contact-fab__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .contact-fab__btn svg {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }
  /* No clamp: every locale's label is a short phrase and reads worse cut off. */
  .contact-fab__label {
    white-space: nowrap;
  }
  @media (max-width: 899px) {
    .contact-fab__btn {
      min-height: 3.25rem;
      min-width: 3.25rem;
      padding: 0.75rem;
      justify-content: center;
    }
    .contact-fab__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
