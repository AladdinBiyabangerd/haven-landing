---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const p = messages.pillars
---

<section class="section" aria-labelledby="product-proof-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 id="product-proof-title" class="type-section">
        {p.title} <span class="accent">{p.titleAccent}</span>
      </h2>
      <p class="lead">{p.intro}</p>
    </div>
    <ul class="proof">
      {
        p.items.map((item) => (
          <li class="proof__row">
            <h3 class="type-card-title">{item.title}</h3>
            <p>{item.desc}</p>
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a class="link-inline" href={localePath(locale, '/features')}>
        {p.featuresLink}{messages.common.linkArrow}
      </a>
    </p>
  </div>
</section>

<style>
  .proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }
  .proof__row {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .proof__row:first-child {
    padding-top: 0;
    border-top: none;
  }
  .proof__row p {
    margin: 0.3rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: 36rem;
  }
  .all {
    margin: 1.25rem 0 0;
  }
  @media (max-width: 759px) {
    .section-head :global(.type-section) {
      font-size: var(--text-xl);
    }
    .section-head .lead {
      display: none;
    }
    .proof {
      gap: 0.65rem;
    }
    .proof__row {
      padding-top: 0.65rem;
    }
    .proof__row :global(.type-card-title) {
      font-size: var(--text-md);
    }
    .proof__row p {
      font-size: var(--text-xs);
    }
  }
  @media (min-width: 800px) {
    .proof {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .proof__row {
      padding-top: 0;
      border-top: none;
    }
  }
</style>
