---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const p = messages.pillars
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 class="type-section">{p.title} <span class="accent">{p.titleAccent}</span></h2>
      <p class="lead">{p.intro}</p>
    </div>
    <div class="card-grid">
      {
        p.items.map((item) => (
          <article class="card">
            <h3 class="type-card-title">{item.title}</h3>
            <p>{item.desc}</p>
            <ul class="tag-list">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  p {
    margin: 0.4rem 0 0.85rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
