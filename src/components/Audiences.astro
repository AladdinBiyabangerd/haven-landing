---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import LinkCard from '@/components/LinkCard.astro'
import { localePath } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const a = messages.audiences
---

<section class="section" id="solutions" aria-labelledby="audiences-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{a.eyebrow}</p>
      <h2 id="audiences-title" class="type-section">
        {a.title} <span class="accent">{a.titleAccent}</span>
      </h2>
      <p class="lead">{a.intro}</p>
    </div>
    <ul class="card-grid">
      {
        a.items.map((item) => (
          <li>
            <LinkCard
              href={localePath(locale, `/solutions/${item.slug}`)}
              title={item.title}
              desc={item.desc}
            />
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a class="link-inline" href={localePath(locale, '/solutions')}>
        {messages.nav.solutions}{messages.common.linkArrow}
      </a>
    </p>
  </div>
</section>

<style>
  .all {
    margin: 1.25rem 0 0;
  }
</style>
