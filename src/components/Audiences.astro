---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const a = messages.audiences
---

<section class="section" id="solutions" aria-labelledby="audiences-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{a.eyebrow}</p>
      <h2 id="audiences-title" class="type-section">
        {a.title} <span class="accent">{a.titleAccent}</span>
      </h2>
      <p class="lead">{a.intro}</p>
    </div>
    <ul class="grid">
      {
        a.items.map((item) => (
          <li>
            <article>
              <h3 class="type-card-title">{item.title}</h3>
              <p>{item.desc}</p>
              <a href={localePath(locale, `/solutions/${item.slug}`)}>{item.anchor}</a>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a href={localePath(locale, '/solutions')}>{messages.nav.solutions}{messages.common.linkArrow}</a>
    </p>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  article {
    height: 100%;
    padding: 1.25rem 1.2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  p {
    margin: 0;
    color: var(--ink-muted);
    flex: 1;
  }
  a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--accent-deep);
  }
  .all {
    margin: 1.5rem 0 0;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
