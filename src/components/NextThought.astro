---
import type { JourneyLinkKind } from '@/lib/journey'

export type NextThoughtDoor = {
  prompt: string
  href: string
  label: string
  bind?: JourneyLinkKind
}

interface Props {
  doors: NextThoughtDoor[]
  label: string
  arrow: string
}

const { doors, label, arrow } = Astro.props
---

{
  doors.length > 0 ? (
    <nav class="next-thought" aria-label={label}>
      <div class="container">
        <ul>
          {doors.map((door) => (
            <li>
              <a href={door.href} data-journey-link={door.bind}>
                <span class="prompt">{door.prompt}</span>
                <span class="go">
                  {door.label}
                  {arrow}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  ) : null
}

<style>
  .next-thought {
    padding: 0.25rem 0 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .prompt {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .go {
    font-weight: 600;
    color: var(--accent);
    font-size: var(--text-sm);
  }
  a:hover .go {
    color: var(--accent-deep);
  }
  @media (min-width: 720px) {
    ul {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 0 1.5rem;
    }
    li:last-child a {
      border-bottom: 0;
    }
    li:nth-child(-n + 2) a {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
