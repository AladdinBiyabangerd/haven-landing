---
import type { JourneyLinkKind } from '@/lib/journey'

export type NextThoughtDoor = {
  prompt: string
  href: string
  label: string
  bind?: JourneyLinkKind
}

interface Props {
  doors: NextThoughtDoor[]
  label: string
  embedded?: boolean
}

const { doors, label, embedded = false } = Astro.props
---

{
  doors.length > 0 ? (
    <nav class:list={['next-thought', { embedded }]} aria-label={label}>
      <div class={embedded ? undefined : 'container'}>
        {doors.map((door) => (
          <p>
            {door.prompt}{' '}
            <a href={door.href} data-journey-link={door.bind}>
              {door.label}
            </a>
            .
          </p>
        ))}
      </div>
    </nav>
  ) : null
}

<style>
  .next-thought {
    padding: 0.15rem 0 1.6rem;
  }
  .embedded {
    padding: 1.1rem 0 0;
  }
  p {
    margin: 0.45rem 0 0;
    max-width: 40rem;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: var(--lh-body);
  }
  p:first-child {
    margin-top: 0;
  }
  a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    color: var(--accent-deep);
  }
</style>
