---
import type { Messages } from '@/i18n/types'
interface Props {
  messages: Messages
}
const { messages } = Astro.props
const p = messages.pain
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 class="type-section">{p.title} <span class="accent">{p.titleAccent}</span></h2>
      <p class="lead">{p.intro}</p>
    </div>
    <div class="compare">
      <article class="card">
        <h3 class="type-card-title">{p.withoutLabel}</h3>
        <ul>
          {p.before.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card good">
        <h3 class="type-card-title">{p.withLabel}</h3>
        <ul>
          {p.after.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .compare {
    display: grid;
    gap: var(--gap);
  }
  article.good {
    border-color: rgba(15, 118, 110, 0.28);
  }
  h3 {
    margin-bottom: 0.85rem;
    font-size: var(--text-lg);
    color: var(--ink-subtle);
  }
  article.good h3 {
    color: var(--accent);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-subtle);
  }
  .good li::before {
    content: '+';
    color: var(--accent);
  }
  @media (min-width: 800px) {
    .compare {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
