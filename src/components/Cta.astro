---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'
import { contactPath, pricingPath, whatsappHrefFor } from '@/lib/journey'
import { VENUE_STORAGE_KEY } from '@/lib/venueOffers'

interface Props {
  locale: Locale
  messages: Messages
  venueType?: string
  /** demo: WhatsApp + contact. next: type first, then price / demo. */
  intent?: 'demo' | 'next'
}

const { locale, messages, venueType = '', intent = 'demo' } = Astro.props
const c = messages.cta
const j = messages.journey
const known = venueType
const contactHref = contactPath(locale, known || undefined)
const pricingHref = pricingPath(locale, known || undefined)
const solutionsHref = localePath(locale, '/solutions')
const waHref = whatsappHrefFor(messages, known || undefined)

const title = known ? c.typedTitle : c.title
const subtitle =
  intent === 'next'
    ? known
      ? j.priceForType.prompt
      : c.pickTypeSubtitle
    : known
      ? c.typedSubtitle
      : c.subtitle

const primaryHref = intent === 'next' ? (known ? pricingHref : solutionsHref) : waHref
const primaryLabel =
  intent === 'next' ? (known ? j.priceForType.label : c.pickTypeButton) : c.whatsapp
const secondaryHref = intent === 'next' ? (known ? contactHref : waHref) : contactHref
const secondaryLabel = intent === 'next' ? (known ? c.nextForm : c.nextWhatsapp) : c.button
const primaryExternal = intent === 'demo'
const secondaryExternal = intent === 'next' && !known
---

<section
  class:list={['section', { 'cta-next': intent === 'next' }]}
  data-cta
  data-cta-intent={intent}
  data-cta-type={known}
  data-storage-key={VENUE_STORAGE_KEY}
>
  <div class="container">
    {
      intent === 'next' ? (
        <div class="prose">
          <p>
            <span data-cta-sub>{subtitle}</span>{' '}
            <a data-cta-primary href={primaryHref}>
              {primaryLabel}
            </a>
            .
          </p>
          <p>
            <a
              data-cta-secondary
              href={secondaryHref}
              target={secondaryExternal ? '_blank' : undefined}
              rel={secondaryExternal ? 'noopener noreferrer' : undefined}
            >
              {secondaryLabel}
            </a>
            .
          </p>
        </div>
      ) : (
        <div class="banner">
          <div>
            <h2 class="type-section" data-cta-title>
              {title}
            </h2>
            <p class="type-lead" data-cta-sub>
              {subtitle}
            </p>
          </div>
          <div class="actions">
            <a
              class="btn btn-primary"
              data-cta-primary
              href={primaryHref}
              target={primaryExternal ? '_blank' : undefined}
              rel={primaryExternal ? 'noopener noreferrer' : undefined}
            >
              {primaryLabel}
            </a>
            <a class="btn btn-ghost" data-cta-secondary href={secondaryHref}>
              {secondaryLabel}
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<script is:inline define:vars={{
    storageKey: VENUE_STORAGE_KEY,
    intent,
    known,
    copy: {
      title: c.title,
      subtitle: c.subtitle,
      button: c.button,
      whatsapp: c.whatsapp,
      pickTypeSubtitle: c.pickTypeSubtitle,
      pickTypeButton: c.pickTypeButton,
      typedTitle: c.typedTitle,
      typedSubtitle: c.typedSubtitle,
      pricePrompt: j.priceForType.prompt,
      priceLabel: j.priceForType.label,
      nextForm: c.nextForm,
      nextWhatsapp: c.nextWhatsapp,
    },
    paths: {
      contact: localePath(locale, '/contact'),
      pricing: localePath(locale, '/pricing'),
      solutions: localePath(locale, '/solutions'),
    },
    prefills: {
      default: messages.contact.whatsappPrefill,
      ...messages.contact.whatsappPrefills,
    },
    waBase: whatsappHrefFor(messages).split('?')[0],
  }}>
  ;(function () {
    const root = document.querySelector('[data-cta]')
    if (!(root instanceof HTMLElement) || known) return
    const valid = new Set(['gaming', 'karaoke', 'billiards', 'antikafe', 'lounge'])
    function readType() {
      try {
        const stored = sessionStorage.getItem(storageKey) || ''
        return valid.has(stored) ? stored : ''
      } catch {
        return ''
      }
    }
    function waHref(type) {
      const text = (type && prefills[type]) || prefills.default || ''
      return text ? waBase + '?text=' + encodeURIComponent(text) : waBase
    }
    function setLink(el, href, external) {
      if (!(el instanceof HTMLAnchorElement)) return
      el.href = href
      if (external) {
        el.target = '_blank'
        el.rel = 'noopener noreferrer'
      } else {
        el.removeAttribute('target')
        el.removeAttribute('rel')
      }
    }
    function apply(type) {
      const titleEl = root.querySelector('[data-cta-title]')
      const subEl = root.querySelector('[data-cta-sub]')
      const primary = root.querySelector('[data-cta-primary]')
      const secondary = root.querySelector('[data-cta-secondary]')
      if (intent === 'next') {
        if (type) {
          if (subEl) subEl.textContent = copy.pricePrompt
          if (primary) primary.textContent = copy.priceLabel
          if (secondary) secondary.textContent = copy.nextForm
          setLink(primary, paths.pricing + '#' + type, false)
          setLink(secondary, paths.contact + '?type=' + encodeURIComponent(type), false)
        } else {
          if (subEl) subEl.textContent = copy.pickTypeSubtitle
          if (primary) primary.textContent = copy.pickTypeButton
          if (secondary) secondary.textContent = copy.nextWhatsapp
          setLink(primary, paths.solutions, false)
          setLink(secondary, waHref(''), true)
        }
      } else if (type) {
        if (titleEl) titleEl.textContent = copy.typedTitle
        if (subEl) subEl.textContent = copy.typedSubtitle
        setLink(primary, waHref(type), true)
        setLink(secondary, paths.contact + '?type=' + encodeURIComponent(type), false)
      }
    }
    apply(readType())
  })()
</script>

<style>
  .prose p {
    margin: 0.45rem 0 0;
    max-width: 40rem;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: var(--lh-body);
  }
  .prose p:first-child {
    margin-top: 0;
  }
  .prose a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .prose a:hover {
    color: var(--accent-deep);
  }
  .banner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: calc(var(--radius-lg) + 4px);
    border: 1px solid rgba(15, 118, 110, 0.22);
    background:
      radial-gradient(600px 200px at 10% 0%, rgba(20, 184, 166, 0.18), transparent 55%),
      linear-gradient(135deg, #ffffff, #e8f7f4);
    box-shadow: var(--shadow);
  }
  h2 {
    max-width: 18ch;
  }
  .banner p {
    margin: 0.65rem 0 0;
    color: var(--ink-muted);
    max-width: 36rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  @media (min-width: 800px) {
    .banner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
