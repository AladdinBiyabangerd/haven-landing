---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { FOUNDER, founderPortfolioUrl, localePath, SITE, telUrl, whatsappUrl } from '@/lib/site'
import { formatPhone } from '@/lib/format'
import { FOOTER_SOLUTION_SLUGS, getSolutionsBySlugs } from '@/data/solutions'
import BrandMark from '@/components/BrandMark.astro'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const year = new Date().getFullYear()

const footerSolutions = getSolutionsBySlugs(locale, FOOTER_SOLUTION_SLUGS).map((item) => ({
  slug: item.slug,
  label: item.shortTitle,
}))

const phoneDisplay = formatPhone(SITE.contactPhone)
const waHref = whatsappUrl(messages.contact.whatsappPrefill)
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="brand" href={localePath(locale, '/')}>
        <BrandMark size={40} />
        <span class="type-brand">Heselo</span>
      </a>
      <p class="type-meta">{messages.footer.tagline}</p>
      <a class="mail" href={`mailto:${SITE.contactEmail}`}>
        {messages.contact.emailWrite} · {SITE.contactEmail}
      </a>
      <a class="mail" href={waHref} target="_blank" rel="noopener noreferrer" data-wa-typed>
        {messages.contact.whatsapp}
      </a>
      <a class="mail tel" href={telUrl()}>{phoneDisplay}</a>
    </div>
    <div>
      <h3 class="type-eyebrow">{messages.footer.product}</h3>
      <a href={localePath(locale, '/features')}>{messages.nav.features}</a>
      <a href={localePath(locale, '/pricing')}>{messages.nav.pricing}</a>
      <a href={localePath(locale, '/guides')}>{messages.nav.guides}</a>
      <a href={localePath(locale, '/about')}>{messages.footer.about}</a>
      <a href={localePath(locale, '/contact')}>{messages.nav.demo}</a>
    </div>
    <div class="footer__solutions">
      <h3 class="type-eyebrow">
        <a class="footer__hub" href={localePath(locale, '/solutions')}>{messages.footer.solutions}</a>
      </h3>
      <div class="footer__links">
        {
          footerSolutions.map((item) => (
            <a href={localePath(locale, `/solutions/${item.slug}`)}>{item.label}</a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="container footer__bottom">
    <span class="type-meta">© {year} Heselo. {messages.footer.rights}</span>
    <nav class="footer__legal" aria-label={messages.footer.legal}>
      <a href={localePath(locale, '/privacy')}>{messages.footer.privacy}</a>
      <a href={localePath(locale, '/terms')}>{messages.footer.terms}</a>
    </nav>
    <p class="footer__credit type-meta">
      {messages.footer.credit}{' '}
      <a href={founderPortfolioUrl(locale)} target="_blank" rel="noopener noreferrer">
        {FOUNDER.name}<span aria-hidden="true"> ↗</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    /* Extra bottom room so the floating button never sits on the last line. */
    padding: 3rem 0 4.5rem;
    background: rgba(255, 255, 255, 0.55);
  }
  .footer__grid {
    display: grid;
    gap: 2rem;
  }
  .footer__brand p {
    margin: 0.85rem 0;
    color: var(--ink-muted);
    max-width: 18rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .mail {
    display: block;
    color: var(--accent);
    font-weight: 600;
    margin-top: 0.35rem;
  }
  .mail:first-of-type {
    margin-top: 0;
  }
  h3.type-eyebrow {
    margin: 0 0 0.85rem;
    color: var(--ink-subtle);
  }
  /* The group heading is the hub link, so "Solutions" is not listed twice. */
  .footer__grid .footer__hub {
    display: inline;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
  .footer__grid .footer__hub:hover {
    color: var(--accent);
  }
  .footer__grid a {
    display: block;
    padding: 0.25rem 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .footer__grid a:hover {
    color: var(--ink);
  }
  /* Left-aligned: the floating WhatsApp button covers the bottom-right corner. */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-subtle);
  }
  .footer__legal {
    display: flex;
    gap: 1.25rem;
  }
  .footer__legal a {
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }
  .footer__legal a:hover {
    color: var(--ink);
  }
  .footer__credit {
    margin: 0;
  }
  .footer__credit a {
    color: var(--ink-muted);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }
  .footer__credit a:hover {
    color: var(--ink);
  }
  /* Eight short destinations pair up at every width rather than running as one long stack. */
  .footer__links {
    columns: 2;
    column-gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 1.35fr 1fr 1.6fr;
    }
  }
</style>
