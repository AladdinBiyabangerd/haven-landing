---
import type { Locale } from '@/i18n/config'
import { LOCALES, LOCALE_LABELS, HTML_LANG } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'
import BrandMark from '@/components/BrandMark.astro'

interface Props {
  locale: Locale
  messages: Messages
}

const { locale, messages } = Astro.props
const m = messages.nav
const pathAfterLocale = Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/'
const currentSlug = pathAfterLocale === '/' ? '/' : pathAfterLocale.replace(/\/$/, '') || '/'
const isSolutions =
  currentSlug === '/solutions' || currentSlug.startsWith('/solutions/')
const isGuides = currentSlug === '/guides' || currentSlug.startsWith('/guides/')

/**
 * Home lives on the brand mark and Contact lives on the demo button, so
 * neither gets a second entry here.
 */
const localeItems = LOCALES.map((loc) => ({
  code: loc.toUpperCase(),
  name: LOCALE_LABELS[loc],
  lang: HTML_LANG[loc],
  href: localePath(loc, currentSlug === '/' ? '/' : currentSlug),
  active: loc === locale,
}))

const links = [
  { href: localePath(locale, '/features'), label: m.features, match: '/features' },
  { href: localePath(locale, '/solutions'), label: m.solutions, match: '/solutions' },
  { href: localePath(locale, '/guides'), label: m.guides, match: '/guides' },
  { href: localePath(locale, '/pricing'), label: m.pricing, match: '/pricing' },
]
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href={localePath(locale, '/')} aria-label="Heselo">
      <BrandMark size={38} />
      <span class="brand__name type-brand">Heselo</span>
    </a>

    <nav class="nav" data-nav aria-label={m.primaryNav}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'nav__link',
              {
                'is-active':
                  link.match === '/solutions'
                    ? isSolutions
                    : link.match === '/guides'
                      ? isGuides
                      : currentSlug === link.match,
              },
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <div class="locales locales--bar" role="navigation" aria-label={m.languageNav}>
        {
          localeItems.map((item) => (
            <a
              class:list={['locale', { 'is-active': item.active }]}
              href={item.href}
              hreflang={item.lang}
              lang={item.lang}
              aria-current={item.active ? 'true' : undefined}
            >
              {item.code}
              <span class="sr-only">{item.name}</span>
            </a>
          ))
        }
      </div>
      <a class="btn btn-primary header__cta" href={localePath(locale, '/contact')} data-journey-link="contact">{m.demo}</a>
      <button
        class="menu-btn"
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={m.toggleMenu}
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-nav" data-mobile hidden>
    <div class="container mobile__inner">
      {links.map((link) => <a href={link.href} class="mobile__link">{link.label}</a>)}
      <a class="btn btn-primary btn-block" href={localePath(locale, '/contact')} data-journey-link="contact">{m.demo}</a>
      <div class="locales locales--menu" role="navigation" aria-label={m.languageNav}>
        {
          localeItems.map((item) => (
            <a
              class:list={['locale', { 'is-active': item.active }]}
              href={item.href}
              hreflang={item.lang}
              lang={item.lang}
              aria-current={item.active ? 'true' : undefined}
            >
              {item.code}
              <span class="sr-only">{item.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    background: rgba(247, 250, 252, 0.78);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .header.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(255, 255, 255, 0.9);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand__name {
    color: var(--ink);
  }
  .nav {
    display: none;
    margin-left: auto;
    gap: 0.25rem;
  }
  .nav__link {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 600;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: auto;
  }
  .locales {
    display: flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  /*
   * Language is a set-once choice; the menu button is used on every visit.
   * On a phone the switcher lives inside the menu so the bar holds the brand
   * and one control instead of three competing ones.
   */
  .locales--bar {
    display: none;
  }
  .locales--menu {
    margin-top: 1rem;
    justify-self: start;
  }
  .locale {
    min-width: 2.2rem;
    text-align: center;
    padding: 0.3rem 0.4rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-subtle);
  }
  .locale.is-active {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .header__cta {
    display: none;
    min-height: 2.6rem;
    padding: 0.55rem 1.1rem;
    font-size: var(--text-sm);
  }
  .menu-btn {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    display: grid;
    place-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 1rem;
    height: 2px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }
  .menu-btn[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .mobile {
    border-top: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.98);
    padding: 1rem 0 1.4rem;
  }
  .mobile__inner {
    display: grid;
    gap: 0.15rem;
  }
  .mobile__link {
    padding: 0.8rem 0.2rem;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 600;
  }
  .mobile__inner .btn {
    margin-top: 0.75rem;
  }
  @media (min-width: 960px) {
    .nav {
      display: flex;
    }
    .nav__link {
      padding: 0.4rem 0.55rem;
      font-size: var(--text-sm);
    }
    .locales--bar {
      display: flex;
    }
    .header__cta {
      display: inline-flex;
      min-height: 2.4rem;
      padding: 0.45rem 0.95rem;
    }
    .header__actions {
      margin-left: 0;
      gap: 0.5rem;
    }
    .menu-btn,
    .mobile {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]')
  const btn = document.querySelector('[data-menu-btn]')
  const mobile = document.querySelector('[data-mobile]')

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true'
    btn.setAttribute('aria-expanded', String(!open))
    if (mobile instanceof HTMLElement) mobile.hidden = open
  })
</script>
