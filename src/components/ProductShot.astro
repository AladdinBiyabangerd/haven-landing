---
import type { Messages } from '@/i18n/types'
import type { Locale } from '@/i18n/config'
import { PRODUCT_SHOT_PATHS, productShotAlt, type ProductShotId } from '@/lib/productShots'
import CashMock from '@/components/CashMock.astro'
import SessionsMock from '@/components/SessionsMock.astro'
import ScheduleMock from '@/components/ScheduleMock.astro'
import InventoryMock from '@/components/InventoryMock.astro'
import ProductsMock from '@/components/ProductsMock.astro'
import RoomAnalyticsMock from '@/components/RoomAnalyticsMock.astro'
import AuditMock from '@/components/AuditMock.astro'

interface Props {
  messages: Messages
  locale: Locale
  id: ProductShotId
  priority?: boolean
  class?: string
}
const { messages, locale, id, priority = false, class: className = '' } = Astro.props

const useCashMock = id === 'cash'
const useSessionsMock = id === 'sessions'
const useScheduleMock = id === 'schedule'
const useInventoryMock = id === 'inventory'
const useProductsMock = id === 'products'
const useRoomAnalyticsMock = id === 'room-analytics'
const useAuditMock = id === 'audit'
const base = PRODUCT_SHOT_PATHS[id]
const alt = productShotAlt(messages, id)
/** Mobile-first sizes: hero shot is capped ~22rem on small screens. */
const sizes = priority
  ? '(max-width: 959px) 22rem, (max-width: 1120px) 45vw, 560px'
  : '(max-width: 759px) 100vw, 36rem'
/**
 * Responsive widths only on the LCP hero (live-floor). Dense UI screenshots
 * at 480w become illegible mush; gallery/solution shots stay at 1256/2512.
 */
const srcsetWebp = base
  ? priority
    ? `${base}-480w.webp 480w, ${base}-768w.webp 768w, ${base}.webp 1256w, ${base}@2x.webp 2512w`
    : `${base}.webp 1256w, ${base}@2x.webp 2512w`
  : ''
const srcsetPng = base
  ? priority
    ? `${base}-480w.png 480w, ${base}-768w.png 768w, ${base}.png 1256w, ${base}@2x.png 2512w`
    : `${base}.png 1256w, ${base}@2x.png 2512w`
  : ''
---

{
  useCashMock ? (
    <CashMock messages={messages} locale={locale} class={className} />
  ) : useSessionsMock ? (
    <SessionsMock messages={messages} locale={locale} class={className} />
  ) : useScheduleMock ? (
    <ScheduleMock messages={messages} class={className} />
  ) : useInventoryMock ? (
    <InventoryMock messages={messages} class={className} />
  ) : useProductsMock ? (
    <ProductsMock messages={messages} locale={locale} class={className} />
  ) : useRoomAnalyticsMock ? (
    <RoomAnalyticsMock messages={messages} locale={locale} class={className} />
  ) : useAuditMock ? (
    <AuditMock messages={messages} class={className} />
  ) : base ? (
    <figure class:list={['shot', className]}>
      <picture>
        <source srcset={srcsetWebp} sizes={sizes} type="image/webp" />
        <source srcset={srcsetPng} sizes={sizes} type="image/png" />
        <img
          src={`${base}.webp`}
          srcset={srcsetWebp}
          sizes={sizes}
          alt={alt}
          width="1256"
          height="788"
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </picture>
    </figure>
  ) : null
}

<style>
  .shot {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    aspect-ratio: 1256 / 788;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top left;
    background: var(--bg-soft);
  }
</style>
