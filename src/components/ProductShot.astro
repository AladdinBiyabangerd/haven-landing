---
import type { Messages } from '@/i18n/types'
import { PRODUCT_SHOT_PATHS, productShotAlt, type ProductShotId } from '@/lib/productShots'

interface Props {
  messages: Messages
  id: ProductShotId
  priority?: boolean
  class?: string
}
const { messages, id, priority = false, class: className = '' } = Astro.props

const base = PRODUCT_SHOT_PATHS[id]
const alt = productShotAlt(messages, id)
/** Mobile-first sizes: hero shot is capped ~22rem on small screens. */
const sizes = priority
  ? '(max-width: 959px) 22rem, (max-width: 1120px) 45vw, 560px'
  : '(max-width: 759px) 100vw, 36rem'
---

<figure class:list={['shot', className]}>
  <picture>
    <source
      srcset={`${base}.webp 1256w, ${base}@2x.webp 2512w`}
      sizes={sizes}
      type="image/webp"
    />
    <source
      srcset={`${base}.png 1256w, ${base}@2x.png 2512w`}
      sizes={sizes}
      type="image/png"
    />
    <img
      src={`${base}.webp`}
      srcset={`${base}.webp 1256w, ${base}@2x.webp 2512w`}
      sizes={sizes}
      alt={alt}
      width="1256"
      height="788"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </picture>
</figure>

<style>
  .shot {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    aspect-ratio: 1256 / 788;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top left;
    background: var(--bg-soft);
  }
</style>
