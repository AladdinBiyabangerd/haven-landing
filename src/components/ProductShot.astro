---
import type { Messages } from '@/i18n/types'
import { PRODUCT_SHOT_PATHS, productShotAlt, type ProductShotId } from '@/lib/productShots'

interface Props {
  messages: Messages
  id: ProductShotId
  priority?: boolean
  class?: string
}
const { messages, id, priority = false, class: className = '' } = Astro.props

const base = PRODUCT_SHOT_PATHS[id]
const alt = productShotAlt(messages, id)
---

<figure class:list={['shot', className]}>
  <picture>
    <source srcset={`${base}@2x.webp 2x, ${base}.webp 1x`} type="image/webp" />
    <img
      src={`${base}.png`}
      srcset={`${base}@2x.png 2x, ${base}.png 1x`}
      alt={alt}
      width="1256"
      height="788"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </picture>
</figure>

<style>
  .shot {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
