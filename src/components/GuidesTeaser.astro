---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import LinkCard from '@/components/LinkCard.astro'
import { TEASER_GUIDE_SLUGS, getGuides } from '@/data/guides'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const g = messages.guidesTeaser
const guides = getGuides(locale).filter((item) =>
  (TEASER_GUIDE_SLUGS as readonly string[]).includes(item.slug),
)
---

<section class="section" id="guides" aria-labelledby="guides-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{g.eyebrow}</p>
      <h2 id="guides-title" class="type-section">
        {g.title} <span class="accent">{g.titleAccent}</span>
      </h2>
      <p class="lead">{g.intro}</p>
    </div>
    <ul class="card-grid">
      {
        guides.map((item) => (
          <li>
            <LinkCard
              href={localePath(locale, `/guides/${item.slug}`)}
              title={item.h1}
              desc={truncateText(item.intro, 120, messages.common.truncatedEllipsis)}
            />
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a class="link-inline" href={localePath(locale, '/guides')}>
        {g.cta}{messages.common.linkArrow}
      </a>
    </p>
  </div>
</section>

<style>
  .all {
    margin: 1.25rem 0 0;
  }
</style>
