---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { getGuides } from '@/data/guides'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'

interface Props {
  locale: Locale
  messages: Messages
}
const { locale, messages } = Astro.props
const g = messages.guidesTeaser
const guides = getGuides(locale)
---

<section class="section" id="guides" aria-labelledby="guides-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{g.eyebrow}</p>
      <h2 id="guides-title" class="type-section">
        {g.title} <span class="accent">{g.titleAccent}</span>
      </h2>
      <p class="lead">{g.intro}</p>
    </div>
    <ul class="grid">
      {
        guides.map((item) => (
          <li>
            <article>
              <h3 class="type-card-title">{item.shortTitle}</h3>
              <p>{truncateText(item.intro, 140, messages.common.truncatedEllipsis)}</p>
              <a href={localePath(locale, `/guides/${item.slug}`)}>{item.h1}</a>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a href={localePath(locale, '/guides')}>{g.cta}{messages.common.linkArrow}</a>
    </p>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  article {
    height: 100%;
    padding: 1.2rem 1.15rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  p {
    margin: 0;
    color: var(--ink-muted);
    flex: 1;
    font-size: var(--text-sm);
  }
  a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: var(--text-sm);
  }
  .all {
    margin: 1.5rem 0 0;
  }
  .all a {
    font-size: var(--text-md);
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
