---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.liveFloorMock

/** Demo stations — names are proper nouns; status/time/amount illustrate the product.
 *  `startSeconds` resets on every page load; client tick only advances while the tab is open. */
const stations = [
  { name: 'VIP 1', status: 'active' as const, startSeconds: 1 * 3600 + 24 * 60, amount: '24.00 AZN' },
  { name: 'PS-3', status: 'active' as const, startSeconds: 47 * 60, amount: '12.00 AZN' },
  { name: 'Karaoke 2', status: 'active' as const, startSeconds: 2 * 3600 + 10 * 60, amount: '45.00 AZN' },
  { name: 'Bilyard 1', status: 'empty' as const },
  { name: 'VIP 2', status: 'empty' as const },
  { name: 'PS-5', status: 'active' as const, startSeconds: 18 * 60, amount: '8.00 AZN' },
]

/** HH:MM:SS so the live tick is visible every second. */
function formatHms(totalSeconds: number): string {
  const h = Math.floor(totalSeconds / 3600)
  const m = Math.floor((totalSeconds % 3600) / 60)
  const s = totalSeconds % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
---

<figure class:list={['lfm', className]} aria-label={m.ariaLabel}>
  <div class="lfm__panel">
    <header class="lfm__head">
      <div class="lfm__title-row">
        <p class="lfm__title">{m.title}</p>
        <p class="lfm__legend">
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--on" aria-hidden="true"></i>{m.legendActive}</span>
          <span class="lfm__leg-sep" aria-hidden="true">·</span>
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--off" aria-hidden="true"></i>{m.legendEmpty}</span>
        </p>
      </div>
      <BrandMark size={28} />
    </header>

    <ul class="lfm__grid">
      {
        stations.map((s) => (
          <li class:list={['lfm__card', s.status === 'active' && 'lfm__card--on']}>
            <div class="lfm__card-top">
              <span class="lfm__name">{s.name}</span>
              <span class:list={['lfm__badge', s.status === 'active' ? 'lfm__badge--on' : 'lfm__badge--off']}>
                {s.status === 'active' ? (
                  <>
                    <i class="lfm__pulse" aria-hidden="true" />
                    {m.badgeActive}
                  </>
                ) : (
                  m.badgeEmpty
                )}
              </span>
            </div>
            <div class="lfm__card-meta">
              {s.status === 'active' ? (
                <p class="lfm__meta-line">
                  <span class="lfm__time" data-start-seconds={s.startSeconds}>
                    {formatHms(s.startSeconds)}
                  </span>
                  <span class="lfm__meta-sep" aria-hidden="true">
                    ·
                  </span>
                  <span class="lfm__amount">{s.amount}</span>
                </p>
              ) : (
                <span class="lfm__dash">—</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="lfm__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .lfm {
    container-type: inline-size;
    container-name: lfm;
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .lfm__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .lfm__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .lfm__title-row {
    min-width: 0;
  }
  .lfm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .lfm__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin: 0.35rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
  .lfm__leg {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .lfm__leg-sep {
    color: var(--line);
  }
  .lfm__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .lfm__dot--on {
    background: var(--accent);
  }
  .lfm__dot--off {
    background: transparent;
    border: 1.5px solid #94a3b8;
    box-sizing: border-box;
  }
  .lfm__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 2 cols until the mock itself is wide enough — avoids 3 skinny cards in hero. */
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .lfm__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.6rem 0.65rem 0.55rem;
    background: #fff;
    border: 1px solid rgba(21, 32, 51, 0.08);
    border-radius: var(--radius);
  }
  .lfm__card--on {
    border-color: rgba(20, 184, 166, 0.35);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }
  .lfm__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.35rem;
  }
  .lfm__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.25;
    min-width: 0;
  }
  .lfm__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .lfm__badge--on {
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .lfm__badge--off {
    color: var(--ink-subtle);
    background: rgba(21, 32, 51, 0.04);
    border: 1px solid rgba(21, 32, 51, 0.08);
  }
  .lfm__pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    animation: lfm-pulse 2s ease-in-out infinite;
  }
  .lfm__card-meta {
    margin-top: auto;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(21, 32, 51, 0.06);
  }
  .lfm__meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.35rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.7rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }
  .lfm__time {
    font-weight: 600;
    color: var(--ink-muted);
  }
  .lfm__meta-sep {
    color: #cbd5e1;
  }
  .lfm__amount {
    font-weight: 700;
    color: var(--ink);
  }
  .lfm__dash {
    font-size: var(--text-sm);
    color: #94a3b8;
  }
  .lfm__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }
  @keyframes lfm-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  /* 3 columns only when the mock panel is wide enough for readable cards */
  @container lfm (min-width: 28rem) {
    .lfm__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .lfm__grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.6rem;
    }
    .lfm__title {
      font-size: var(--text-xl);
    }
    .lfm__hint {
      text-align: left;
    }
    .lfm__meta-line {
      font-size: var(--text-xs);
    }
  }
  @media (max-width: 359px) {
    .lfm__legend {
      display: none;
    }
  }
</style>

<script>
  function formatHms(totalSeconds: number): string {
    const h = Math.floor(totalSeconds / 3600)
    const m = Math.floor((totalSeconds % 3600) / 60)
    const s = totalSeconds % 60
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }

  declare global {
    interface Window {
      __heseloLfmTimer?: number
    }
  }

  function startLiveFloorTimers() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const nodes = document.querySelectorAll<HTMLElement>('.lfm__time[data-start-seconds]')
    if (!nodes.length) return

    // Always re-read data-start-seconds from HTML (SSR values) — never persist across refresh.
    if (window.__heseloLfmTimer) {
      window.clearInterval(window.__heseloLfmTimer)
      window.__heseloLfmTimer = undefined
    }

    const timers = Array.from(nodes).map((el) => {
      const seconds = Number(el.dataset.startSeconds) || 0
      el.textContent = formatHms(seconds)
      return { el, seconds }
    })

    window.__heseloLfmTimer = window.setInterval(() => {
      for (const t of timers) {
        t.seconds += 1
        t.el.textContent = formatHms(t.seconds)
      }
    }, 1000)
  }

  startLiveFloorTimers()
  document.addEventListener('astro:page-load', startLiveFloorTimers)
</script>
