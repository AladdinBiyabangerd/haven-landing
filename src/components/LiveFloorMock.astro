---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'
import { fillTemplate } from '@/lib/format'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.liveFloorMock

type Status = 'active' | 'empty' | 'overdue'
type TimerMode = 'elapsed' | 'remaining'

/** Demo stations — both active/empty/overdue DOM stay in the tree so scoped styles survive toggles. */
const stations: Array<{
  name: string
  status: Status
  timer: TimerMode
  seconds: number
  amount: string
}> = [
  { name: 'VIP 1', status: 'active', timer: 'elapsed', seconds: 1 * 3600 + 24 * 60, amount: '24.00 AZN' },
  { name: 'PS-3', status: 'active', timer: 'remaining', seconds: 1 * 60 + 45, amount: '12.00 AZN' },
  { name: 'Karaoke 2', status: 'active', timer: 'elapsed', seconds: 2 * 3600 + 10 * 60, amount: '45.00 AZN' },
  { name: 'Bilyard 1', status: 'empty', timer: 'elapsed', seconds: 12 * 60, amount: '10.00 AZN' },
  { name: 'VIP 2', status: 'empty', timer: 'elapsed', seconds: 35 * 60, amount: '24.00 AZN' },
  { name: 'PS-5', status: 'overdue', timer: 'elapsed', seconds: 8 * 60, amount: '18.00 AZN' },
]

/** Compact MM:SS under 1h for countdowns; else HH:MM:SS. */
function formatClock(totalSeconds: number, compact: boolean): string {
  const sec = Math.max(0, Math.floor(totalSeconds))
  const h = Math.floor(sec / 3600)
  const m = Math.floor((sec % 3600) / 60)
  const s = sec % 60
  if (compact && h === 0) {
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
---

<figure class:list={['lfm', className]} aria-label={m.ariaLabel}>
  <div class="lfm__panel">
    <header class="lfm__head">
      <div class="lfm__title-row">
        <p class="lfm__title">{m.title}</p>
        <p class="lfm__legend">
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--on" aria-hidden="true"></i>{m.legendActive}</span>
          <span class="lfm__leg-sep" aria-hidden="true">·</span>
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--off" aria-hidden="true"></i>{m.legendEmpty}</span>
          <span class="lfm__leg-sep" aria-hidden="true">·</span>
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--overdue" aria-hidden="true"></i>{m.legendOverdue}</span>
        </p>
      </div>
      <BrandMark size={28} />
    </header>

    <ul class="lfm__grid">
      {
        stations.map((s) => {
          const occupied = s.status !== 'empty'
          const isRemaining = s.timer === 'remaining'
          return (
            <li>
              <button
                type="button"
                class:list={[
                  'lfm__card',
                  s.status === 'active' && 'lfm__card--on',
                  s.status === 'overdue' && 'lfm__card--overdue',
                ]}
                data-status={s.status}
                data-timer={s.timer}
                aria-pressed={occupied ? 'true' : 'false'}
                aria-label={fillTemplate(m.toggleStation, { name: s.name })}
              >
                <div class="lfm__card-top">
                  <span class="lfm__name">{s.name}</span>
                  <span class="lfm__badge lfm__badge--on" data-lfm-badge-on hidden={s.status !== 'active'}>
                    <i class="lfm__pulse" aria-hidden="true" />
                    {m.badgeActive}
                  </span>
                  <span class="lfm__badge lfm__badge--off" data-lfm-badge-off hidden={s.status !== 'empty'}>
                    {m.badgeEmpty}
                  </span>
                  <span
                    class="lfm__badge lfm__badge--overdue"
                    data-lfm-badge-overdue
                    hidden={s.status !== 'overdue'}
                  >
                    <i class="lfm__pulse lfm__pulse--overdue" aria-hidden="true" />
                    {m.badgeOverdue}
                  </span>
                </div>
                <div class="lfm__card-meta">
                  <p class="lfm__meta-line" data-lfm-meta-active hidden={s.status !== 'active'}>
                    <span
                      class:list={['lfm__time', isRemaining && 'lfm__time--remain']}
                      data-seconds={s.seconds}
                      data-lfm-tick={s.status === 'active' ? '1' : '0'}
                      data-timer={s.timer}
                    >
                      {formatClock(s.seconds, isRemaining)}
                    </span>
                    {
                      isRemaining ? (
                        <span class="lfm__remain">{m.remainingLabel}</span>
                      ) : (
                        <>
                          <span class="lfm__meta-sep" aria-hidden="true">
                            ·
                          </span>
                          <span class="lfm__amount">{s.amount}</span>
                        </>
                      )
                    }
                  </p>
                  <p class="lfm__meta-line lfm__meta-line--overdue" data-lfm-meta-overdue hidden={s.status !== 'overdue'}>
                    <span
                      class="lfm__time lfm__time--overdue"
                      data-seconds={s.seconds}
                      data-lfm-tick={s.status === 'overdue' ? '1' : '0'}
                      data-timer="elapsed"
                    >
                      {formatClock(s.seconds, false)}
                    </span>
                    <span class="lfm__meta-sep" aria-hidden="true">
                      ·
                    </span>
                    <span class="lfm__amount">{s.amount}</span>
                  </p>
                  <span class="lfm__dash" data-lfm-meta-empty hidden={s.status !== 'empty'}>
                    —
                  </span>
                </div>
              </button>
            </li>
          )
        })
      }
    </ul>

    <p class="lfm__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .lfm {
    container-type: inline-size;
    container-name: lfm;
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
  }
  .lfm__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .lfm__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .lfm__title-row {
    min-width: 0;
    flex: 1;
  }
  .lfm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .lfm__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin: 0.35rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
  .lfm__leg {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .lfm__leg-sep {
    color: var(--line);
  }
  .lfm__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .lfm__dot--on {
    background: var(--accent);
  }
  .lfm__dot--off {
    background: transparent;
    border: 1.5px solid #94a3b8;
    box-sizing: border-box;
  }
  .lfm__dot--overdue {
    background: #dc2626;
  }
  .lfm__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    min-width: 0;
  }
  .lfm__grid > li {
    min-width: 0;
    display: flex;
  }
  .lfm__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.6rem 0.65rem 0.55rem;
    background: #fff;
    border: 1px solid rgba(21, 32, 51, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    appearance: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.12s ease;
  }
  .lfm__card:hover {
    border-color: rgba(20, 184, 166, 0.4);
  }
  .lfm__card--overdue:hover {
    border-color: rgba(220, 38, 38, 0.45);
  }
  .lfm__card:active {
    transform: scale(0.98);
  }
  .lfm__card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lfm__card--overdue:focus-visible {
    outline-color: #dc2626;
  }
  .lfm__card--on {
    border-color: rgba(20, 184, 166, 0.35);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }
  .lfm__card--overdue {
    border-color: rgba(220, 38, 38, 0.4);
    box-shadow: inset 0 2px 0 0 #dc2626;
    background: linear-gradient(165deg, #fff 55%, #fef2f2);
  }
  .lfm__card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.3rem;
    min-width: 0;
  }
  .lfm__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.25;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lfm__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .lfm__badge[hidden],
  .lfm__meta-line[hidden],
  .lfm__dash[hidden] {
    display: none;
  }
  .lfm__badge--on {
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .lfm__badge--off {
    color: var(--ink-subtle);
    background: rgba(21, 32, 51, 0.04);
    border: 1px solid rgba(21, 32, 51, 0.08);
  }
  .lfm__badge--overdue {
    color: #b91c1c;
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.35);
  }
  .lfm__pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    animation: lfm-pulse 2s ease-in-out infinite;
  }
  .lfm__pulse--overdue {
    background: #dc2626;
    animation: lfm-pulse-overdue 1.1s ease-in-out infinite;
  }
  .lfm__card-meta {
    margin-top: auto;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(21, 32, 51, 0.06);
  }
  .lfm__meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.3rem;
    margin: 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 0.7rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }
  .lfm__time {
    font-weight: 600;
    color: var(--ink-muted);
  }
  .lfm__time--remain {
    color: var(--accent-deep);
    font-weight: 700;
  }
  .lfm__time--overdue {
    color: #b91c1c;
    font-weight: 700;
  }
  .lfm__remain {
    font-weight: 600;
    color: var(--accent-deep);
  }
  .lfm__meta-sep {
    color: #cbd5e1;
  }
  .lfm__amount {
    font-weight: 700;
    color: var(--ink);
  }
  .lfm__dash {
    font-size: var(--text-sm);
    color: #94a3b8;
  }
  .lfm__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }
  @keyframes lfm-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @keyframes lfm-pulse-overdue {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.25;
      transform: scale(0.85);
    }
  }
  @container lfm (max-width: 22rem) {
    .lfm__panel {
      padding: 0.7rem 0.65rem 0.65rem;
      gap: 0.55rem;
    }
    .lfm__grid {
      gap: 0.4rem;
    }
    .lfm__card {
      padding: 0.5rem 0.5rem 0.45rem;
      gap: 0.4rem;
    }
    .lfm__title {
      font-size: var(--text-md);
    }
    .lfm__name {
      font-size: 0.75rem;
    }
    .lfm__badge {
      padding: 0.1rem 0.35rem;
      font-size: 0.6rem;
    }
    .lfm__meta-line {
      font-size: 0.625rem;
    }
    .lfm__legend {
      display: none;
    }
  }
  @container lfm (min-width: 28rem) {
    .lfm__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .lfm__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .lfm__title {
      font-size: var(--text-xl);
    }
    .lfm__hint {
      text-align: left;
    }
    .lfm__meta-line {
      font-size: var(--text-xs);
    }
  }
</style>

<script>
  type Status = 'active' | 'empty' | 'overdue'

  function formatClock(totalSeconds: number, compact: boolean): string {
    const sec = Math.max(0, Math.floor(totalSeconds))
    const h = Math.floor(sec / 3600)
    const m = Math.floor((sec % 3600) / 60)
    const s = sec % 60
    if (compact && h === 0) {
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
    }
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }

  declare global {
    interface Window {
      __heseloLfmTimer?: number
    }
  }

  function syncOverdueClock(card: HTMLButtonElement, seconds: number) {
    const overdueTime = card.querySelector<HTMLElement>('[data-lfm-meta-overdue] [data-seconds]')
    if (!overdueTime) return
    overdueTime.dataset.seconds = String(seconds)
    overdueTime.dataset.timer = 'elapsed'
    overdueTime.textContent = formatClock(seconds, false)
  }

  function setCardStatus(card: HTMLButtonElement, status: Status) {
    const prev = (card.dataset.status as Status) || 'empty'
    card.dataset.status = status
    card.setAttribute('aria-pressed', status === 'empty' ? 'false' : 'true')
    card.classList.toggle('lfm__card--on', status === 'active')
    card.classList.toggle('lfm__card--overdue', status === 'overdue')

    const badgeOn = card.querySelector<HTMLElement>('[data-lfm-badge-on]')
    const badgeOff = card.querySelector<HTMLElement>('[data-lfm-badge-off]')
    const badgeOverdue = card.querySelector<HTMLElement>('[data-lfm-badge-overdue]')
    const metaActive = card.querySelector<HTMLElement>('[data-lfm-meta-active]')
    const metaOverdue = card.querySelector<HTMLElement>('[data-lfm-meta-overdue]')
    const metaEmpty = card.querySelector<HTMLElement>('[data-lfm-meta-empty]')
    const activeTime = card.querySelector<HTMLElement>('[data-lfm-meta-active] [data-seconds]')

    if (status === 'overdue' && prev !== 'overdue' && activeTime) {
      const fromRemaining = activeTime.dataset.timer === 'remaining'
      const sec = fromRemaining ? 0 : Number(activeTime.dataset.seconds) || 0
      syncOverdueClock(card, sec)
    }

    if (badgeOn) badgeOn.hidden = status !== 'active'
    if (badgeOff) badgeOff.hidden = status !== 'empty'
    if (badgeOverdue) badgeOverdue.hidden = status !== 'overdue'
    if (metaActive) metaActive.hidden = status !== 'active'
    if (metaOverdue) metaOverdue.hidden = status !== 'overdue'
    if (metaEmpty) metaEmpty.hidden = status !== 'empty'

    for (const time of card.querySelectorAll<HTMLElement>('[data-seconds]')) {
      const inActive = Boolean(time.closest('[data-lfm-meta-active]'))
      const inOverdue = Boolean(time.closest('[data-lfm-meta-overdue]'))
      const ticking =
        (status === 'active' && inActive) || (status === 'overdue' && inOverdue)
      time.dataset.lfmTick = ticking ? '1' : '0'
    }
  }

  function nextStatus(current: Status): Status {
    if (current === 'empty') return 'active'
    if (current === 'active') return 'overdue'
    return 'empty'
  }

  function startLiveFloorTimers() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (window.__heseloLfmTimer) {
        window.clearInterval(window.__heseloLfmTimer)
        window.__heseloLfmTimer = undefined
      }
      return
    }

    const nodes = document.querySelectorAll<HTMLElement>('.lfm [data-seconds]')
    if (window.__heseloLfmTimer) {
      window.clearInterval(window.__heseloLfmTimer)
      window.__heseloLfmTimer = undefined
    }
    if (!nodes.length) return

    for (const el of nodes) {
      const seconds = Number(el.dataset.seconds) || 0
      el.textContent = formatClock(seconds, el.dataset.timer === 'remaining')
    }

    window.__heseloLfmTimer = window.setInterval(() => {
      for (const el of document.querySelectorAll<HTMLElement>('.lfm [data-seconds]')) {
        if (!el.isConnected || el.dataset.lfmTick !== '1') continue
        const remaining = el.dataset.timer === 'remaining'
        let seconds = Number(el.dataset.seconds) || 0
        if (remaining) {
          if (seconds <= 0) {
            const card = el.closest<HTMLButtonElement>('.lfm__card')
            if (card && card.dataset.status === 'active') setCardStatus(card, 'overdue')
            continue
          }
          seconds -= 1
        } else {
          seconds += 1
        }
        el.dataset.seconds = String(seconds)
        el.textContent = formatClock(seconds, remaining)
      }
    }, 1000)
  }

  function bindLiveFloorCards() {
    for (const root of document.querySelectorAll<HTMLElement>('.lfm')) {
      if (root.dataset.mockToggleBound === '1') continue
      root.dataset.mockToggleBound = '1'

      root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null
        const card = target?.closest<HTMLButtonElement>('.lfm__card')
        if (!card || !root.contains(card)) return
        const current = (card.dataset.status as Status) || 'empty'
        setCardStatus(card, nextStatus(current))
        card.blur()
      })
    }
  }

  function bootLiveFloor() {
    bindLiveFloorCards()
    startLiveFloorTimers()
  }

  bootLiveFloor()
  document.addEventListener('astro:page-load', bootLiveFloor)
</script>
