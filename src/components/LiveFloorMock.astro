---
import type { Messages } from '@/i18n/types'
import BrandMark from '@/components/BrandMark.astro'
import { fillTemplate } from '@/lib/format'

interface Props {
  messages: Messages
  class?: string
}

const { messages, class: className = '' } = Astro.props
const m = messages.liveFloorMock

/** Demo stations — names are proper nouns; status/time/amount illustrate the product.
 *  Both active/empty DOM stay in the tree so Astro-scoped styles survive toggles.
 *  `startSeconds` resets on every page load; client tick only advances while open. */
const stations = [
  { name: 'VIP 1', status: 'active' as const, startSeconds: 1 * 3600 + 24 * 60, amount: '24.00 AZN' },
  { name: 'PS-3', status: 'active' as const, startSeconds: 47 * 60, amount: '12.00 AZN' },
  { name: 'Karaoke 2', status: 'active' as const, startSeconds: 2 * 3600 + 10 * 60, amount: '45.00 AZN' },
  { name: 'Bilyard 1', status: 'empty' as const, startSeconds: 12 * 60, amount: '10.00 AZN' },
  { name: 'VIP 2', status: 'empty' as const, startSeconds: 35 * 60, amount: '24.00 AZN' },
  { name: 'PS-5', status: 'active' as const, startSeconds: 18 * 60, amount: '8.00 AZN' },
]

/** HH:MM:SS so the live tick is visible every second. */
function formatHms(totalSeconds: number): string {
  const h = Math.floor(totalSeconds / 3600)
  const m = Math.floor((totalSeconds % 3600) / 60)
  const s = totalSeconds % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
---

<figure class:list={['lfm', className]} aria-label={m.ariaLabel}>
  <div class="lfm__panel">
    <header class="lfm__head">
      <div class="lfm__title-row">
        <p class="lfm__title">{m.title}</p>
        <p class="lfm__legend">
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--on" aria-hidden="true"></i>{m.legendActive}</span>
          <span class="lfm__leg-sep" aria-hidden="true">·</span>
          <span class="lfm__leg"><i class="lfm__dot lfm__dot--off" aria-hidden="true"></i>{m.legendEmpty}</span>
        </p>
      </div>
      <BrandMark size={28} />
    </header>

    <ul class="lfm__grid">
      {
        stations.map((s) => {
          const active = s.status === 'active'
          return (
            <li>
              <button
                type="button"
                class:list={['lfm__card', active && 'lfm__card--on']}
                data-active={active ? 'true' : 'false'}
                aria-pressed={active ? 'true' : 'false'}
                aria-label={fillTemplate(m.toggleStation, { name: s.name })}
              >
                <div class="lfm__card-top">
                  <span class="lfm__name">{s.name}</span>
                  <span class:list={['lfm__badge', 'lfm__badge--on']} data-lfm-badge-on hidden={!active}>
                    <i class="lfm__pulse" aria-hidden="true" />
                    {m.badgeActive}
                  </span>
                  <span class:list={['lfm__badge', 'lfm__badge--off']} data-lfm-badge-off hidden={active}>
                    {m.badgeEmpty}
                  </span>
                </div>
                <div class="lfm__card-meta">
                  <p class="lfm__meta-line" data-lfm-meta-on hidden={!active}>
                    <span class="lfm__time" data-start-seconds={s.startSeconds} data-lfm-tick={active ? '1' : '0'}>
                      {formatHms(s.startSeconds)}
                    </span>
                    <span class="lfm__meta-sep" aria-hidden="true">
                      ·
                    </span>
                    <span class="lfm__amount">{s.amount}</span>
                  </p>
                  <span class="lfm__dash" data-lfm-meta-off hidden={active}>
                    —
                  </span>
                </div>
              </button>
            </li>
          )
        })
      }
    </ul>

    <p class="lfm__hint">{m.hint}</p>
  </div>
</figure>

<style>
  .lfm {
    container-type: inline-size;
    container-name: lfm;
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
  }
  .lfm__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0.85rem 0.8rem;
    background: linear-gradient(165deg, #eef3f6 0%, #e4ecf1 100%);
    box-sizing: border-box;
  }
  .lfm__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .lfm__title-row {
    min-width: 0;
    flex: 1;
  }
  .lfm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .lfm__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin: 0.35rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }
  .lfm__leg {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .lfm__leg-sep {
    color: var(--line);
  }
  .lfm__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .lfm__dot--on {
    background: var(--accent);
  }
  .lfm__dot--off {
    background: transparent;
    border: 1.5px solid #94a3b8;
    box-sizing: border-box;
  }
  .lfm__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* minmax(0,1fr) — default 1fr keeps min-content and overflows the hero on mobile. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    min-width: 0;
  }
  .lfm__grid > li {
    min-width: 0;
    display: flex;
  }
  .lfm__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.6rem 0.65rem 0.55rem;
    background: #fff;
    border: 1px solid rgba(21, 32, 51, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    appearance: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.12s ease;
  }
  .lfm__card:hover {
    border-color: rgba(20, 184, 166, 0.4);
  }
  .lfm__card:active {
    transform: scale(0.98);
  }
  .lfm__card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lfm__card--on {
    border-color: rgba(20, 184, 166, 0.35);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }
  .lfm__card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.3rem;
    min-width: 0;
  }
  .lfm__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.25;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lfm__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.2;
  }
  /* `display` on badges/meta beats the UA [hidden] rule — keep toggles invisible. */
  .lfm__badge[hidden],
  .lfm__meta-line[hidden],
  .lfm__dash[hidden] {
    display: none;
  }
  .lfm__badge--on {
    color: var(--accent-deep);
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.28);
  }
  .lfm__badge--off {
    color: var(--ink-subtle);
    background: rgba(21, 32, 51, 0.04);
    border: 1px solid rgba(21, 32, 51, 0.08);
  }
  .lfm__pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    animation: lfm-pulse 2s ease-in-out infinite;
  }
  .lfm__card-meta {
    margin-top: auto;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(21, 32, 51, 0.06);
  }
  .lfm__meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.3rem;
    margin: 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 0.7rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }
  .lfm__time {
    font-weight: 600;
    color: var(--ink-muted);
  }
  .lfm__meta-sep {
    color: #cbd5e1;
  }
  .lfm__amount {
    font-weight: 700;
    color: var(--ink);
  }
  .lfm__dash {
    font-size: var(--text-sm);
    color: #94a3b8;
  }
  .lfm__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    text-align: center;
  }
  @keyframes lfm-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  /* Narrow mobile: tighter cards so 2 cols fit inside the hero gutter. */
  @container lfm (max-width: 22rem) {
    .lfm__panel {
      padding: 0.7rem 0.65rem 0.65rem;
      gap: 0.55rem;
    }
    .lfm__grid {
      gap: 0.4rem;
    }
    .lfm__card {
      padding: 0.5rem 0.5rem 0.45rem;
      gap: 0.4rem;
    }
    .lfm__title {
      font-size: var(--text-md);
    }
    .lfm__name {
      font-size: 0.75rem;
    }
    .lfm__badge {
      padding: 0.1rem 0.35rem;
      font-size: 0.6rem;
    }
    .lfm__meta-line {
      font-size: 0.625rem;
    }
    .lfm__legend {
      display: none;
    }
  }
  /* 3 columns only when the mock panel is wide enough for readable cards */
  @container lfm (min-width: 28rem) {
    .lfm__panel {
      padding: 1.1rem 1.15rem 1rem;
      gap: 0.85rem;
    }
    .lfm__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .lfm__title {
      font-size: var(--text-xl);
    }
    .lfm__hint {
      text-align: left;
    }
    .lfm__meta-line {
      font-size: var(--text-xs);
    }
  }
</style>

<script>
  function formatHms(totalSeconds: number): string {
    const h = Math.floor(totalSeconds / 3600)
    const m = Math.floor((totalSeconds % 3600) / 60)
    const s = totalSeconds % 60
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
  }

  declare global {
    interface Window {
      __heseloLfmTimer?: number
    }
  }

  function setCardActive(card: HTMLButtonElement, active: boolean) {
    card.dataset.active = active ? 'true' : 'false'
    card.setAttribute('aria-pressed', active ? 'true' : 'false')
    card.classList.toggle('lfm__card--on', active)

    const badgeOn = card.querySelector<HTMLElement>('[data-lfm-badge-on]')
    const badgeOff = card.querySelector<HTMLElement>('[data-lfm-badge-off]')
    const metaOn = card.querySelector<HTMLElement>('[data-lfm-meta-on]')
    const metaOff = card.querySelector<HTMLElement>('[data-lfm-meta-off]')
    const time = card.querySelector<HTMLElement>('.lfm__time')

    if (badgeOn) badgeOn.hidden = !active
    if (badgeOff) badgeOff.hidden = active
    if (metaOn) metaOn.hidden = !active
    if (metaOff) metaOff.hidden = active
    if (time) time.dataset.lfmTick = active ? '1' : '0'
  }

  function startLiveFloorTimers() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (window.__heseloLfmTimer) {
        window.clearInterval(window.__heseloLfmTimer)
        window.__heseloLfmTimer = undefined
      }
      return
    }

    const nodes = document.querySelectorAll<HTMLElement>('.lfm__time[data-start-seconds]')
    if (window.__heseloLfmTimer) {
      window.clearInterval(window.__heseloLfmTimer)
      window.__heseloLfmTimer = undefined
    }
    if (!nodes.length) return

    const timers = Array.from(nodes).map((el) => {
      const seconds = Number(el.dataset.startSeconds) || 0
      el.textContent = formatHms(seconds)
      return { el, seconds }
    })

    window.__heseloLfmTimer = window.setInterval(() => {
      for (const t of timers) {
        if (!t.el.isConnected || t.el.dataset.lfmTick !== '1') continue
        t.seconds += 1
        t.el.dataset.startSeconds = String(t.seconds)
        t.el.textContent = formatHms(t.seconds)
      }
    }, 1000)
  }

  function bindLiveFloorCards() {
    for (const root of document.querySelectorAll<HTMLElement>('.lfm')) {
      if (root.dataset.mockToggleBound === '1') continue
      root.dataset.mockToggleBound = '1'

      root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null
        const card = target?.closest<HTMLButtonElement>('.lfm__card')
        if (!card || !root.contains(card)) return
        setCardActive(card, card.dataset.active !== 'true')
        // Keep demo focus ring off after mouse toggle.
        card.blur()
      })
    }
  }

  function bootLiveFloor() {
    bindLiveFloorCards()
    startLiveFloorTimers()
  }

  bootLiveFloor()
  document.addEventListener('astro:page-load', bootLiveFloor)
</script>
