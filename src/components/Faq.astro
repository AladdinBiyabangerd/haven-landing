---
import type { Locale } from '@/i18n/config'
import type { Messages } from '@/i18n/types'
import { localePath } from '@/lib/site'

interface Props {
  messages: Messages
  locale: Locale
  /** Section anchor id; override when several FAQ blocks share one page. */
  id?: string
  /** When set, only the first N items render (full list stays on /faq). */
  limit?: number
  /** Absolute-or-locale path for “all questions” when limit is used. */
  moreHref?: string
}
const { messages, locale, id = 'faq', limit, moreHref } = Astro.props
const f = messages.faq
const items = typeof limit === 'number' ? f.items.slice(0, limit) : f.items
const showMore = typeof limit === 'number' && f.items.length > limit && moreHref
---

<section class="section" id={id}>
  <div class="container">
    <div class="narrow">
      <div class="section-head">
        {f.eyebrow ? <p class="eyebrow">{f.eyebrow}</p> : null}
        <h2 class="type-section">{f.title}</h2>
      </div>
      <div class="list">
        {
          items.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.q}</summary>
              <p>
                {item.a}
                {item.href && item.linkLabel ? (
                  <>
                    {' '}
                    <a
                      class="link-inline"
                      href={localePath(locale, item.href)}
                      data-journey-link={item.href === '/contact' ? 'contact' : undefined}
                    >{item.linkLabel}</a>.
                  </>
                ) : null}
              </p>
            </details>
          ))
        }
      </div>
      {
        showMore ? (
          <p class="more">
            <a class="link-inline" href={moreHref}>
              {f.moreLabel}{messages.common.linkArrow}
            </a>
          </p>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  /* Rules, not boxes — a stack of bordered cards competes with the answers. */
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-snug);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.25rem;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(45deg) translate(-25%, -25%);
    transition: transform 0.2s var(--ease);
  }
  details[open] summary::after {
    transform: rotate(-135deg) translate(-25%, -25%);
  }
  summary:hover {
    color: var(--accent-deep);
  }
  p {
    margin: 0 0 1.1rem;
    max-width: 42rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .more {
    margin: 1.25rem 0 0;
  }
</style>
