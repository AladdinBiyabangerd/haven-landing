---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactForm from '@/components/ContactForm.astro'
import DemoPromise from '@/components/DemoPromise.astro'
import Faq from '@/components/Faq.astro'
import NextThought from '@/components/NextThought.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { SITE, localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const page = messages.contact

const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: page.faq,
  },
}
---

<BaseLayout locale={locale} messages={messages} page="contact">
  <section class="section">
    <div class="container contact">
      <div class="section-head">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1
          class="type-page-title"
          data-contact-title
          data-default={page.title}
          data-custom={page.customTitle}
        >
          {page.title}
        </h1>
        <p
          class="lead"
          data-contact-intro
          data-default={page.intro}
          data-custom={page.customIntro}
        >
          {page.intro}
        </p>
      </div>

      <section class="reach" aria-labelledby="contact-reach">
        <h2 id="contact-reach" class="type-card-title">{page.reachTitle}</h2>
        {page.reachBody.map((p) => <p class="reach__body">{p}</p>)}
        <p class="reach__email">
          <a class="link-inline" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
      </section>

      <DemoPromise messages={messages} />
      <ContactForm locale={locale} messages={messages} />
      <NextThought
        label={messages.journey.navLabel}
        embedded
        doors={[
          {
            prompt: messages.journey.seePricing.prompt,
            label: messages.journey.seePricing.label,
            href: localePath(locale, '/pricing'),
            bind: 'pricing',
          },
          {
            prompt: messages.journey.whichVenue.prompt,
            label: messages.journey.whichVenue.label,
            href: localePath(locale, '/solutions'),
            bind: 'solution',
          },
        ]}
      />
    </div>
  </section>

  <Faq locale={locale} messages={faqMessages} />
</BaseLayout>

<style>
  .contact {
    max-width: 720px;
  }
  .lead {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: 1.55;
  }
  .reach {
    margin: 2rem 0 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .reach .type-card-title {
    margin: 0;
  }
  .reach__body {
    margin: 0.85rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .reach__email {
    margin: 0.85rem 0 0;
    font-size: var(--text-sm);
  }
</style>
