---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Faq from '@/components/Faq.astro'
import NextThought from '@/components/NextThought.astro'
import CtaBanner from '@/components/CtaBanner.astro'
import { resolveLocale, LOCALES } from '@/i18n/config'
import { getMessages } from '@/i18n'
import {
  getGuide,
  getRelatedComparisonGuides,
  GUIDE_SLUGS,
  type GuideSlug,
} from '@/data/guides'
import { getSolution } from '@/data/solutions'
import { formatDate } from '@/lib/format'
import { localePath } from '@/lib/site'
import { contactPath, pricingPath } from '@/lib/journey'
import { isVenueOfferSlug, VENUE_STORAGE_KEY } from '@/lib/venueOffers'

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    GUIDE_SLUGS.map((slug) => ({
      params: { locale, slug },
    })),
  )
}

const locale = resolveLocale(Astro.params.locale)
const slug = String(Astro.params.slug || '')
const messages = getMessages(locale)
const guide = getGuide(locale, slug)

if (!guide) {
  return Astro.redirect(localePath(locale, '/guides'))
}

const related = guide.relatedSolutions
  .map((s) => getSolution(locale, s))
  .filter(Boolean)
const relatedComparisons = getRelatedComparisonGuides(locale, guide.slug as GuideSlug)
const persistVenueType = guide.relatedSolutions.find(isVenueOfferSlug) || ''

const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: guide.faq,
  },
}
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="guide"
  seo={{
    title: guide.seoTitle,
    description: guide.seoDescription,
    keywords: guide.keywords,
    slug: `/guides/${guide.slug}`,
    breadcrumbName: guide.shortTitle,
    faq: guide.faq,
    ogType: 'article',
    article: {
      headline: guide.h1,
      description: guide.seoDescription,
      datePublished: guide.datePublished,
      dateModified: guide.dateModified,
    },
  }}
>
  <article class="section">
    <div class="container">
      <div class="narrow">
      <header class="section-head">
        <p class="eyebrow">{messages.nav.guides}</p>
        <h1 class="type-page-title">{guide.h1}</h1>
        <p class="lead">{guide.intro}</p>
        <p class="meta type-meta">
          {messages.guidesPage.updatedLabel}{' '}
          <time datetime={guide.dateModified}>{formatDate(guide.dateModified, locale)}</time>
        </p>
      </header>

      {
        guide.sections.map((section) => (
          <section aria-labelledby={section.id}>
            <h2 id={section.id} class="sub">
              {section.title}
            </h2>
            {section.paragraphs.map((p) => (
              <p class="body">{p}</p>
            ))}
            {section.bullets ? (
              <ul class="bullets">
                {section.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            ) : null}
          </section>
        ))
      }

      {
        related.length > 0 ? (
          <nav class="related" aria-label={messages.nav.solutions}>
            <h2 class="sub">{messages.nav.solutions}</h2>
            <ul>
              {related.map((item) =>
                item ? (
                  <li>
                    <a class="link-inline" href={localePath(locale, `/solutions/${item.slug}`)}>{item.h1}</a>
                  </li>
                ) : null,
              )}
            </ul>
          </nav>
        ) : null
      }

      <nav class="related" aria-label={messages.nav.pricing}>
        <h2 class="sub">{messages.nav.pricing}</h2>
        <ul>
          <li>
            <a
              class="link-inline"
              href={pricingPath(locale, persistVenueType || undefined)}
              data-pricing-type={persistVenueType || undefined}
            >
              {messages.guidesPage.pricingCta}
            </a>
          </li>
          <li>
            <a class="link-inline" href={contactPath(locale, persistVenueType || undefined)}>
              {messages.guidesPage.demoCta}
            </a>
          </li>
        </ul>
      </nav>

      {
        relatedComparisons.length > 0 ? (
          <nav class="related" aria-label={messages.guidesPage.relatedComparisonsTitle}>
            <h2 class="sub">{messages.guidesPage.relatedComparisonsTitle}</h2>
            <ul>
              {relatedComparisons.map((item) => (
                <li>
                  <a class="link-inline" href={localePath(locale, `/guides/${item.slug}`)}>
                    {item.shortTitle}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }

      <p class="hub-back">
        <a class="link-inline" href={localePath(locale, '/guides')}>
          {messages.nav.guides}{messages.common.linkArrow}
        </a>
      </p>
      </div>
    </div>
  </article>

  {
    persistVenueType ? (
      <NextThought
        label={messages.journey.navLabel}
        doors={[
          {
            prompt: messages.journey.priceForType.prompt,
            label: messages.journey.priceForType.label,
            href: pricingPath(locale, persistVenueType),
            bind: 'pricing',
          },
        ]}
      />
    ) : null
  }

  <Faq locale={locale} messages={faqMessages} />

  <section class="section section-tight">
    <div class="container">
      <CtaBanner
        title={guide.ctaTitle}
        body={guide.ctaBody}
        href={contactPath(locale, persistVenueType || undefined)}
        label={messages.cta.button}
      />
    </div>
  </section>
  {
    persistVenueType ? (
      <script is:inline define:vars={{ persistVenueType, storageKey: VENUE_STORAGE_KEY }}>
        try {
          sessionStorage.setItem(storageKey, persistVenueType)
        } catch {
          /* ignore */
        }
      </script>
    ) : null
  }
</BaseLayout>

<style>
  .meta {
    margin: 0.5rem 0 0;
    color: var(--ink-subtle);
  }
  /* Sub-headings stay below the H1 so the page reads as one article. */
  .sub {
    font-size: var(--text-2xl);
  }
  section + section {
    margin-top: 2rem;
  }
  .body {
    margin: 0.6rem 0 0;
    color: var(--ink-muted);
  }
  .bullets {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-muted);
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .related ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .related ul {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
    }
  }
  .hub-back {
    margin: 1.5rem 0 0;
  }
</style>
