---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import { getGuide, getGuides, getGuidesHub, teaserGuideSlugs } from '@/data/guides'
import LinkCard from '@/components/LinkCard.astro'
import { applyCatalogPricesDeep } from '@/lib/catalogCopy'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'
import { loadVenueOffers } from '@/lib/venueOffers'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)
await loadVenueOffers()
const hub = applyCatalogPricesDeep(getGuidesHub(locale), locale)
const cardCta = `${hub.cardCta}${messages.common.linkArrow}`

const teaserSlugs = teaserGuideSlugs(locale)
const featured = applyCatalogPricesDeep(
  teaserSlugs.map((slug) => getGuide(locale, slug)).filter(
    (item): item is NonNullable<typeof item> => Boolean(item),
  ),
  locale,
)
const featuredSlugs = new Set<string>(teaserSlugs)
const more = applyCatalogPricesDeep(
  getGuides(locale).filter((item) => !featuredSlugs.has(item.slug)),
  locale,
)
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="guides"
  seo={{
    title: hub.seoTitle,
    description: hub.seoDescription,
    keywords: hub.keywords,
    slug: '/guides',
    breadcrumbName: messages.nav.guides,
  }}
>
  <section class="section guides-hub">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1 class="type-page-title">{hub.h1}</h1>
        <p class="lead">{hub.intro}</p>
      </header>

      <h2 class="group-title">{hub.featuredTitle}</h2>
      <ul class="card-grid">
        {
          featured.map((item) => (
            <li>
              <LinkCard
                as="h3"
                href={localePath(locale, `/guides/${item.slug}`)}
                title={item.shortTitle}
                desc={truncateText(item.intro, 90, messages.common.truncatedEllipsis)}
                cta={cardCta}
              />
            </li>
          ))
        }
      </ul>

      {
        more.length > 0 ? (
          <details class="more">
            <summary>
              {hub.moreTitle}
              <span class="more__count">({more.length})</span>
            </summary>
            <ul class="more__list">
              {more.map((item) => (
                <li>
                  <a href={localePath(locale, `/guides/${item.slug}`)}>{item.shortTitle}</a>
                </li>
              ))}
            </ul>
          </details>
        ) : null
      }

      <p class="solutions-link">
        <a class="link-inline" href={localePath(locale, '/solutions')}>
          {messages.nav.solutions}{messages.common.linkArrow}
        </a>
      </p>
    </div>
  </section>
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  .group-title {
    margin: 0 0 0.85rem;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink-subtle);
  }
  .more {
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .more summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::before {
    content: '+';
    color: var(--accent);
    font-weight: 700;
  }
  .more[open] summary::before {
    content: '−';
  }
  .more__count {
    color: var(--ink-subtle);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .more__list {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.15rem 1.25rem;
    columns: 1;
  }
  .more__list a {
    display: block;
    padding: 0.35rem 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }
  .more__list a:hover {
    color: var(--accent-deep);
  }
  .solutions-link {
    margin: 1.25rem 0 0;
  }
  @media (min-width: 640px) {
    .more__list {
      columns: 2;
    }
  }
  @media (max-width: 759px) {
    .guides-hub .section-head :global(.type-page-title) {
      font-size: var(--text-2xl);
    }
    .guides-hub .section-head .lead {
      font-size: var(--text-md);
    }
  }
</style>
