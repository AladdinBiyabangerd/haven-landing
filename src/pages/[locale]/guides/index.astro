---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { getComparisonGuides, getEducationalGuides, getGuidesHub } from '@/data/guides'
import LinkCard from '@/components/LinkCard.astro'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const hub = getGuidesHub(locale)
const educational = getEducationalGuides(locale)
const comparisons = getComparisonGuides(locale)
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="guides"
  seo={{
    title: hub.seoTitle,
    description: hub.seoDescription,
    keywords: hub.keywords,
    slug: '/guides',
    breadcrumbName: messages.nav.guides,
  }}
>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1 class="type-page-title">{hub.h1}</h1>
        <p class="lead">{hub.intro}</p>
      </header>
      <ul class="card-grid">
        {
          educational.map((item) => (
            <li>
              <LinkCard
                as="h2"
                href={localePath(locale, `/guides/${item.slug}`)}
                title={item.h1}
                desc={truncateText(item.intro, 160, messages.common.truncatedEllipsis)}
              />
            </li>
          ))
        }
      </ul>

      {
        hub.comparisonTitle && comparisons.length > 0 ? (
          <header class="section-head comparison-head">
            <h2 class="type-section">{hub.comparisonTitle}</h2>
            {hub.comparisonIntro ? <p class="lead">{hub.comparisonIntro}</p> : null}
          </header>
        ) : null
      }
      {
        comparisons.length > 0 ? (
          <ul class="card-grid">
            {comparisons.map((item) => (
              <li>
                <LinkCard
                  as="h3"
                  href={localePath(locale, `/guides/${item.slug}`)}
                  title={item.shortTitle}
                  desc={truncateText(item.intro, 140, messages.common.truncatedEllipsis)}
                />
              </li>
            ))}
          </ul>
        ) : null
      }

      <p class="solutions-link">
        <a class="link-inline" href={localePath(locale, '/solutions')}>
          {messages.nav.solutions}{messages.common.linkArrow}
        </a>
      </p>
    </div>
  </section>
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  .solutions-link {
    margin: 1.25rem 0 0;
  }
  .comparison-head {
    margin-top: 2.75rem;
  }
</style>
