---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import Faq from '@/components/Faq.astro'
import PricingOffers from '@/components/PricingOffers.astro'
import PricingSummary from '@/components/PricingSummary.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const page = messages.pricing
const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: page.faq,
  },
}
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="pricing"
  seo={{
    title: messages.seo.pages.pricing.title,
    description: messages.seo.pages.pricing.description,
    keywords: messages.seo.pages.pricing.keywords,
    slug: '/pricing',
    breadcrumbName: messages.nav.pricing,
    faq: page.faq,
  }}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="type-page-title">{page.title}</h1>
        <p class="lead">{page.intro}</p>
      </div>
      <PricingSummary locale={locale} messages={messages} />
      <PricingOffers locale={locale} messages={messages} />
    </div>
  </section>
  <Faq locale={locale} messages={faqMessages} />
  <Cta locale={locale} messages={messages} intent="demo" />
</BaseLayout>
