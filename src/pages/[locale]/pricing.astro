---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import Faq from '@/components/Faq.astro'
import PricingOffers from '@/components/PricingOffers.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const page = messages.pricing
const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: page.faq,
  },
}
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="pricing"
  seo={{
    title: messages.seo.pages.pricing.title,
    description: messages.seo.pages.pricing.description,
    keywords: messages.seo.pages.pricing.keywords,
    slug: '/pricing',
    breadcrumbName: messages.nav.pricing,
    faq: page.faq,
  }}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="type-page-title">{page.title}</h1>
        <p class="lead">{page.intro}</p>
      </div>
      <PricingOffers locale={locale} messages={messages} />
      <p class="note type-meta">{page.note}</p>
      <nav class="crosslinks" aria-label={messages.nav.primaryNav}>
        <a href={localePath(locale, '/features')}>{page.crosslinks.features}{messages.common.linkArrow}</a>
        <a href={localePath(locale, '/solutions')}>{page.crosslinks.solutions}{messages.common.linkArrow}</a>
        <a href={localePath(locale, '/contact')}>{page.crosslinks.contact}{messages.common.linkArrow}</a>
      </nav>
    </div>
  </section>
  <Faq messages={faqMessages} />
  <Cta locale={locale} messages={messages} />
</BaseLayout>

<style>
  .note {
    margin: 1.5rem 0 0;
    color: var(--ink-subtle);
  }
  .crosslinks {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .crosslinks a {
    font-weight: 600;
    color: var(--accent);
  }
</style>
