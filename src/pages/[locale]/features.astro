---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import NextThought from '@/components/NextThought.astro'
import LinkCard from '@/components/LinkCard.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import { getSolution } from '@/data/solutions'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)
const page = messages.featuresPage
---

<BaseLayout locale={locale} messages={messages} page="features">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="type-page-title">{page.title}</h1>
        <p class="lead">{page.intro}</p>
      </div>
      {
        page.body && page.body.length > 0 ? (
          <div class="features-prose">
            {page.body.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        ) : null
      }
      <ul class="card-grid">
        {
          page.modules.map((mod) => {
            const href = mod.solutionSlug
              ? localePath(locale, `/solutions/${mod.solutionSlug}`)
              : null
            const cta = mod.solutionSlug
              ? `${getSolution(locale, mod.solutionSlug)?.shortTitle ?? page.solutionLinkLabel}${messages.common.linkArrow}`
              : null
            const desc = mod.detail ? `${mod.desc} ${mod.detail}` : mod.desc
            return (
              <li>
                {href ? (
                  <LinkCard href={href} title={mod.title} desc={desc} cta={cta} as="h2" />
                ) : (
                  <article class="card">
                    <h2 class="type-card-title">{mod.title}</h2>
                    <p>{desc}</p>
                  </article>
                )}
              </li>
            )
          })
        }
      </ul>
    </div>
  </section>
  <NextThought
    label={messages.journey.navLabel}
    doors={[
      {
        prompt: messages.journey.seePricing.prompt,
        label: messages.journey.seePricing.label,
        href: localePath(locale, '/pricing'),
        bind: 'pricing',
      },
    ]}
  />
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  .features-prose {
    max-width: 40rem;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.85rem;
  }
  .features-prose p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  article {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }
  article p {
    margin: 0.4rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 759px) {
    .section-head :global(.type-page-title) {
      font-size: var(--text-2xl);
    }
  }
</style>
