---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProductGallery from '@/components/ProductGallery.astro'
import Cta from '@/components/Cta.astro'
import Audiences from '@/components/Audiences.astro'
import NextThought from '@/components/NextThought.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { getSolution } from '@/data/solutions'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const page = messages.featuresPage
---

<BaseLayout locale={locale} messages={messages} page="features">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="type-page-title">{page.title}</h1>
        <p class="lead">{page.intro}</p>
      </div>
      <div class="card-grid">
        {
          page.modules.map((mod) => (
            <article class="card">
              <h2 class="type-card-title">{mod.title}</h2>
              <p>{mod.desc}</p>
              <ul class="tag-list">
                {mod.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {
                mod.solutionSlug ? (
                  <a class="link-inline module-link" href={localePath(locale, `/solutions/${mod.solutionSlug}`)}>
                    {getSolution(locale, mod.solutionSlug)?.h1 ?? page.solutionLinkLabel}{messages.common.linkArrow}
                  </a>
                ) : null
              }
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <NextThought
    label={messages.journey.navLabel}
    doors={[
      {
        prompt: messages.journey.seePricing.prompt,
        label: messages.journey.seePricing.label,
        href: localePath(locale, '/pricing'),
        bind: 'pricing',
      },
    ]}
  />
  <ProductGallery messages={messages} />
  <Audiences locale={locale} messages={messages} />
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  p {
    margin: 0.4rem 0 0.85rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    flex: 1;
  }
  .module-link {
    margin-top: 0.85rem;
    font-size: var(--text-sm);
  }
</style>
