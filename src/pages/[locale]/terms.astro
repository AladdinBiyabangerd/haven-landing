---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LegalDocument from '@/components/LegalDocument.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { termsOfUseBlocks } from '@/content/termsOfUse'
import { formatDate as formatDateForLocale } from '@/lib/format'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const page = messages.terms
const blocks = termsOfUseBlocks[locale]

function formatDate(isoDate: string) {
  return formatDateForLocale(isoDate, locale)
}
---

<BaseLayout locale={locale} messages={messages} page="terms">
  <section class="section">
    <div class="container">
      <div class="narrow">
        <h1 class="type-page-title">{page.title}</h1>
        <p class="updated type-meta">{page.updated}</p>
        <LegalDocument blocks={blocks} formatDate={formatDate} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    margin: 0.5rem 0 1.5rem;
    color: var(--ink-subtle);
  }
</style>
