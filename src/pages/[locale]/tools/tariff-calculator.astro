---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)

type ToolSection = { id: string; title: string; paragraphs: string[] }

const copy =
  locale === 'ru'
    ? {
        title: 'Калькулятор тарифов PS-клуба | Heselo',
        description:
          'Оцените месячную выручку PS-клуба: число кабинок, цена часа и загрузка. Примерный расчёт на устройстве — не оферта и не цена подписки Heselo.',
        h1: 'Калькулятор тарифов клуба',
        lead:
          'Введите число кабинок, цену часа и загрузку. Считаем на устройстве — данные никуда не отправляются. Это модель выручки зала, а не прайс подписки Heselo.',
        booths: 'Число кабинок / станций',
        hourly: 'Цена часа',
        hours: 'Часов загрузки на кабинку в день',
        days: 'Рабочих дней в месяц',
        revenue: 'Ориентировочная выручка в месяц',
        cta: 'Запросить демо Heselo',
        note: 'Это модель выручки зала, не цена подписки Heselo. Контроллеры ТВ и онлайн-касса (ККТ) в расчёт не входят.',
        sections: [
          {
            id: 'formula',
            title: 'Что считает формула',
            paragraphs: [
              'Итог = число кабинок × цена часа × часов загрузки в день × рабочих дней в месяц. Так вы видите порядок выручки от продажи времени станций, без бара и без пакетов.',
              'Если часть дня идёт по ночному тарифу или пакетам «2 часа», подставьте среднюю эффективную цену часа — калькулятор не заменяет полный прайс-лист, а помогает сравнить сценарии «6 кабин × 5 часов» и «10 кабин × 4 часа».',
            ],
          },
          {
            id: 'assumptions',
            title: 'Какие допущения заложены',
            paragraphs: [
              'Загрузка на кабинку — среднее по залу, а не пик пятницы. Пустые утренние часы снижают среднее; вечерний пик его поднимает. Не закладывайте 100 % занятости без запаса на мойку, простои и отмены.',
              'Бар, депозиты и предоплата в формулу не входят. Онлайн-касса (ККТ) и реле ТВ — тоже: Heselo ведёт бронь, сеансы и смену в браузере и не заменяет фискальное оборудование.',
            ],
          },
          {
            id: 'next',
            title: 'Дальше: панель и тарифы Heselo',
            paragraphs: [
              'Когда ориентир по выручке ясен, имеет смысл проверить, как бронь переходит в активный сеанс и как бар попадает в тот же счёт — это страница решения для игрового клуба. Открытые цены подписки Heselo (фиксировано за клуб, не за консоль) — на странице тарифов; сравнение моделей «за устройство» и «за клуб» — в соседнем инструменте.',
              'Практическая настройка часа, пакетов и ночного тарифа разобрана в статье про тарифы PS-клуба. Калькулятор здесь отвечает только на вопрос «какой порядок выручки при такой загрузке?»; подписка Heselo в эту формулу не входит.',
              'После расчёта зафиксируйте допущения (часов на кабинку, цена часа, число дней) и сравните два сценария: текущий зал и планируемое расширение. На демо можно проверить те же цифры уже в расписании станций — без карты и без установки софта на консоли.',
            ],
          },
        ] satisfies ToolSection[],
        links: [
          { href: '/solutions/gaming', label: 'Программа для игрового клуба' },
          { href: '/pricing', label: 'Тарифы Heselo' },
          { href: '/tools/pricing-model', label: 'Модель цены: консоль vs клуб' },
        ],
      }
    : locale === 'en'
      ? {
          title: 'Club tariff calculator | Heselo',
          description: 'Estimate monthly revenue from booths, hourly rate and utilisation.',
          h1: 'Club tariff calculator',
          lead: 'Enter your numbers. Calculation stays in the browser.',
          booths: 'Booths / stations',
          hourly: 'Hourly rate',
          hours: 'Hours per booth per day',
          days: 'Working days per month',
          revenue: 'Estimated monthly revenue',
          cta: 'Request a Heselo demo',
          note: 'Venue revenue model — not Heselo subscription pricing. TV controllers and fiscal cash registers are out of scope.',
          sections: [] as ToolSection[],
          links: [] as Array<{ href: string; label: string }>,
        }
      : {
          title: 'Klub tarif kalkulyatoru | Heselo',
          description: 'Kabinka sayı, saat qiyməti və yüklənməyə görə aylıq gəlir təxmini.',
          h1: 'Klub tarif kalkulyatoru',
          lead: 'Öz rəqəmlərinizi daxil edin. Hesablama brauzerdə qalır.',
          booths: 'Kabinka / stansiya sayı',
          hourly: 'Saat qiyməti',
          hours: 'Kabinka başına gündəlik saat',
          days: 'Aylıq iş günü',
          revenue: 'Təxmini aylıq gəlir',
          cta: 'Heselo demo istəyin',
          note: 'Zalın gəlir modeli — Heselo abunə qiyməti deyil. TV kontroller və fiskal kassa hesabda yoxdur.',
          sections: [] as ToolSection[],
          links: [] as Array<{ href: string; label: string }>,
        }
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="guides"
  seo={{
    title: copy.title,
    description: copy.description,
    slug: '/tools/tariff-calculator',
    breadcrumbName: copy.h1,
    keywords: locale === 'ru' ? ['тарифы PS клуба', 'калькулятор выручки клуба'] : [],
  }}
>
  <section class="section">
    <div class="container tool">
      <p class="eyebrow">{locale === 'ru' ? 'Инструмент' : locale === 'en' ? 'Tool' : 'Alət'}</p>
      <h1 class="type-page-title">{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>

      <form class="tool__form" data-tariff-calc>
        <label>
          <span>{copy.booths}</span>
          <input name="booths" type="number" min="1" max="200" value="6" required />
        </label>
        <label>
          <span>{copy.hourly}</span>
          <input name="hourly" type="number" min="0" step="1" value="1500" required />
        </label>
        <label>
          <span>{copy.hours}</span>
          <input name="hours" type="number" min="0" max="24" step="0.5" value="6" required />
        </label>
        <label>
          <span>{copy.days}</span>
          <input name="days" type="number" min="1" max="31" value="26" required />
        </label>
        <p class="tool__result">
          <span>{copy.revenue}</span>
          <strong data-revenue>0</strong>
        </p>
      </form>

      <p class="tool__note">{copy.note}</p>
      <a class="btn btn-primary" href={localePath(locale, '/contact')} data-track-placement="tool">
        {copy.cta}
      </a>

      {
        copy.sections.length > 0 ? (
          <div class="tool__prose">
            {copy.sections.map((section) => (
              <section aria-labelledby={`tool-${section.id}`}>
                <h2 class="tool__h2" id={`tool-${section.id}`}>
                  {section.title}
                </h2>
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            ))}
            {copy.links.length > 0 ? (
              <ul class="tool__links">
                {copy.links.map((link) => (
                  <li>
                    <a class="link-inline" href={localePath(locale, link.href)}>
                      {link.label}
                      {messages.common.linkArrow}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        ) : null
      }
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('[data-tariff-calc]')
  const out = document.querySelector('[data-revenue]')
  if (form instanceof HTMLFormElement && out instanceof HTMLElement) {
    const calc = () => {
      const d = new FormData(form)
      const booths = Number(d.get('booths')) || 0
      const hourly = Number(d.get('hourly')) || 0
      const hours = Number(d.get('hours')) || 0
      const days = Number(d.get('days')) || 0
      const total = booths * hourly * hours * days
      out.textContent = new Intl.NumberFormat(undefined, {
        maximumFractionDigits: 0,
      }).format(total)
    }
    form.addEventListener('input', calc)
    calc()
  }
</script>

<style>
  .tool {
    max-width: 36rem;
  }
  .lead {
    margin: 0.75rem 0 1.5rem;
    color: var(--ink-muted);
  }
  .tool__form {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .tool__form label {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .tool__form input {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font: inherit;
    color: var(--ink);
    background: var(--bg-elevated);
  }
  .tool__result {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    font-size: var(--text-sm);
  }
  .tool__result strong {
    font-size: var(--text-xl);
    color: var(--accent-deep);
  }
  .tool__note {
    margin: 0 0 1.25rem;
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }
  .tool__prose {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  .tool__h2 {
    margin: 0 0 0.65rem;
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .tool__prose p {
    margin: 0 0 0.65rem;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  .tool__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
</style>
