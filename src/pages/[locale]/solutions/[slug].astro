---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Faq from '@/components/Faq.astro'
import { resolveLocale, LOCALES } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { getSolution, getSolutions, SOLUTION_SLUGS } from '@/data/solutions'
import { getGuideForSolution } from '@/data/guides'
import { SOLUTION_SHOT_MAP, SOLUTION_EXTRA_SHOT_MAP } from '@/lib/productShots'
import ProductShot from '@/components/ProductShot.astro'
import NextThought from '@/components/NextThought.astro'
import { localePath } from '@/lib/site'
import { pricingPath } from '@/lib/journey'
import { VENUE_STORAGE_KEY, isVenueOfferSlug, venuePriceRange } from '@/lib/venueOffers'
import { formatMoney } from '@/lib/format'

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    SOLUTION_SLUGS.map((slug) => ({
      params: { locale, slug },
    })),
  )
}

const locale = resolveLocale(Astro.params.locale)
const slug = String(Astro.params.slug || '')
const messages = getMessages(locale)
const solution = getSolution(locale, slug)

if (!solution) {
  return Astro.redirect(localePath(locale, '/solutions'))
}

const related = getSolutions(locale).filter((item) => solution.related.includes(item.slug))
const relatedGuide = getGuideForSolution(locale, solution.slug)
const productShotId = SOLUTION_SHOT_MAP[solution.slug]
const extraShotId = SOLUTION_EXTRA_SHOT_MAP[solution.slug]
const range = venuePriceRange(solution.slug)
const offerPrice = range
  ? {
      amount: `${formatMoney(range.low, locale)}–${formatMoney(range.high, locale)}`,
      period:
        range.model === 'monthly'
          ? messages.pricing.periodMonthly
          : messages.pricing.periodOneTime,
    }
  : null
const persistVenueType = isVenueOfferSlug(solution.slug) ? solution.slug : ''

const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: solution.faq,
  },
}
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="solution"
  seo={{
    title: solution.seoTitle,
    description: solution.seoDescription,
    keywords: solution.keywords,
    slug: `/solutions/${solution.slug}`,
    breadcrumbName: solution.shortTitle,
    faq: solution.faq,
    ogType: 'article',
  }}
>
  <article class="section">
    <div class="container narrow">
      <header class="section-head">
        <p class="eyebrow">{messages.nav.solutions}</p>
        <h1 class="type-page-title">{solution.h1}</h1>
        {
          offerPrice ? (
            <p class="price-chip">
              <a href={localePath(locale, `/pricing#${solution.slug}`)} data-pricing-type={solution.slug}>
                {offerPrice.amount}
                <span>{offerPrice.period}</span>
              </a>
            </p>
          ) : null
        }
        <p class="lead">{solution.intro}</p>
      </header>

      {
        productShotId ? (
          <div class="shot-wrap">
            <ProductShot locale={locale} messages={messages} id={productShotId} />
          </div>
        ) : null
      }

      <section aria-labelledby="who-title">
        <h2 id="who-title" class="type-section">{solution.whoTitle}</h2>
        <p class="body">{solution.whoBody}</p>
      </section>

      <section aria-labelledby="problems-title">
        <h2 id="problems-title" class="type-section">{solution.problemsTitle}</h2>
        <ul class="bullets">
          {solution.problems.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section aria-labelledby="how-title">
        <h2 id="how-title" class="type-section">{solution.howTitle}</h2>
        <p class="body">{solution.howBody}</p>
      </section>

      <section aria-labelledby="features-title">
        <h2 id="features-title" class="type-section">{solution.featuresTitle}</h2>
        <div class="features">
          {
            solution.features.map((f) => (
              <section>
                <h3 class="type-card-title">{f.title}</h3>
                <p>{f.desc}</p>
              </section>
            ))
          }
        </div>
      </section>

      {
        extraShotId && extraShotId !== productShotId ? (
          <div class="shot-wrap">
            <ProductShot locale={locale} messages={messages} id={extraShotId} />
          </div>
        ) : null
      }

      <section aria-labelledby="differ-title">
        <h2 id="differ-title" class="type-section">{solution.differTitle}</h2>
        <p class="body">{solution.differBody}</p>
      </section>
    </div>
  </article>

  <NextThought
    label={messages.journey.navLabel}
    arrow={messages.common.linkArrow}
    doors={
      persistVenueType
        ? [
            {
              prompt: messages.journey.priceForType.prompt,
              label: messages.journey.priceForType.label,
              href: pricingPath(locale, persistVenueType),
              bind: 'pricing',
            },
            ...(relatedGuide
              ? [
                  {
                    prompt: messages.journey.stillLearning.prompt,
                    label: messages.journey.stillLearning.label,
                    href: localePath(locale, `/guides/${relatedGuide.slug}`),
                  },
                ]
              : []),
          ]
        : [
            {
              prompt: messages.journey.whichVenue.prompt,
              label: messages.journey.whichVenue.label,
              href: localePath(locale, '/solutions'),
            },
          ]
    }
  />

  <Faq locale={locale} messages={faqMessages} />

  {
    related.length > 0 ? (
      <section class="section related">
        <div class="container narrow">
          <h2 class="type-section">{messages.nav.solutions}</h2>
          <ul>
            {related.map((item) => (
              <li>
                <a href={localePath(locale, `/solutions/${item.slug}`)}>{item.h1}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  <section class="section">
    <div class="container">
      <div class="banner">
        <div>
          <h2 class="type-section">{solution.ctaTitle}</h2>
          <p class="type-lead">{solution.ctaBody}</p>
        </div>
        <a
          class="btn btn-primary"
          href={
            persistVenueType
              ? `${localePath(locale, '/contact')}?type=${persistVenueType}`
              : localePath(locale, '/contact')
          }
        >
          {messages.cta.button}
        </a>
      </div>
    </div>
  </section>
  {
    persistVenueType ? (
      <script is:inline define:vars={{ persistVenueType, storageKey: VENUE_STORAGE_KEY }}>
        try {
          sessionStorage.setItem(storageKey, persistVenueType)
        } catch {
          /* ignore */
        }
      </script>
    ) : null
  }
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }
  .price-chip {
    margin: 0.85rem 0 0;
  }
  .price-chip a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 118, 110, 0.28);
    background: rgba(20, 184, 166, 0.1);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    text-decoration: none;
  }
  .price-chip span {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-subtle);
  }
  .shot-wrap {
    margin: 0 0 2rem;
  }
  section + section {
    margin-top: 2.25rem;
  }
  .body {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }
  .bullets {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-muted);
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .features {
    margin-top: 1rem;
    display: grid;
    gap: 0.85rem;
  }
  .features section {
    margin: 0;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .features p {
    margin: 0.4rem 0 0;
    color: var(--ink-muted);
  }
  .related ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .related a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .banner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: calc(var(--radius-lg) + 4px);
    border: 1px solid rgba(15, 118, 110, 0.22);
    background:
      radial-gradient(600px 200px at 10% 0%, rgba(20, 184, 166, 0.18), transparent 55%),
      linear-gradient(135deg, #ffffff, #e8f7f4);
    box-shadow: var(--shadow);
  }
  .banner p {
    margin: 0.65rem 0 0;
    color: var(--ink-muted);
    max-width: 36rem;
  }
  @media (min-width: 800px) {
    .features {
      grid-template-columns: 1fr 1fr;
    }
    .banner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
