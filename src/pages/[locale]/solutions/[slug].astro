---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Faq from '@/components/Faq.astro'
import { resolveLocale, LOCALES } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { getSolution, getSolutions, SOLUTION_SLUGS } from '@/data/solutions'
import { getAltGuidesForSolution, getGuideForSolution } from '@/data/guides'
import { SOLUTION_SHOT_MAP, SOLUTION_EXTRA_SHOT_MAP } from '@/lib/productShots'
import ProductShot from '@/components/ProductShot.astro'
import CtaBanner from '@/components/CtaBanner.astro'
import NextThought from '@/components/NextThought.astro'
import { localePath } from '@/lib/site'
import { contactPath, pricingPath } from '@/lib/journey'
import { VENUE_STORAGE_KEY, getVenueOffer, isVenueOfferSlug } from '@/lib/venueOffers'
import { fillTemplate, formatMoney } from '@/lib/format'

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    SOLUTION_SLUGS.map((slug) => ({
      params: { locale, slug },
    })),
  )
}

const locale = resolveLocale(Astro.params.locale)
const slug = String(Astro.params.slug || '')
const messages = getMessages(locale)
const solution = getSolution(locale, slug)

if (!solution) {
  return Astro.redirect(localePath(locale, '/solutions'))
}

const related = getSolutions(locale).filter((item) => solution.related.includes(item.slug))
const relatedGuide = getGuideForSolution(locale, solution.slug)
const altGuides = getAltGuidesForSolution(locale, solution.slug)
const productShotId = SOLUTION_SHOT_MAP[solution.slug]
const extraShotId = SOLUTION_EXTRA_SHOT_MAP[solution.slug]
const venueOffer = getVenueOffer(solution.slug)
const fromFee = venueOffer?.plans[0].monthlyFee
const offerPrice = fromFee != null
  ? {
      label: fillTemplate(messages.pricing.fromMonthly, {
        price: formatMoney(fromFee, locale),
      }),
    }
  : null
const persistVenueType = isVenueOfferSlug(solution.slug) ? solution.slug : ''

const faqMessages = {
  ...messages,
  faq: {
    eyebrow: messages.faq.eyebrow,
    title: messages.faq.title,
    items: solution.faq,
  },
}
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="solution"
  seo={{
    title: solution.seoTitle,
    description: solution.seoDescription,
    keywords: solution.keywords,
    slug: `/solutions/${solution.slug}`,
    breadcrumbName: solution.shortTitle,
    faq: solution.faq,
    ogType: 'article',
  }}
>
  <article class="section">
    <div class="container">
      <div class="narrow">
        <header class="section-head">
          <p class="eyebrow">{messages.nav.solutions}</p>
          <h1 class="type-page-title">{solution.h1}</h1>
          {
            offerPrice ? (
              <p class="price-chip">
                <a href={localePath(locale, `/pricing#${solution.slug}`)} data-pricing-type={solution.slug}>
                  {offerPrice.label}
                </a>
              </p>
            ) : null
          }
          <p class="lead">{solution.intro}</p>
        </header>
      </div>

      {
        productShotId ? (
          <div class="shot-wrap">
            <ProductShot messages={messages} id={productShotId} />
          </div>
        ) : null
      }

      <div class="narrow">
        <section aria-labelledby="who-title">
          <h2 id="who-title" class="sub">{solution.whoTitle}</h2>
          <p class="body">{solution.whoBody}</p>
        </section>

        <section aria-labelledby="problems-title">
          <h2 id="problems-title" class="sub">{solution.problemsTitle}</h2>
          <ul class="bullets">
            {solution.problems.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="how-title">
          <h2 id="how-title" class="sub">{solution.howTitle}</h2>
          <p class="body">{solution.howBody}</p>
        </section>
      </div>

      <section class="features-block" aria-labelledby="features-title">
        <div class="narrow">
          <h2 id="features-title" class="sub">{solution.featuresTitle}</h2>
        </div>
        <div class="features card-grid">
          {
            solution.features.map((f) => (
              <section class="card">
                <h3 class="type-card-title">{f.title}</h3>
                <p>{f.desc}</p>
              </section>
            ))
          }
        </div>
      </section>

      {
        extraShotId && extraShotId !== productShotId ? (
          <div class="shot-wrap">
            <ProductShot messages={messages} id={extraShotId} />
          </div>
        ) : null
      }

      <div class="narrow">
        <section aria-labelledby="differ-title">
          <h2 id="differ-title" class="sub">{solution.differTitle}</h2>
          <p class="body">{solution.differBody}</p>
        </section>

        {
          altGuides.length > 0 ? (
            <section class="alt-block" aria-labelledby="alt-title">
              <h2 id="alt-title" class="sub">
                {messages.guidesPage.altSeekingTitle}
              </h2>
              <p class="body">{messages.guidesPage.altSeekingBody}</p>
              <ul class="alt-links">
                {altGuides.map((item) => (
                  <li>
                    <a class="link-inline" href={localePath(locale, `/guides/${item.slug}`)}>
                      {item.shortTitle}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        {
          related.length > 0 ? (
            <nav class="related" aria-label={messages.nav.solutions}>
              <h2 class="sub">{messages.nav.solutions}</h2>
              <ul>
                {related.map((item) => (
                  <li>
                    <a class="link-inline" href={localePath(locale, `/solutions/${item.slug}`)}>
                      {item.h1}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ) : null
        }
      </div>
    </div>
  </article>

  <NextThought
    label={messages.journey.navLabel}
    doors={
      persistVenueType
        ? [
            {
              prompt: messages.journey.priceForType.prompt,
              label: messages.journey.priceForType.label,
              href: pricingPath(locale, persistVenueType),
              bind: 'pricing',
            },
            ...(relatedGuide
              ? [
                  {
                    prompt: messages.journey.stillLearning.prompt,
                    label: messages.journey.stillLearning.label,
                    href: localePath(locale, `/guides/${relatedGuide.slug}`),
                  },
                ]
              : []),
          ]
        : [
            {
              prompt: messages.journey.whichVenue.prompt,
              label: messages.journey.whichVenue.label,
              href: localePath(locale, '/solutions'),
            },
          ]
    }
  />

  <Faq locale={locale} messages={faqMessages} />

  <section class="section section-tight">
    <div class="container">
      <CtaBanner
        title={solution.ctaTitle}
        body={solution.ctaBody}
        href={contactPath(locale, persistVenueType || undefined)}
        label={messages.cta.button}
      />
    </div>
  </section>
  {
    persistVenueType ? (
      <script is:inline define:vars={{ persistVenueType, storageKey: VENUE_STORAGE_KEY }}>
        try {
          sessionStorage.setItem(storageKey, persistVenueType)
        } catch {
          /* ignore */
        }
      </script>
    ) : null
  }
</BaseLayout>

<style>
  .price-chip {
    margin: 0.85rem 0 0;
  }
  .price-chip a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
  }
  .price-chip a:hover {
    color: var(--accent-deep);
  }
  .price-chip span {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-subtle);
  }
  /* Cap below container width so shots stay sharp (assets are ~1256px @1x). */
  .shot-wrap {
    width: 100%;
    max-width: 48rem;
    margin: 1.5rem auto 2.25rem;
  }
  .features-block {
    margin-top: 2.25rem;
  }
  .features-block .sub {
    margin-bottom: 0.15rem;
  }
  /* Sub-headings stay below the H1 so the page reads as one article. */
  .sub {
    font-size: var(--text-2xl);
  }
  .narrow > section + section {
    margin-top: 2.25rem;
  }
  .body {
    margin: 0.6rem 0 0;
    color: var(--ink-muted);
  }
  .bullets {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-muted);
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .features {
    margin-top: 0.9rem;
  }
  .features .type-card-title {
    overflow-wrap: break-word;
  }
  .features section {
    margin: 0;
    min-width: 0;
  }
  .features p {
    margin: 0.3rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .alt-block {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .alt-links {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .related ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .related ul,
    .alt-links {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
    }
  }
</style>
