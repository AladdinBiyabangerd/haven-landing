---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import {
  FEATURE_SOLUTION_SLUGS,
  PRIMARY_SOLUTION_SLUGS,
  getSolutionsBySlugs,
  getSolutionsHub,
} from '@/data/solutions'
import LinkCard from '@/components/LinkCard.astro'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const hub = getSolutionsHub(locale)
const primary = getSolutionsBySlugs(locale, PRIMARY_SOLUTION_SLUGS)
const features = getSolutionsBySlugs(locale, FEATURE_SOLUTION_SLUGS)
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="solutions"
  seo={{
    title: hub.seoTitle,
    description: hub.seoDescription,
    keywords: hub.keywords,
    slug: '/solutions',
    breadcrumbName: messages.nav.solutions,
  }}
>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1 class="type-page-title">{hub.h1}</h1>
        <p class="lead">{hub.intro}</p>
      </header>
      <h2 class="group-title">{hub.primaryTitle}</h2>
      <ul class="card-grid">
        {
          primary.map((item) => (
            <li>
              <LinkCard
                href={localePath(locale, `/solutions/${item.slug}`)}
                title={item.h1}
                desc={truncateText(item.intro, 140, messages.common.truncatedEllipsis)}
              />
            </li>
          ))
        }
      </ul>
      <h2 class="group-title">{hub.featuresTitle}</h2>
      <ul class="card-grid">
        {
          features.map((item) => (
            <li>
              <LinkCard
                href={localePath(locale, `/solutions/${item.slug}`)}
                title={item.h1}
                desc={truncateText(item.intro, 140, messages.common.truncatedEllipsis)}
              />
            </li>
          ))
        }
      </ul>
      <p class="guides-link">
        <a class="link-inline" href={localePath(locale, '/guides')}>
          {messages.nav.guides}{messages.common.linkArrow}
        </a>
      </p>
    </div>
  </section>
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  .group-title {
    margin: 2rem 0 1rem;
    font-size: var(--text-xl);
  }
  .guides-link {
    margin: 1.25rem 0 0;
  }
</style>
