---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { getMessages } from '@/i18n'
import { getSolutions, getSolutionsHub } from '@/data/solutions'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = getMessages(locale)
const hub = getSolutionsHub(locale)
const items = getSolutions(locale)
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="solutions"
  seo={{
    title: hub.seoTitle,
    description: hub.seoDescription,
    keywords: hub.keywords,
    slug: '/solutions',
    breadcrumbName: messages.nav.solutions,
  }}
>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1 class="type-page-title">{hub.h1}</h1>
        <p class="lead">{hub.intro}</p>
      </header>
      <ul class="cards">
        {
          items.map((item) => (
            <li>
              <article>
                <h2 class="type-card-title">{item.shortTitle}</h2>
                <p>{item.intro.slice(0, 160)}…</p>
                <a href={localePath(locale, `/solutions/${item.slug}`)}>
                  {item.h1} — {hub.cardCta}
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="guides-link">
        <a href={localePath(locale, '/guides')}>{messages.nav.guides} →</a>
      </p>
    </div>
  </section>
  <Cta locale={locale} messages={messages} />
</BaseLayout>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  article {
    padding: 1.35rem 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    display: grid;
    gap: 0.65rem;
    height: 100%;
  }
  p {
    margin: 0;
    color: var(--ink-muted);
  }
  a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .guides-link {
    margin: 1.5rem 0 0;
  }
  @media (min-width: 800px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
