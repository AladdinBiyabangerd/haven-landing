---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import {
  FEATURE_SOLUTION_SLUGS,
  PRIMARY_SOLUTION_SLUGS,
  getSolutionsBySlugs,
  getSolutionsHub,
} from '@/data/solutions'
import LinkCard from '@/components/LinkCard.astro'
import { applyCatalogPricesDeep } from '@/lib/catalogCopy'
import { localePath } from '@/lib/site'
import { truncateText } from '@/lib/format'
import { loadVenueOffers } from '@/lib/venueOffers'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)
await loadVenueOffers()
const hub = applyCatalogPricesDeep(getSolutionsHub(locale), locale)
const primary = applyCatalogPricesDeep(getSolutionsBySlugs(locale, PRIMARY_SOLUTION_SLUGS), locale)
const features = applyCatalogPricesDeep(getSolutionsBySlugs(locale, FEATURE_SOLUTION_SLUGS), locale)
const cardCta = `${hub.cardCta}${messages.common.linkArrow}`
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="solutions"
  seo={{
    title: hub.seoTitle,
    description: hub.seoDescription,
    keywords: hub.keywords,
    slug: '/solutions',
    breadcrumbName: messages.nav.solutions,
  }}
>
  <section class="section solutions-hub">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1 class="type-page-title">{hub.h1}</h1>
        <p class="lead">{hub.intro}</p>
      </header>
      {
        hub.body && hub.body.length > 0 ? (
          <div class="hub-prose">
            {hub.body.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        ) : null
      }
      {
        hub.howTitle && hub.howBody ? (
          <section class="hub-how" aria-labelledby="hub-how-title">
            <h2 id="hub-how-title" class="group-title">
              {hub.howTitle}
            </h2>
            <p class="hub-how-body">{hub.howBody}</p>
          </section>
        ) : null
      }
      <h2 class="group-title">{hub.primaryTitle}</h2>
      <ul class="card-grid">
        {
          primary.map((item) => (
            <li>
              <LinkCard
                href={localePath(locale, `/solutions/${item.slug}`)}
                title={item.shortTitle}
                desc={truncateText(item.intro, 90, messages.common.truncatedEllipsis)}
                cta={cardCta}
                as="h3"
              />
            </li>
          ))
        }
      </ul>
      <h2 class="group-title">{hub.featuresTitle}</h2>
      <ul class="card-grid">
        {
          features.map((item) => (
            <li>
              <LinkCard
                href={localePath(locale, `/solutions/${item.slug}`)}
                title={item.shortTitle}
                desc={truncateText(item.intro, 90, messages.common.truncatedEllipsis)}
                cta={cardCta}
                as="h3"
              />
            </li>
          ))
        }
      </ul>
      <p class="guides-link">
        <a class="link-inline" href={localePath(locale, '/guides')}>
          {messages.nav.guides}{messages.common.linkArrow}
        </a>
      </p>
    </div>
  </section>
  <Cta locale={locale} messages={messages} intent="next" />
</BaseLayout>

<style>
  .hub-prose {
    max-width: 42rem;
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.85rem;
  }
  .hub-prose p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  .hub-how {
    max-width: 42rem;
    margin: 0 0 0.5rem;
  }
  .hub-how-body {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  .group-title {
    margin: 1.75rem 0 0.85rem;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink-subtle);
  }
  .guides-link {
    margin: 1.25rem 0 0;
  }
  @media (max-width: 759px) {
    .solutions-hub .section-head :global(.type-page-title) {
      font-size: var(--text-2xl);
    }
    .solutions-hub .section-head .lead {
      font-size: var(--text-md);
    }
    .group-title {
      margin: 1.35rem 0 0.65rem;
      font-size: var(--text-md);
    }
  }
</style>
