---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Faq from '@/components/Faq.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import { getFaqGroups } from '@/lib/faqPage'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)
const page = messages.faqPage
const groups = getFaqGroups(messages)
// FAQPage JSON-LD is emitted once by BaseLayout (seoFromMessages → getAllFaqItems).
---

<BaseLayout locale={locale} messages={messages} page="faq">
  <section class="section section--head">
    <div class="container">
      <div class="narrow">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="type-page-title">{page.title}</h1>
        <p class="lead">{page.intro}</p>
      </div>
    </div>
  </section>

  {
    groups.map((group) => (
      <Faq
        id={`faq-${group.id}`}
        locale={locale}
        messages={{
          ...messages,
          faq: {
            eyebrow: '',
            title: group.title,
            moreLabel: messages.faq.moreLabel,
            items: group.items,
          },
        }}
      />
    ))
  }

  <Cta locale={locale} messages={messages} intent="demo" />
</BaseLayout>

<style>
  .section--head {
    padding-bottom: 0;
  }
  .narrow {
    max-width: 40rem;
  }
  .lead {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: 1.55;
  }
</style>
