---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import How from '@/components/How.astro'
import ProductProof from '@/components/ProductProof.astro'
import HomePricingTeaser from '@/components/HomePricingTeaser.astro'
import TrustEeat from '@/components/TrustEeat.astro'
import Faq from '@/components/Faq.astro'
import Audiences from '@/components/Audiences.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'
import { localePath } from '@/lib/site'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)

/** Conversion-critical home FAQ: what / POS fit / price / demo (full list on /faq). */
const demoFaqIndex = messages.faq.items.findIndex((item) => item.href === '/contact')
const homeFaqPick = [0, 2, 3, demoFaqIndex >= 0 ? demoFaqIndex : messages.faq.items.length - 1]
const homeFaqItems = homeFaqPick
  .map((i) => messages.faq.items[i])
  .filter((item): item is (typeof messages.faq.items)[number] => Boolean(item))
const homeSeo = {
  title: messages.seo.pages.home.title,
  description: messages.seo.pages.home.description,
  keywords: messages.seo.pages.home.keywords,
  slug: '/',
  breadcrumbName: messages.nav.home,
  /** Only questions visible on this page — matches FAQPage rich results rules */
  faq: homeFaqItems,
}
---

<BaseLayout locale={locale} messages={messages} page="home" seo={homeSeo}>
  <div class="home">
    <Hero locale={locale} messages={messages} />
    <How messages={messages} />
    <ProductProof locale={locale} messages={messages} />
    <Audiences locale={locale} messages={messages} />
    <HomePricingTeaser locale={locale} messages={messages} />
    <TrustEeat locale={locale} messages={messages} />
    <Faq
      locale={locale}
      messages={messages}
      pick={homeFaqPick}
      moreHref={localePath(locale, '/faq')}
      class="reveal-on-scroll"
    />
    <Cta locale={locale} messages={messages} intent="demo" />
  </div>
</BaseLayout>

<style is:global>
  /* Home-only: less empty band between blocks (scroll ≠ prestige). */
  .home .section {
    padding: 1.6rem 0;
  }
  .home .section-head {
    margin-bottom: 0.9rem;
  }
  .home #solutions .all {
    margin-top: 0.85rem;
  }
  .home [data-cta] {
    padding-top: 0.65rem;
    padding-bottom: 1.5rem;
  }
  @media (max-width: 759px) {
    .home .section {
      padding: 1.35rem 0;
    }
    .home .section-head .type-section {
      font-size: var(--text-2xl);
    }
    .home .section-head .lead {
      margin-top: 0.35rem;
      font-size: var(--text-md);
    }
  }
</style>
