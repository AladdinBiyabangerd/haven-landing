---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import ProductProof from '@/components/ProductProof.astro'
import HomePricingTeaser from '@/components/HomePricingTeaser.astro'
import Audiences from '@/components/Audiences.astro'
import Cta from '@/components/Cta.astro'
import { resolveLocale } from '@/i18n/config'
import { loadPricedMessages } from '@/i18n'

export function getStaticPaths() {
  return [{ params: { locale: 'az' } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }]
}

const locale = resolveLocale(Astro.params.locale)
const messages = await loadPricedMessages(locale)
---

<BaseLayout
  locale={locale}
  messages={messages}
  page="home"
  preloadImages={[
    {
      href: '/images/product/live-floor.webp',
      type: 'image/webp',
      imagesrcset: '/images/product/live-floor.webp 1x, /images/product/live-floor@2x.webp 2x',
    },
  ]}
>
  <div class="home">
    <Hero locale={locale} messages={messages} />
    <ProductProof locale={locale} messages={messages} />
    <Audiences locale={locale} messages={messages} />
    <HomePricingTeaser locale={locale} messages={messages} />
    <Cta locale={locale} messages={messages} intent="next" />
  </div>
</BaseLayout>

<style is:global>
  /* Home-only: less empty band between blocks (scroll ≠ prestige). */
  .home .section {
    padding: 1.6rem 0;
  }
  .home .section-head {
    margin-bottom: 0.9rem;
  }
  .home #solutions .all {
    margin-top: 0.85rem;
  }
  .home .cta-next {
    padding-top: 0.65rem;
    padding-bottom: 1.5rem;
  }
  .home .cta-next .prose p {
    margin-top: 0.3rem;
  }
  @media (max-width: 759px) {
    .home .section {
      padding: 1.35rem 0;
    }
    .home .section-head .type-section {
      font-size: var(--text-2xl);
    }
    .home .section-head .lead {
      margin-top: 0.35rem;
      font-size: var(--text-md);
    }
  }
</style>
