# Public site origin used for canonical URLs, sitemap, Open Graph, and JSON-LD.
# Production MUST be the live HTTPS origin (never localhost).
PUBLIC_SITE_URL=https://heselo.online

# Contact form API path (trailing slash matches Astro directory routing)
PUBLIC_CONTACT_ENDPOINT=/api/contact/

# Analytics (optional): plausible | ga4 | leave empty
# PUBLIC_ANALYTICS=plausible
# PUBLIC_PLAUSIBLE_DOMAIN=heselo.online
# PUBLIC_ANALYTICS=ga4
# PUBLIC_GA4_ID=G-XXXXXXXXXX

# Organization sameAs — full https URLs (optional, for JSON-LD)
# PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/heselo
# PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/heselo
# PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/heselo
# PUBLIC_SOCIAL_X=https://x.com/heselo

# IndexNow (Bing) — 8–128 hex chars; prebuild writes public/{key}.txt
# INDEXNOW_KEY=your-indexnow-key-here

# Gmail SMTP — use an App Password for the sending mailbox
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=heselo.online@gmail.com
SMTP_PASS=replace-with-gmail-app-password

# Owner notification inbox / From address on auto-replies
CONTACT_NOTIFY_EMAIL=you@example.com
CONTACT_FROM_EMAIL=heselo.online@gmail.com
