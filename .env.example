# Prefixed keys (preferred). Legacy unprefixed names still work.
# Vercel / Railway → Heselo project Environment Variables.

PUBLIC_HESELO_SITE_URL=https://heselo.online
PUBLIC_HESELO_CONTACT_ENDPOINT=/api/contact/

HESELO_SMTP_HOST=smtp.gmail.com
HESELO_SMTP_PORT=465
HESELO_SMTP_SECURE=true
HESELO_SMTP_USER=heselo.online@gmail.com
HESELO_SMTP_PASS=replace-with-gmail-app-password
HESELO_CONTACT_NOTIFY_EMAIL=you@example.com
HESELO_CONTACT_FROM_EMAIL=heselo.online@gmail.com

# Analytics — default in code is GA4 G-HKT0YR5W38. Override if needed:
# PUBLIC_HESELO_ANALYTICS=ga4
# PUBLIC_HESELO_GA4_ID=G-HKT0YR5W38
# PUBLIC_HESELO_ANALYTICS=plausible
# PUBLIC_HESELO_PLAUSIBLE_DOMAIN=heselo.online
# PUBLIC_HESELO_SOCIAL_INSTAGRAM=https://instagram.com/heselo
# PUBLIC_HESELO_SOCIAL_FACEBOOK=https://facebook.com/heselo
# PUBLIC_HESELO_SOCIAL_LINKEDIN=https://linkedin.com/company/heselo
# PUBLIC_HESELO_SOCIAL_X=https://x.com/heselo
# Founder Person.sameAs (LinkedIn profile) — strengthens “who created Heselo?” for AI/search:
# PUBLIC_FOUNDER_LINKEDIN=https://www.linkedin.com/in/your-slug
# HESELO_INDEXNOW_KEY=your-indexnow-key-here
